    q = spec.add_parser(
        "status", help="exit 0 aligned, 4 diverged, 2 undetermined (#107)")
    add_spec_args(q)
    q.set_defaults(func=cmd_spec_status)

    q = sub.add_parser("dump")
    q.add_argument("--write", action="store_true",
                   help="also write .omni/control-state.json projection")
    add_spec_args(q)
    q.set_defaults(func=cmd_dump)
    q = sub.add_parser(
        "project-snapshot",
        help="read task/run/slot facts without schema or expiry writes",
    )
    q.set_defaults(func=cmd_project_snapshot)
    q = sub.add_parser("selftest")
    q.set_defaults(func=cmd_selftest)

    args = p.parse_args(argv)

    # --- clock (ADR-0005 D4) -------------------------------------------------
    # ARGV ONLY, and there is no environment fallback ON PURPOSE. An earlier
    # revision of this change also read $NIGHTSHIFT_NOW; security blocked it as
    # "issue #31 wearing a different hat", and it was right. The clock decides
    # TTL expiry, and `expire_stale` runs inside `slot list`, `lease list`,
    # `claim show` and `dump` -- so an inherited env var turned READ-shaped
    # commands into destructive ones: one `slot list` with a forward clock
    # reaped a healthy plane irreversibly, and there is no un-reap verb.
    # Backward was worse: a clock pinned to the heartbeat's own ts reported a
    # six-hour-dead Program as {"alive": true, "age": 0.0}, exit 0 -- a
    # fail-OPEN on the dead-man's switch, reachable by inheritance alone.
    # Argv is the correct channel because it is per-invocation, does NOT pass
    # to children, is visible in `ps`, and is legible in any script or ledger
    # entry that carries it. Do not add an env fallback back.
    injected = args.now
    if injected is not None:
        set_clock_override(injected)
        # Announced on STDERR, never in the JSON: `beat show`'s unreadable
        # verdict is pinned by security to exactly two keys, and this must not
        # add a third. The contract is about stdout.
        print(f"nightshift-ctl: CLOCK OVERRIDE active, now={injected!r} "
              f"(TTL expiry is computed against this, not wall time)",
              file=sys.stderr)

    # --- control plane (ADR-0005 D1/D2) --------------------------------------
    args.db, args.db_source = resolve_db_path(args.db)

    # `pr-lint` and `pr-create` lint the bytes of a PR body and never touch
    # `cx`. Making them demand an existing control plane would be a burden
    # invented by this change, and a breaking one: an engineer opens a PR from
    # a git WORKTREE, where discovery stops at the `.git` boundary. A linter
    # must run anywhere. They are handed no connection at all, so "does this
    # command use the plane?" stays answerable by reading its signature.
    if is_plane_free(args):
        args.func(None, args)
        return

    # --- ADR-0082 authority-epoch client gate --------------------------------
    # Every verb where `is_plane_free(args)` is False is a verb that opens the
    # LEGACY control plane. This CLI is therefore the archetypal "legacy
    # process that does not understand epochs" ADR-0082 phase 5 says must be
    # stopped at cutover -- and this is where it is stopped, structurally,
    # rather than by an operator remembering to kill it.
    #
    # Absent registry == legacy binding at epoch 0, so on a machine that has
    # never bootstrapped a migration this call is a no-op and every existing
    # verb behaves byte-for-byte as before.
    authority_client_gate(args)

    # Opening and migrating the control plane are the two places "the plane
    # is unreadable" can be discovered. Both are narrow on purpose: once the
    # schema is ensured the plane IS readable, so wrapping args.func here
    # would convert unrelated command-level sqlite errors into a liveness
    # verdict and mask real bugs.
    try:
        readonly_snapshot = (args.group == "project-snapshot"
                             or is_review_readonly(args)
                             or is_bookkeeping_plan(args))
        if readonly_snapshot:
            cx = connect(args.db, readonly=True)
        else:
            # Preserve the established call shape: tests and integrations
            # patch this exact seam for every normal control-plane command.
            cx = connect(args.db, create=(args.group == "init"))
    except ControlPlaneMissing as exc:
        # `beat show` returns (fail-closed verdict, exit 3) and never comes
        # back; every other subcommand gets a loud, machine-readable refusal
        # instead of the phantom plane it used to get silently.
        if is_review_plan(args):
            out({"ok": False, "error": "review_plan_denied",
                 "reason": "control_plane_missing"}, 3)
        if is_review_eligibility(args):
            out({"ok": False, "error": "review_eligibility_denied",
                 "reason": "control_plane_missing"}, 3)
        if is_review_escaped_defects(args):
            # Both plane queries already degrade to empty sets; refusing here
            # denied the retro its number for a reason that does not affect
            # the number, three lines above the branch added so `review log`
            # need not suffer the same.
            cmd_review_escaped_defects(None, args)
        if is_review_log(args):
            # The verb whose whole thesis is "the finding outranks the
            # accounting" was exiting here, before it ran, writing nothing --
            # for exactly the population ADR-0090 exists to serve: a seat
            # whose sandbox cannot resolve the plane. Write the entry with no
            # plane at all and name what could not be minted.
            cmd_review_log(None, args)
        if is_bookkeeping_plan(args):
            out({"ok": False, "error": "bookkeeping_plan_denied",
                 "reason": "control_plane_missing",
                 "classification": "normal"}, 3)
        beat_show_verdict_on_unreadable(args, exc)
        out({"ok": False, "error": "control_plane_missing", "db": args.db,
             "db_source": args.db_source, "cwd": os.getcwd(),
             "hint": "run from inside the project (or a worktree of it), or "
                     "pass --db. `nightshift-ctl init` CREATES a new empty "
                     "control plane and is almost never what you want here"}, 1)
    except (sqlite3.Error, OSError) as exc:
        if is_review_plan(args):
            out({"ok": False, "error": "review_plan_denied",
                 "reason": "control_db_unreadable"}, 3)
        if is_review_eligibility(args):
            out({"ok": False, "error": "review_eligibility_denied",
                 "reason": "control_db_unreadable"}, 3)
        if is_review_escaped_defects(args):
            out({"ok": False, "error": "review_escaped_defects_denied",
                 "reason": "control_db_unreadable"}, 3)
        if is_review_log(args):
            cmd_review_log(None, args)
        if is_bookkeeping_plan(args):
            out({"ok": False, "error": "bookkeeping_plan_denied",
                 "reason": "control_db_unreadable",
                 "classification": "normal"}, 3)
        beat_show_verdict_on_unreadable(args, exc)
        if isinstance(exc, ControlPlaneUntrusted):
            out({"ok": False, "error": "control_plane_untrusted",
                 "db": exc.path, "db_source": args.db_source,
                 "reason": exc.reason,
                 "hint": "point --db or NIGHTSHIFT_CTL_DB at a control plane "
                         "this user created (0600, untracked, not a link)"}, 1)
        raise
    try:
        try:
            if not readonly_snapshot:
                ensure_schema(cx)
        except (sqlite3.Error, OSError) as exc:
            beat_show_verdict_on_unreadable(args, exc)
            raise
        args.func(cx, args)
    finally:
        cx.close()


if __name__ == "__main__":
    main()
