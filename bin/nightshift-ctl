# ---------------------------------------------- reap --delete (ADR-0061) --
#
# #433. The audit above is READ-ONLY by design (`_git_ro`'s own docstring:
# "do not add a verb here that writes") -- it finds debris, it never touches
# it. ADR-0061 authorizes exactly one new, narrow write path, gated behind
# `--delete`, evaluated fresh every call against the tightened AC-1 (worktrees)
# / AC-5 (branches) condition sets. `_git_ro` itself is NOT extended; every
# write verb here goes through `_git_rw` instead, so the read-only audit's
# safety argument stays intact and auditable in one place.


def _git_rw(repo, *argv, timeout=None):
    """Run a git command that WRITES -- the ADR-0061 (#433) delete path.

    Every call site is exactly one of three verbs: `worktree remove`
    (a clean, already-proven-safe worktree), `fetch` (refreshes remote-
    tracking refs only -- touches no working tree, no index, no local HEAD,
    so it does not endanger another agent's live checkout the way #89/#98/
    #120 did), and `push --delete` (removes a remote branch ref that AC-5's
    three conditions have already cleared). None of the three is called
    unconditionally -- see `reap_delete_worktrees` / `reap_delete_branches`.
    Returns (rc, stdout, stderr), never raises.
    """
    try:
        p = subprocess.run(_git_argv(repo, argv), env=_git_env(),
                           capture_output=True, text=True, timeout=timeout)
    except OSError as exc:
        return 127, "", str(exc)
    except subprocess.TimeoutExpired as exc:
        return 124, "", str(exc)
    return p.returncode, p.stdout.strip(), p.stderr.strip()


def _worktree_delete_eligible(cx, entry):
    """ADR-0061 / accepted AC-1: is this `audit_worktrees` entry safe to
    `--delete`? Returns (eligible, reason); `reason` is set only when NOT
    eligible, and names the specific failing condition (AC-2), evaluated in
    the ADR's own (a)-(e) order so the first failure is the one reported.

    Deliberately a DIFFERENT predicate from `entry["reapable"]`: the audit's
    `reapable` flags DIRTY, unowned/orphaned debris as a finding for a human
    or agent to notice -- exactly the debris AC-1(e) forbids deleting. This
    function is only ever true for the opposite case: a CLEAN worktree with
    no live task, claim, or lease standing over it. The two are not the same
    condition and must not be collapsed into one.
    """
    if entry["primary"]:
        return False, "primary worktree, never delete-eligible (condition a)"
    live = [t for t in entry["tasks"] if t["live"]]
    if live:
        ids = ", ".join(sorted(t["id"] for t in live))
        return False, f"task-live: {ids} (condition b)"
    task_ids = sorted({t["id"] for t in entry["tasks"]})
    if task_ids:
        placeholders = ",".join("?" * len(task_ids))
        claim = cx.execute(
            "SELECT task_id FROM task_claims WHERE state='active' "
            f"AND task_id IN ({placeholders})", task_ids).fetchone()
        if claim:
            return False, (f"active claim on task {claim['task_id']} "
                           "(condition c)")
        lease = cx.execute(
            "SELECT task_id FROM leases WHERE state='active' "
            f"AND task_id IN ({placeholders})", task_ids).fetchone()
        if lease:
            return False, (f"active lease on task {lease['task_id']} "
                           "(condition d)")
    if entry["counts"] is None:
        return False, "unreadable git state, never assumed clean (condition e)"
    if any(entry["counts"].values()):
        return False, "uncommitted changes present (condition e)"
    return True, None


def reap_delete_worktrees(cx, repo, wt_report, dry_run):
    """Evaluate every worktree `audit_worktrees` reported against AC-1 and,
    unless `dry_run`, remove the eligible ones. Never raises: a removal
    failure (permissions, open handles) is reported per worktree and the
    loop continues rather than aborting (the issue's own failure state).

    Returns {"available", "reason", "dry_run", "removed", "retained", "errors"}.
    `removed` is the list of paths removed -- or, under `dry_run`, the list
    that WOULD be removed (AC-4: dry-run lists exactly what `--delete` would
    remove, without removing it). "Nothing reclaimable" is `removed == []`
    with `available: true`, distinguishable from a failed scan
    (`available: false`).
    """
    if not wt_report.get("available", True):
        return {"available": False, "reason": wt_report.get("reason"),
                "dry_run": dry_run, "removed": [], "retained": [], "errors": []}
    removed, retained, errors = [], [], []
    for entry in wt_report.get("worktrees", []):
        eligible, reason = _worktree_delete_eligible(cx, entry)
        if not eligible:
            retained.append({"path": entry["path"], "reason": reason})
            continue
        if dry_run:
            removed.append(entry["path"])
            continue
        # MERGE_BLOCKER-2 (PR #466 round 1, security): `entry["counts"]` is a
        # snapshot taken once at the top of `cmd_reap`'s single
        # `audit_worktrees` call. Real wall-clock elapses between that scan
        # and this worktree's turn in the delete loop (~3 git calls per
        # worktree, ~20 worktrees in a real fleet), so it can go dirty in
        # between -- and `--force` on `git worktree remove` explicitly
        # suppresses git's own dirty-worktree refusal, so nothing downstream
        # would catch that. Re-verify immediately before the removal call,
        # mirroring AC-5(g)'s fresh-fetch-immediately-before-delete pattern
        # on the branch side, rather than trusting the stale scan.
        fresh_counts, fresh_reason = _worktree_dirt(entry["path"])
        if fresh_counts is None:
            retained.append({"path": entry["path"],
                             "reason": "unreadable git state on re-check, "
                                       "never assumed clean (condition e)"})
            continue
        if any(fresh_counts.values()):
            retained.append({"path": entry["path"],
                             "reason": "became dirty between scan and "
                                       "delete (condition e)"})
            continue
        rc, sout, serr = _git_rw(repo, "worktree", "remove", "--force",
                                 entry["path"])
        if rc == 0:
            removed.append(entry["path"])
        else:
            errors.append({"path": entry["path"],
                           "error": serr or sout or
                                    f"git worktree remove failed (rc={rc})"})
    return {"available": True, "reason": None, "dry_run": dry_run,
            "removed": removed, "retained": retained, "errors": errors}


def _remote_branch_candidates(repo):
    """Enumerate `origin`'s remote-tracking branches. Returns (list, reason);
    exactly one is None, matching `_worktrees`'s own contract.

    Symbolic refs (`origin/HEAD`) are excluded HERE, at enumeration, via
    `for-each-ref`'s `%(symref)` atom -- condition (f) -- rather than left for
    a caller to filter out after the fact.

    Field order is `refname, symref, objectname` -- deliberately NOT
    `..., symref` last. `_git_ro` `.strip()`s its stdout (the exact trap
    `_worktree_dirt`'s own docstring documents for leading whitespace); 
    `%(symref)` is empty for every ordinary branch, so whichever row lands
    last in the output would silently lose its trailing tab-and-empty-field
    to that strip and parse as two columns instead of three. `%(objectname)`
    is always a full, non-empty SHA, so putting it last makes the strip a
    no-op regardless of row order.
    """
    rc, text, err = _git_ro(
        repo, "for-each-ref",
        "--format=%(refname:short)%09%(symref)%09%(objectname)",
        "refs/remotes/origin")
    if rc != 0:
        return None, (err or f"git for-each-ref failed (rc={rc})")
    out_rows = []
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        short, symref, sha = parts
        if symref:
            continue
        out_rows.append({"short": short, "sha": sha})
    return out_rows, None


def _branch_delete_eligible(repo, rows, main_sha, cand):
    """ADR-0061 / accepted AC-5(f-h): is this remote branch deletable?

    Returns (eligible, reason); evaluated in the ADR's own (f)-(g)-(h) order.
    `rows` is every `tasks` row with a non-NULL `branch` -- condition (h)
    reuses `_owning_task`'s own name-matching convention, and
    `READINESS_TERMINAL_STATES` (not `TERMINAL_TASK_STATES` -- see ADR-0061's
    Decision section for why the two are not interchangeable here).
    """
    short = cand["short"]
    if short in ("origin/main", "origin/HEAD") or short == INTEGRATION_REF:
        return False, f"protected ref: {short} (condition f)"
    if _git_ro(repo, "merge-base", "--is-ancestor",
              cand["sha"], main_sha)[0] != 0:
        return False, "not fully merged into origin/main (condition g)"
    branch_name = short[len("origin/"):] if short.startswith("origin/") else short
    matches = [r for r in rows if r["branch"] == branch_name]
    live = [r for r in matches if r["state"] not in READINESS_TERMINAL_STATES]
    if live:
        ids = ", ".join(sorted(r["id"] for r in live))
        return False, (f"correlates to non-terminal task {ids} "
                       "(condition h)")
    return True, None


def reap_delete_branches(cx, repo, dry_run, repository_id=SCOPE_HOME):
    """AC-5: fresh-fetch `origin/main`, then evaluate and (unless `dry_run`)
    delete every remote branch meeting all of (f)-(h). The fetch bounds the
    TOCTOU window between enumeration and delete -- merged status is
    re-verified here, not reused from `cmd_reap`'s earlier worktree audit.
    Never raises. Returns the same
    {"available", "reason", "dry_run", "removed", "retained", "errors"} shape
    as `reap_delete_worktrees`.
    """
    empty = {"dry_run": dry_run, "removed": [], "retained": [], "errors": []}
    rc, _, err = _git_rw(repo, "fetch", "origin", "main", "--prune")
    if rc != 0:
        return {"available": False,
               "reason": err or f"git fetch origin main failed (rc={rc})",
               **empty}
    rc, main_sha, err = _git_ro(repo, "rev-parse", "origin/main")
    if rc != 0 or not main_sha:
        return {"available": False,
               "reason": err or "cannot resolve origin/main after fetch",
               **empty}
    candidates, reason = _remote_branch_candidates(repo)
    if candidates is None:
        return {"available": False, "reason": reason, **empty}
    # ADR-0084: scoped to THIS repository's own tasks, same reasoning as
    # `audit_worktrees` -- a remote branch must never be judged "correlates
    # to a live task" (condition h) on the strength of another
    # repository's task row.
    rows = cx.execute(
        "SELECT id, state, branch FROM tasks "
        "WHERE branch IS NOT NULL AND repository_id=?", (repository_id,)
    ).fetchall() if cx is not None else []
    removed, retained, errors = [], [], []
    for cand in candidates:
        eligible, why = _branch_delete_eligible(repo, rows, main_sha, cand)
        if not eligible:
            retained.append({"branch": cand["short"], "reason": why})
            continue
        if dry_run:
            removed.append(cand["short"])
            continue
        branch_name = cand["short"][len("origin/"):]
        # MERGE_BLOCKER-1 (PR #466 round 1, security): `branch_name` comes
        # verbatim from `for-each-ref` output with no validation that it
        # isn't option-like (e.g. a ref shaped like
        # `refs/heads/--receive-pack=/tmp/x`, which git's low-level ref
        # validator accepts even though `git check-ref-format --branch`
        # rejects it). The attacker surface is "anyone with push access to
        # origin", not this org's own branch-naming conventions, so the `--`
        # end-of-options marker is required, not cosmetic.
        rc, sout, serr = _git_rw(repo, "push", "origin", "--delete", "--",
                                 branch_name)
        if rc == 0:
            removed.append(cand["short"])
        else:
            errors.append({"branch": cand["short"],
                           "error": serr or sout or
                                    f"git push --delete failed (rc={rc})"})
    return {"available": True, "reason": None, "dry_run": dry_run,
            "removed": removed, "retained": retained, "errors": errors}


def cmd_reap(cx, args):
    t = now()
    begin(cx)
    reaped = expire_stale(cx, t)
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
        # #165 follow-up: `--delete` is destructive and irreversible (real
        # worktrees, real pushed-branch deletes), while `resolve_scope`'s
        # explicit branch (rule 2) happily accepts ANY attested id, or the
        # SCOPE_HOME sentinel, with no correlation to what is actually live
        # in THIS plane. On a bound plane, an explicit `--repository-id`
        # that disagrees with the bound home names a bucket this plane's
        # own tasks are never in -- `audit_worktrees`/`reap_delete_branches`
        # then correlate against zero rows, every real protection (ADR-0061
        # conditions b/h) silently vanishes, and a live worktree or a
        # not-actually-merged-here branch gets deleted out from under a
        # running task. This is refused for `--delete` specifically (a
        # mismatched scope on a plain read-only `reap`/`worktree audit`
        # only mislabels a report, never deletes anything). Not applied
        # when no explicit flag is given: the resolved value then IS the
        # home by construction (rules 3/4), so this is a no-op for every
        # caller that omits the flag -- which is every caller today.
        if getattr(args, "delete", False) and \
                getattr(args, "scope_repository_id", None) is not None:
            bound = _meta_get(cx, "repository_id")
            home_id = int(bound) if bound is not None else SCOPE_HOME
            if repository_id != home_id:
                raise RepositoryScopeError(
                    "repository_scope_conflicts_with_home",
                    repository_id=repository_id, home_repository_id=home_id)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc)
    cx.execute("COMMIT")
    # #120: `reap` is the verb this org actually runs on a schedule -- at each
    # heartbeat, and by hand whenever someone wants to see what is stale. It
    # expired claims, leases and slots and knew nothing about worktrees, so
    # the one condition nothing was watching was the one that had already
    # destroyed merged work twice. The audit is bolted to this verb rather
    # than shipped as a separate command NOBODY REMEMBERS TO RUN -- that
    # distinction is the entire subject of #120, #115 and #118.
    #
    # It runs strictly after the transaction commits. The audit shells out to
    # git across every worktree on the box, and holding a BEGIN IMMEDIATE
    # write lock open across that would serialize the whole control plane
    # behind other agents' disk.
    repo = _audit_repo(args)
    wt = audit_worktrees(cx, repo, repository_id)
    result = {**reaped, "worktrees": wt}
    # #433/ADR-0061: strictly additive. `args.delete` is a new argparse flag
    # defaulting False -- when it is not passed, this whole branch is dead
    # code and `result` is byte-for-byte what shipped before (AC-3).
    if getattr(args, "delete", False):
        dry_run = bool(getattr(args, "dry_run", False))
        result["delete"] = {
            "dry_run": dry_run,
            "worktrees": reap_delete_worktrees(cx, repo, wt, dry_run),
            "branches": reap_delete_branches(cx, repo, dry_run, repository_id),
        }
    code = EXIT_ORPHANED_WORKTREE if wt["flagged"] else 0
    out({"ok": code == 0, **result}, code)


def cmd_dump(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    current_run = cx.execute(
        "SELECT value FROM meta WHERE key='current_run_id'"
    ).fetchone()
    state = {
        "slots": [dict(r) for r in cx.execute(
            "SELECT * FROM worker_slots WHERE state='active'").fetchall()],
        "claims": [dict(r) for r in cx.execute(
            "SELECT * FROM task_claims WHERE state='active'").fetchall()],
        "leases": [dict(r) for r in cx.execute(
            "SELECT * FROM leases WHERE state='active'").fetchall()],
        "tasks": [dict(r) for r in cx.execute("SELECT * FROM tasks").fetchall()],
        "task_dependencies": [dict(r) for r in cx.execute(
            "SELECT task_id,depends_on_task_id,repository_id "
            "FROM task_dependencies "
            "ORDER BY task_id,depends_on_task_id").fetchall()],
        "task_admissions": [dict(r) for r in cx.execute(
            "SELECT * FROM task_admissions ORDER BY task_id").fetchall()],
        "current_run_id": current_run["value"] if current_run else None,
        "checkpoints": [dict(r) for r in cx.execute(
            "SELECT * FROM checkpoints ORDER BY id DESC LIMIT 5").fetchall()],
        "vendors": [dict(r) for r in cx.execute("SELECT * FROM vendors").fetchall()],
        # #619: `deploy/nightshift-state-backup.sh:29-30` already documents
        # sequences as riding this snapshot -- "sequences, checkpoints and
        # task lifecycle matter for recovery -- a restored box re-seeds from
        # this file (`nightshift-ctl seq set`, `task upsert`)" -- and `dump`
        # did not emit them, so that restore path had nothing to re-seed FROM.
        # Harmless while sequences only numbered migrations; not harmless once
        # ADR numbers depend on the counter (ADR-0089), because a restore then
        # silently resets it and the next bare `seq next` returns 1, colliding
        # with an ADR-0001 that already has two files on `main`. A silent
        # reset to a plausible-looking number is ADR-0089's own failure mode
        # aimed at its own mechanism.
        #
        # Additive: nothing asserts this key set, and `dump` stays a
        # projection with exit code 0 whatever it reports.
        "sequences": [dict(r) for r in cx.execute(
            "SELECT * FROM sequences ORDER BY name").fetchall()],
        "scheduled_run_detector": {
            "state": [dict(r) for r in cx.execute(
                "SELECT * FROM scheduled_run_detector_state ORDER BY task_id"
            ).fetchall()],
            "observations": [dict(r) for r in cx.execute(
                "SELECT * FROM scheduled_run_observations "
                "ORDER BY scheduled_at DESC, observation_key LIMIT 100"
            ).fetchall()],
        },
        "generated_at": t,
    }
    cx.execute("COMMIT")
    # #107: `dump` is where a driver already looks to ask "what is the state
    # of this org", and until now it could answer that completely while the
    # specs the org runs on were a day stale and nothing said so.
    #
    # It reports but does NOT signal: `dump`'s exit code stays 0 whatever
    # this says. It is a projection -- `deploy/nightshift-state-backup.sh`
    # redirects it into `.omni/control-backup.json` every 30 minutes, and
    # `dump --write` feeds `.omni/control-state.json` -- so making the state
    # snapshot start failing on an unrelated deployment fact would break the
    # backup path to report something the backup path does not care about.
    # The loud signal lives in `spec status`, whose only job is to be gated
    # on (exit EXIT_DIVERGED). Report where drivers look; signal where
    # scripts check.
    #
    # Wrapped because a dump that cannot dump is a real outage and a
    # detector that cannot detect is a note in a field.
    try:
        state["spec"] = spec_report(spec_root=args.spec_root,
                                    expected_repo=args.expected_repo,
                                    expected_ref=args.expected_ref,
                                    proc_root=args.proc_root,
                                    max_ref_age=args.max_ref_age)
    except Exception as exc:  # noqa: BLE001 -- never let this break `dump`
        state["spec"] = {"status": "undetermined", "diverged": True,
                         "reason": "spec check raised %s: %s"
                                   % (type(exc).__name__, exc)}
    if args.write:
        proj = os.path.join(os.path.dirname(args.db) or ".", "control-state.json")
        try:
            fd = open_state_file(proj)
        except StateFileRefused as exc:
            out({"ok": False, "error": "state_file_refused", "path": proj,
                 "reason": exc.reason}, 1)
        with os.fdopen(fd, "w") as f:
            json.dump(state, f, indent=2, sort_keys=True)
        state["projection"] = proj
    out(state)


class StateFileRefused(Exception):
    def __init__(self, reason):
        super().__init__(reason)
        self.reason = reason


def open_state_file(path):
    """Open `path` for a truncating write that cannot have been redirected.

    Audit C3: `.omni/` sits in the target repository, which can track
    `.omni/control-state.json` (or `.omni` itself) as a symlink into the
    operator's home. The parent is opened `O_NOFOLLOW` and must be a real
    directory owned by this uid; the file is opened relative to it with
    `O_NOFOLLOW`, and `O_NONBLOCK` keeps a fifo from hanging the open. To
    keep state elsewhere, pass that real path (`--db`), never a link.
    """
    directory, name = os.path.split(os.path.abspath(path))
    try:
        dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise StateFileRefused("directory is missing or a symlink") from exc
    try:
        info = os.fstat(dir_fd)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
            raise StateFileRefused("directory is not owned by this user")
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW
                         | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0),
                         0o600, dir_fd=dir_fd)
        except OSError as exc:
            raise StateFileRefused(
                "file is a symlink or cannot be opened: %s" % exc.strerror
            ) from exc
    finally:
        os.close(dir_fd)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise StateFileRefused("file is not a regular file")
    os.ftruncate(fd, 0)
    return fd


def cmd_selftest(cx, args):
    begin(cx)
    try:
        cx.execute(
            "INSERT INTO task_claims(task_id,claimant,state,acquired_at)"
            " VALUES('@selftest','probe','active',0)")
        dup_blocked = False
        try:
            cx.execute(
                "INSERT INTO task_claims(task_id,claimant,state,acquired_at)"
                " VALUES('@selftest','probe2','active',0)")
        except sqlite3.IntegrityError:
            dup_blocked = True
    finally:
        cx.execute("ROLLBACK")
    if not dup_blocked:
        out({"ok": False, "reason": "partial unique index not enforcing"}, 1)
    out({"ok": True, "sqlite": sqlite3.sqlite_version, "db": args.db})


def cmd_review_plan(cx, args):
    """Emit ADR-0036's exact-SHA diagnostic plan; never mutate authority."""
    # Importing a local module normally creates __pycache__; this command's
    # contract is zero file writes, including in the executing bundle.
    sys.dont_write_bytecode = True
    try:
        import nightshift_review_plan as planner
    except (ImportError, OSError, SyntaxError):
        out({"ok": False, "error": "review_plan_denied",
             "reason": "bundle_identity_unproved"}, 3)

    try:
        report = planner.build_plan(cx, args.task, args.repo, args.head_sha)
    except planner.PlanDenied as exc:
        out({"ok": False, "error": "review_plan_denied",
             "reason": exc.reason}, 3)
    print(planner.canonical_json(report))


def is_review_plan(args):
    return (args.group, getattr(args, "cmd", None)) == ("review", "plan")


def is_review_eligibility(args):
    return (args.group, getattr(args, "cmd", None)) == ("review", "eligibility")


def is_review_readonly(args):
    """Issue #232 / ADR-0040: eligibility is pure read, exactly like `review
    plan` (AC-3, own module docstring) -- same readonly-connection/fail-closed
    treatment, never `ensure_schema`'s DDL on a plain read."""
    return (is_review_plan(args) or is_review_eligibility(args)
            or is_review_escaped_defects(args))


def cmd_review_marker_mint(cx, args):
    """Mint (or replace) one opaque per-dispatch marker (ADR-0039 AC-3c)."""
    import nightshift_review_receipts as receipts
    if args.domain not in receipts.CANONICAL_DOMAINS:
        out({"ok": False, "error": "review_marker_denied",
             "reason": "domain_unknown"}, 3)
    if not receipts.FULL_SHA.fullmatch(args.head_sha or ""):
        out({"ok": False, "error": "review_marker_denied",
             "reason": "head_sha_invalid"}, 3)
    begin(cx)
    task = cx.execute("SELECT id FROM tasks WHERE id=?", (args.task,)).fetchone()
    if task is None:
        cx.execute("ROLLBACK")
        out({"ok": False, "error": "review_marker_denied",
             "reason": "task_missing"}, 3)
    marker = secrets.token_hex(16)
    t = now()
    cx.execute(
        "INSERT INTO review_dispatch_markers(task_id,head_sha,domain,marker,minted_at)"
        " VALUES(?,?,?,?,?)"
        " ON CONFLICT(task_id,head_sha,domain) DO UPDATE SET"
        " marker=excluded.marker, minted_at=excluded.minted_at",
        (args.task, args.head_sha, args.domain, marker, t))
    cx.execute("COMMIT")
    out({"ok": True, "task_id": args.task, "head_sha": args.head_sha,
         "domain": args.domain, "marker": marker})


# The sibling outcome-JSON path bounds its read; this one did not.
MAX_REVIEW_REPORT_BYTES = 4 * 1024 * 1024


def reviews_log_path(args):
    """Where `.omni/reviews.md` lives for this invocation.

    Beside the resolved control plane, never beside the process CWD. `--db`
    has already been resolved by walking up to the project root (or followed
    through a worktree's `.git` file), so a seat running from a worktree
    appends to the ONE log the retro reads rather than minting a second one
    nobody scores.
    """
    override = getattr(args, "reviews_path", None)
    if override:
        return os.path.abspath(override)
    return os.path.join(os.path.dirname(os.path.abspath(args.db)),
                        "reviews.md")


def _sanitize_free_text(value):
    """Make an arbitrary reviewer string safe to render, without losing it."""
    if not isinstance(value, str):
        return value
    # Collapse newlines too. `_text` refuses them in every inline field, and
    # the degraded retry rebuilt the findings identically -- so an ordinary
    # multi-line reviewer summary failed BOTH attempts and discarded a fully
    # validated ADR-0039 receipt with exit 3, before the transaction opened.
    value = " ".join(value.split())
    cleaned = "".join(
        c for c in value
        if 0x20 <= ord(c) < 0x7f or (ord(c) > 0x9f and ord(c) not in
                                     (0x2028, 0x2029, 0x202e)))
    cleaned = cleaned.replace("```", "'''").replace("`", "'")
    return cleaned or "(redacted)"


def _review_log_entry_from_receipt(args, receipt, findings, *,
                                   degraded=False):
    """Build the log entry for an ADR-0039-attested receipt.

    Seats and vendor are taken ONLY from what the caller declared. They are
    deliberately not derived from `tasks.crew`/`.omni/models.json` (ADR-0072
    amendment 4 forbids exactly that), and an undeclared seat is recorded as
    absent with `independent: "unknown"` rather than guessed. An honest
    "unknown" is the point: this ticket exists because a blank was read as a
    finding of zero.
    """
    import nightshift_review_log as review_log
    owner, name, number = review_log_pr_parts(receipt["pr_url"])
    declared = (getattr(args, "author_seat", None)
                and getattr(args, "reviewer_seat", None))
    slot_id = getattr(args, "slot_id", None)
    degraded_independent = None
    if degraded:
        # Keep the seats when they are well-formed and only the CLAIM about
        # them was refused: naming one seat twice with `--independent yes` is
        # a self-review, and erasing both seats laundered it into an anonymous
        # `independent: unknown` -- the retro then counts it under "the
        # recorder could not observe it". Downgrade the claim, keep the
        # evidence; drop the seats only when they are unusable.
        slot_id = None
        if declared and args.author_seat == args.reviewer_seat:
            degraded_independent = "no"
        else:
            declared = None
    payload = {
        "recorded_at": receipt["comment_created_at"],
        "repo": f"{owner}/{name}",
        "pr": number,
        "task_id": receipt["task_id"],
        "head_sha": receipt["head_sha"],
        "domain": receipt["domain"],
        "verdict": receipt["verdict"],
        "loops": getattr(args, "loops", None) or 1,
        "independent": (degraded_independent if degraded_independent
                        else (getattr(args, "independent", None)
                              if declared else "unknown")),
        "slot_state": "held" if slot_id else "unknown",
        "provenance": "attested",
        "comment_url": receipt["comment_url"],
        "marker": receipt["marker"],
        "findings": [{"severity": f["severity"],
                      "criterion": _sanitize_free_text(f["criterion"]),
                      "summary": _sanitize_free_text(f["summary"])}
                     for f in findings],
    }
    if declared:
        payload["author_seat"] = args.author_seat
        payload["reviewer_seat"] = args.reviewer_seat
    if not degraded and getattr(args, "vendor", None):
        payload["vendor"] = args.vendor
    if slot_id:
        payload["slot_id"] = slot_id
    return review_log.validate_entry(payload)


def review_log_pr_parts(pr_url):
    import nightshift_review_receipts as receipts
    owner, name, number = receipts.parse_pr_url(pr_url)
    return owner, name, int(number)


def _review_receipt_row_from_entry(entry):
    """The `review_receipts` shape for a log entry that has no PR comment.

    `comment_url` and `marker` are NOT NULL in a schema built for the attested
    path. Rather than write an empty string that reads like a missing value,
    both point at the log entry that IS the evidence here -- an `omni://`
    URI which cannot be mistaken for a GitHub comment -- and `source` says
    which kind of record this is.
    """
    import nightshift_review_log as review_log
    return {
        "task_id": entry["task_id"],
        "head_sha": entry["head_sha"],
        "domain": entry["domain"],
        "verdict": entry["verdict"],
        "pr_url": f"https://github.com/{entry['repo']}/pull/{entry['pr']}",
        "comment_url": f"omni://reviews.md#{entry['entry_id']}",
        "marker": f"entry:{entry['entry_id']}",
        "report_digest": receipts_digest(
            review_log.canonical_json(entry)),
        "comment_created_at": entry["recorded_at"],
    }


def receipts_digest(text):
    import nightshift_review_receipts as receipts
    return receipts.digest(text)


def _bundle_rules_digest():
    """The committed ruleset digest, or None when the bundle cannot prove it.

    Same best-effort treatment `review receipt-record` already gives it
    (issue #232 / ADR-0040): `review eligibility` treats NULL as drift and
    fails closed, so leaving it unset is never read as "no drift".
    """
    import nightshift_review_plan as review_plan
    try:
        _rules, authority = review_plan._bundle_rules()
        return authority["rules_digest"]
    except review_plan.PlanDenied:
        return None


SEVERITY_ORDER = {"MERGE_BLOCKER": 0, "PRE_DEPLOYMENT": 1, "FOLLOW_UP": 2}


def _weakened_findings(cx, row, findings):
    """Findings already recorded for this head that this write would weaken.

    Issue #734 / ADR-0095. `_write_review_findings` DELETEs every row for
    `(task_id, head_sha, domain)` and re-inserts what the new payload carries,
    so a later attestation for the same head silently rewrites the table
    `review eligibility` gates on. An adversarial review demonstrated it end to
    end on the ATTESTED path: crew_beta records a MERGE_BLOCKER, crew_alpha
    mints its own marker (`review marker-mint` is unauthenticated), re-attests
    the same finding as FOLLOW_UP, and the blocker is gone -- exit 0.

    A finding is weakened if the new payload drops it, lowers its severity, or
    marks it `fixed`/`overturned`.

    **Why no seat check.** An earlier version of this change asked "is the
    party filing this the crew under review?" and needed a self-declared seat
    to answer -- which the receipt path does not even carry, and which #725
    says means nothing anyway. It is not needed: on a GIVEN HEAD, a finding
    never legitimately gets weaker. Eligibility gates per head, so a genuine
    fix produces a new commit, a new head, and a fresh review whose findings
    are recorded against that head. The old head's blocker does not follow the
    code forward, so nothing has to be cleared for the fix loop to work. That
    is what makes this rule identity-free, and therefore actually enforceable.

    The `fixed`/`overturned` skip below still applies to findings this head has
    never recorded -- a `reconstructed` replay of history should not write a
    long-resolved finding as blocking. What is refused is weakening what this
    head already says.
    """
    # Only MERGE_BLOCKERs are protected. A reviewer revising its own review --
    # re-minting a marker and re-posting a corrected block -- legitimately
    # drops and rewords lesser findings, and an existing test covers exactly
    # that (`test_recapture_after_remint_replaces_the_receipt_and_its_findings`
    # drops a FOLLOW_UP and adds a MERGE_BLOCKER, which is the record getting
    # STRONGER). Guarding every severity refused that, which is the false
    # refusal that gets a gate deleted rather than argued with.
    #
    # What #716 is about is blockers: "both teams downgraded findings raised
    # against them". A MERGE_BLOCKER is the only severity that stops a merge,
    # so it is the only one whose removal changes what ships.
    existing = {}
    for record in cx.execute(
            "SELECT fingerprint, severity, summary FROM review_findings"
            " WHERE task_id=? AND head_sha=? AND domain=? AND severity=?",
            (row["task_id"], row["head_sha"], row["domain"], "MERGE_BLOCKER")):
        existing[record["fingerprint"]] = (record["severity"], record["summary"])
    if not existing:
        return []

    import nightshift_review_receipts as receipts
    incoming = {}
    for finding in findings:
        key = receipts.fingerprint(finding.get("criterion"), finding["summary"])
        incoming[key] = finding

    weakened = []
    for key, (was_severity, summary) in sorted(existing.items()):
        finding = incoming.get(key)
        if finding is None:
            weakened.append(
                f"{was_severity} {summary!r} is recorded for this head and "
                "this attestation does not carry it -- a finding is not "
                "withdrawn by omission")
            continue
        if finding.get("disposition") in ("fixed", "overturned"):
            weakened.append(
                f"{was_severity} {summary!r} is recorded for this head and "
                f"this attestation marks it {finding['disposition']!r} -- a "
                "finding is cleared by a new head carrying the fix, not by "
                "re-attesting the head it was raised against")
            continue
        now = finding.get("severity")
        if (now in SEVERITY_ORDER and was_severity in SEVERITY_ORDER
                and SEVERITY_ORDER[now] > SEVERITY_ORDER[was_severity]):
            weakened.append(
                f"{was_severity} {summary!r} is recorded for this head and "
                f"this attestation lowers it to {now} -- a team does not "
                "re-rank the reviewer checking its work (ADR-0026, ADR-0095)")
    return weakened


def _write_review_findings(cx, row, findings, t):
    import nightshift_review_receipts as receipts
    cx.execute(
        "DELETE FROM review_findings WHERE task_id=? AND head_sha=? AND domain=?",
        (row["task_id"], row["head_sha"], row["domain"]))
    for finding in findings:
        # `review_findings` is what `review eligibility` gates on, and it has
        # no disposition column. Writing a finding the entry itself records as
        # `fixed` or `overturned` blocked that head forever -- the tool
        # punished the honest record and rewarded re-logging with no findings
        # at all. The FILE keeps every finding and its disposition; the plane
        # keeps the ones that still block.
        if finding.get("disposition") in ("fixed", "overturned"):
            continue
        cx.execute(
            "INSERT INTO review_findings(task_id,head_sha,domain,severity,"
            "fingerprint,criterion,summary,created_at) VALUES(?,?,?,?,?,?,?,?)",
            (row["task_id"], row["head_sha"], row["domain"],
             finding["severity"],
             finding.get("fingerprint") or receipts.fingerprint(
                 finding.get("criterion"), finding["summary"]),
             finding.get("criterion"), finding["summary"], t))


def _upsert_review_receipt(cx, row, source, rules_digest, t):
    cx.execute(
        "INSERT INTO review_receipts(task_id,head_sha,domain,verdict,pr_url,"
        "comment_url,marker,report_digest,comment_created_at,validated_at,"
        "created_at,rules_digest,source) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)"
        " ON CONFLICT(task_id,head_sha,domain) DO UPDATE SET"
        " verdict=excluded.verdict, pr_url=excluded.pr_url,"
        " comment_url=excluded.comment_url, marker=excluded.marker,"
        " report_digest=excluded.report_digest,"
        " comment_created_at=excluded.comment_created_at,"
        " validated_at=excluded.validated_at,"
        " rules_digest=excluded.rules_digest, source=excluded.source",
        (row["task_id"], row["head_sha"], row["domain"], row["verdict"],
         row["pr_url"], row["comment_url"], row["marker"],
         row["report_digest"], row["comment_created_at"],
         row.get("validated_at", t), t, rules_digest, source))


class _SkipReceipt(Exception):
    """Internal: this entry is logged but has no receipt to mint."""


def cmd_review_log(cx, args):
    """ADR-0090 / issue #717: record what a review found, where the retro
    can score it.

    The instrument this repairs was prose. `.omni/reviews.md` says the retro
    reads it to compute escaped defects, `program/agents/release/config.yaml`
    gates merges on domains it never had data for, and NOTHING in the codebase
    wrote to either. A 12-hour run with two genuine cross-crew reviews left the
    file byte-identical; an org redesign was then drafted on that empty
    reading, and would have deleted the seats that found the run's two hardest
    defects.

    So the order of operations here is the argument: the log entry is written
    FIRST and unconditionally, and the receipt is attempted afterwards. A
    review whose task row is missing, whose slot was bypassed, or whose repo
    forbids PR comments still ends up in the file. What is lost in that case
    is the accounting, and the output says so by name instead of exiting
    quietly with nothing written.
    """
    import nightshift_review_log as review_log
    raw = None
    report_path = args.report_json
    try:
        if report_path in (None, "-"):
            raw = sys.stdin.read(MAX_REVIEW_REPORT_BYTES + 1)
            if len(raw) > MAX_REVIEW_REPORT_BYTES:
                out({"ok": False, "error": "review_log_denied",
                     "reason": "report_too_large"}, 3)
        else:
            with open(report_path, encoding="utf-8") as handle:
                raw = handle.read()
    except (OSError, UnicodeDecodeError):
        out({"ok": False, "error": "review_log_denied",
             "reason": "report_unreadable"}, 3)
    try:
        payload = json.loads(raw)
    except ValueError:
        out({"ok": False, "error": "review_log_denied",
             "reason": "report_unparseable"}, 3)

    try:
        entry = review_log.validate_entry(payload, default_recorded_at=now())
    except review_log.LogDenied as exc:
        out({"ok": False, "error": "review_log_denied",
             "reason": exc.reason}, 3)
    if entry["provenance"] == "attested":
        # An attested entry must come through `review receipt-record`, which
        # actually fetches the comment and checks the marker. Accepting a
        # caller-declared attestation here would make the strong label
        # purchasable with a JSON key.
        out({"ok": False, "error": "review_log_denied",
             "reason": "attested_requires_receipt_record"}, 3)

    path = reviews_log_path(args)
    try:
        review_log.append_entry(path, entry)
    except review_log.LogDenied as exc:
        out({"ok": False, "error": "review_log_denied",
             "reason": exc.reason, "reviews_path": path}, 3)

    row = _review_receipt_row_from_entry(entry)
    if entry["head_sha"] == review_log.HEAD_UNRECOVERABLE:
        # ADR-0040's reuse branch selects `head_sha != ?` and can otherwise
        # report `satisfied_by: "reused", head_sha: "unrecoverable"`. A
        # reconstruction that cannot name the head it reviewed must not
        # satisfy a gate for any head. The entry is still logged.
        receipt_recorded = False
        out({"ok": True, "reviews_path": path, "entry_id": entry["entry_id"],
             "recorded_at": entry["recorded_at"],
             "provenance": entry["provenance"],
             "findings_count": len(entry["findings"]),
             "contradictions": entry["contradictions"],
             "receipt_recorded": False,
             "receipt_skipped_reason": "head_sha_unrecoverable"})
    if cx is None:
        out({"ok": True, "reviews_path": path, "entry_id": entry["entry_id"],
             "recorded_at": entry["recorded_at"],
             "provenance": entry["provenance"],
             "findings_count": len(entry["findings"]),
             "contradictions": entry["contradictions"],
             "receipt_recorded": False,
             "receipt_skipped_reason": "control_plane_missing"})
    # Bundle-identity work touches the filesystem; it must not happen while
    # holding BEGIN IMMEDIATE.
    receipt_recorded = False
    receipt_skipped = None
    if entry["domain_outside_vocabulary"]:
        # `review_receipts.domain` is a closed CHECK set (ADR-0039) and this
        # verb does not get to widen it. The entry is in the file, which is
        # the point; the receipt is skipped by name rather than by an
        # IntegrityError the caller would have to interpret.
        receipt_skipped = "domain_outside_vocabulary"
    try:
        t = now()
        if receipt_skipped:
            raise _SkipReceipt
        if entry["pr"] is None:
            # Issue #724 / ADR-0092. A review that ran before the PR existed
            # has no PR to attest against, and `review_receipts.pr_url` is
            # NOT NULL. Minting anyway wrote the literal string
            # ".../pull/None" into the column whose only job is to LOCATE the
            # PR -- and the no-overwrite rule then made that fabricated,
            # findings-free receipt final for (task_id, head_sha, domain),
            # so the real post-PR review of the same head could no longer
            # record its MERGE_BLOCKER. A passing receipt with no findings,
            # standing in front of a blocker: the precise failure the
            # overwrite rule was added to prevent, reached through the front
            # door. The file entry is still written; only the receipt is not.
            receipt_skipped = "pre_pr_review_has_no_attestable_pr"
            raise _SkipReceipt
        begin(cx)
        task = cx.execute("SELECT id, pr_url FROM tasks WHERE id=?",
                          (row["task_id"],)).fetchone()
        # The report declares its own repo and PR number. Trusting them wrote
        # a fabricated `pr_url` into a NOT NULL column whose only job is to
        # locate the PR -- and the upsert propagated it over any existing row.
        # The task already knows its PR; disagreement is refused by name.
        pr_mismatch = None
        if task is not None and task["pr_url"]:
            if task["pr_url"].rstrip("/") != row["pr_url"].rstrip("/"):
                pr_mismatch = "pr_url_disagrees_with_task"
            else:
                row["pr_url"] = task["pr_url"]
        existing = cx.execute(
            "SELECT source FROM review_receipts"
            " WHERE task_id=? AND head_sha=? AND domain=?",
            (row["task_id"], row["head_sha"], row["domain"])).fetchone()
        if task is None:
            cx.execute("ROLLBACK")
            receipt_skipped = "task_missing"
        elif existing is not None:
            # This verb never overwrites a receipt -- not another source's,
            # and not its own. The upsert is inherited from `receipt-record`,
            # where replacing a row means re-validating the SAME comment; here
            # it meant a second `review log` for one (task, head, domain)
            # flipped the verdict and DELETEd every recorded finding. Measured:
            # a reviewer logs a MERGE_BLOCKER, an author logs a clean pass, and
            # the blocker is gone from the plane while the file still shows it.
            # An earlier guard tested `source != provenance`, which let exactly
            # that through because both rows are `local`. The file is
            # append-only; so is this.
            # The upsert is shared with the ADR-0039 path, so an unattested
            # `review log` used to overwrite an attested receipt's verdict,
            # comment_url and marker AND delete its findings -- destroying a
            # proof that took a marker mint and a fetched comment to make,
            # with one command. The entry is still logged; only the receipt
            # is refused, and it is refused by name.
            cx.execute("ROLLBACK")
            receipt_skipped = ("existing_receipt_from_"
                               + (existing["source"] or "before_migration_13"))
        elif pr_mismatch is not None:
            cx.execute("ROLLBACK")
            receipt_skipped = pr_mismatch
        else:
            # NULL, deliberately. ADR-0040 reads a digest as "validated
            # against this ruleset" and treats NULL as drift, failing closed.
            # `receipt-record` earns the stamp by validating now; a `local` or
            # `reconstructed` entry was never validated against any ruleset,
            # and stamping today's digest turned a fail-closed gate into a
            # positive no-drift assertion. Worst on the historical replay,
            # which is the workflow that needs it least.
            # No weakening check on this path, deliberately. `review_findings`
            # rows are only ever written alongside a receipt, and `review log`
            # refuses outright once a receipt exists for the key (above), so a
            # logged entry can never reach a head that already has findings.
            # A gate here would be code nothing can invoke -- which #729 exists
            # to refuse. A mutation confirmed it: disabling it failed no test,
            # because no test could reach it.
            _upsert_review_receipt(cx, row, entry["provenance"], None, t)
            _write_review_findings(cx, row, entry["findings"], t)
            cx.execute("COMMIT")
            receipt_recorded = True
    except _SkipReceipt:
        pass
    except sqlite3.IntegrityError:
        # `verdict: "unknown"` is reconstruction-only by design and the DB
        # CHECK set is closed, so this is a documented outcome -- not the
        # disk fault, lock timeout or corruption the generic reason implies.
        try:
            cx.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        receipt_skipped = ("verdict_not_representable"
                           if entry["verdict"] not in ("pass", "fail")
                           else "receipt_rejected_by_schema")
    except sqlite3.Error as exc:
        try:
            cx.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        receipt_skipped = f"control_plane_error:{type(exc).__name__}"

    out({"ok": True, "reviews_path": path, "entry_id": entry["entry_id"],
         "recorded_at": entry["recorded_at"], "provenance": entry["provenance"],
         "findings_count": len(entry["findings"]),
         "contradictions": entry["contradictions"],
         "receipt_recorded": receipt_recorded,
         "receipt_skipped_reason": receipt_skipped})


def cmd_review_escaped_defects(cx, args):
    """ADR-0090 / issue #717 AC-4: the number the retro exists to produce.

    A count of zero is an answer. An empty READ is not -- it is the reading
    that got the reviewer seats nearly deleted -- so zero parseable entries is
    exit 3 with a reason, never `{"escaped": 0}`.
    """
    import nightshift_review_log as review_log
    path = reviews_log_path(args)
    try:
        log = review_log.read_log(path)
    except review_log.LogDenied as exc:
        out({"ok": False, "error": "review_escaped_defects_denied",
             "reason": exc.reason, "reviews_path": path}, 3)
    entries = log["entries"]
    total_entries = len(entries)
    if not entries:
        # A file full of pre-ADR-0090 review rows is NOT a file in which
        # nobody recorded anything. Saying `no_entries` about it, and telling
        # the retro to read that as "reviews happened and nobody recorded
        # them", is this ticket's own defect committed by its own reader.
        # Three different silences, three different reasons. Collapsing the
        # middle one into `no_entries` told the retro -- which branches on
        # this exact string -- that reviews which happened were not recorded,
        # about a file holding nothing but genuinely recorded reviews it
        # could not parse. That is this ticket's defect, committed by the
        # reader this ticket added.
        if log["unreadable"] and not log["legacy_rows"]:
            reason = "entries_unreadable"
        elif log["legacy_rows"]:
            reason = "legacy_entries_only"
        else:
            reason = "no_entries"
        out({"ok": False, "error": "review_escaped_defects_denied",
             "reason": reason, "reviews_path": path, "entries_in_file": 0,
             "legacy_rows": log["legacy_rows"],
             "unreadable_entries": log["unreadable"],
             # Dropped from this payload before: the one number that tells a
             # reader "reviews ARE in this file and their fences are gone"
             # was omitted from exactly the branch that reports emptiness.
             "entries_without_fence": max(0, log["headings"] - log["fences"]),
             "headings": log["headings"], "fences": log["fences"]}, 3)

    # The window selects what is REPORTED, never what is known. Filtering
    # before the computation removed the `pass` entries that predate the
    # window, so the blocker inside it was no longer "after a pass" and the
    # retro's own documented per-wave invocation returned zero.
    selected = entries
    if args.repo:
        selected = [e for e in selected if e["repo"] == args.repo]
    if args.pr is not None:
        selected = [e for e in selected if e["pr"] == args.pr]
    if args.since:
        try:
            since = review_log.normalize_timestamp(args.since)
        except review_log.LogDenied:
            out({"ok": False, "error": "review_escaped_defects_denied",
                 "reason": "since_invalid"}, 3)
        selected = [e for e in selected if e["recorded_at"] >= since]
    if not selected:
        out({"ok": False, "error": "review_escaped_defects_denied",
             "reason": "no_entries_in_window", "reviews_path": path,
             "entries_in_file": total_entries}, 3)

    # A plane older than migration 13 has no `source` column, and there may
    # be no plane at all. Unknown is not "all attested": an empty set means
    # every `attested` entry is reported unverified rather than believed.
    attested = _receipt_keys(cx, "attested")
    report = review_log.escaped_defects(entries, attested_receipts=attested)
    # An entry deleted wholesale from the file leaves no trace in the file --
    # there is nothing left to be missing. The control plane is the second
    # record: a receipt this verb or `receipt-record` wrote whose entry is no
    # longer in the log means the log lost one.
    logged = {(e["task_id"], e["head_sha"], e["domain"]) for e in entries}
    # Only rows THIS mechanism wrote. A receipt older than migration 13 has
    # `source IS NULL` and never had a log entry to lose, so counting it here
    # reported a fabricated loss against the oldest and best-evidenced rows in
    # the table -- a false alarm in the one field whose whole job is detecting
    # a real one.
    receipts_rows = _receipt_keys(cx)
    report["receipts_without_entries"] = sorted(
        "/".join(k) for k in (receipts_rows - logged))
    # The window filters the ANSWER, never the input. Every defect was
    # computed against the full log's passes, then kept only if the entry
    # that recorded it falls inside the window.
    in_window = None
    if args.pr is not None or args.since or args.repo:
        defects = [
            d for d in report["defects"]
            if (args.pr is None or d["pr"] == args.pr)
            and (not args.repo or d["repo"] == args.repo)
            and (not args.since or d["last_recorded_at"] >= since)]
        by_severity = {name: 0 for name in review_log.BLOCKING}
        for defect in defects:
            by_severity[defect["severity"]] += 1
        in_window = {
            "entries": len(selected),
            "escaped": len(defects),
            "escaped_by_severity": by_severity,
            "defects": defects,
        }
    report["ok"] = True
    report["reviews_path"] = path
    report["entries_in_file"] = total_entries
    # Everything the file says badly, reported beside the number rather than
    # dropped: rows in the pre-ADR-0090 format, entries that would not parse,
    # identical entries appended twice, and headings a person can read whose
    # fence is missing so nothing counts them.
    report["legacy_rows"] = log["legacy_rows"]
    report["unreadable_entries"] = log["unreadable"]
    report["duplicate_entries"] = log["duplicates"]
    report["entries_without_fence"] = max(0, log["headings"] - log["fences"])
    if in_window is not None:
        # The windowed answer REPLACES the headline. It used to sit in a
        # `window` sub-object while `escaped` stayed whole-log, and the retro
        # skill prints the `--since` recipe and then says to quote `escaped`
        # -- so the published per-wave metric was the cumulative all-time
        # count, a number that can only grow. The full-log figures stay,
        # under `whole_log`, for anyone who wants them.
        report["whole_log"] = {k: report[k] for k in
                               ("escaped", "escaped_by_severity", "defects",
                                "entries")}
        report.update({k: in_window[k] for k in
                       ("escaped", "escaped_by_severity", "defects")})
        report["entries_in_window"] = in_window["entries"]
        report["window"] = in_window
    out(report)


def _receipt_keys(cx, source=None):
    """(task, head, domain) for receipts, or an empty set when unknowable.

    Empty is the fail-closed answer everywhere it is used: an unverifiable
    `attested` claim is reported as unverified, and a receipt that cannot be
    read is not reported as a lost log entry.
    """
    if cx is None:
        return set()
    sql = "SELECT task_id, head_sha, domain FROM review_receipts"
    sql += " WHERE source=?" if source else " WHERE source IS NOT NULL"
    try:
        return {(r["task_id"], r["head_sha"], r["domain"])
                for r in cx.execute(sql, (source,) if source else ())}
    except sqlite3.Error:
        return set()


def is_review_log(args):
    return (args.group, getattr(args, "cmd", None)) == ("review", "log")


def is_review_escaped_defects(args):
    return (args.group,
            getattr(args, "cmd", None)) == ("review", "escaped-defects")


def cmd_review_receipt_record(cx, args):
    """Validate a PR comment against ADR-0039's fail-closed matrix, then persist."""
    import nightshift_review_receipts as receipts
    try:
        result = receipts.validate_receipt(
            cx, task_id=args.task, head_sha=args.head_sha, domain=args.domain,
            comment_url=args.comment_url)
    except receipts.ReceiptDenied as exc:
        out({"ok": False, "error": "review_receipt_denied",
             "reason": exc.reason}, 3)

    # Issue #232 / ADR-0040 -- stamp the CURRENTLY COMMITTED ruleset's digest
    # at validation time, so a later `review eligibility` call can detect
    # ruleset drift (AC-2d/AC-4b). Best-effort: an unprovable bundle identity
    # (e.g. an unusual deployment layout) leaves this NULL rather than
    # blocking receipt persistence itself -- `review eligibility` treats NULL
    # the same as a real mismatch (fail closed), never as "no drift".
    rules_digest_at_record = _bundle_rules_digest()

    import nightshift_review_log as review_log
    r = result["receipt"]
    entry_degraded = None
    try:
        entry = _review_log_entry_from_receipt(args, r, result["findings"])
    except review_log.LogDenied as exc:
        # The receipt itself already passed ADR-0039's matrix. Losing it
        # because a caller mistyped `--author-seat`, or because a reviewer's
        # own finding text contains a code fence, would discard validated
        # evidence over presentation metadata. Degrade the ENTRY instead, and
        # say which field was dropped.
        entry_degraded = exc.reason
        try:
            entry = _review_log_entry_from_receipt(
                args, r, result["findings"], degraded=True)
        except review_log.LogDenied as inner:
            out({"ok": False, "error": "review_receipt_denied",
                 "reason": f"review_log_{inner.reason}"}, 3)
    reviews_path = reviews_log_path(args)
    # The append happens BEFORE the transaction, not inside it. Holding
    # `BEGIN IMMEDIATE` across a filesystem write meant one slow or blocked
    # path took the whole control plane down with it -- an unrelated
    # `task upsert` from another process blocked 32 seconds and then died on
    # `database is locked`. This ordering keeps the invariant that matters (a
    # persisted receipt implies a logged entry) and gives up only the reverse,
    # which is the direction we choose to lose: the finding survives and the
    # accounting is what goes missing.
    try:
        review_log.append_entry(reviews_path, entry)
    except review_log.LogDenied as exc:
        out({"ok": False, "error": "review_receipt_denied",
             "reason": exc.reason, "reviews_path": reviews_path}, 3)
    t = now()
    begin(cx)
    # Authoritative, atomic re-check (architect finding on PR #246, TOCTOU):
    # `validate_receipt`'s own marker read committed and returned before this
    # transaction opened, so a concurrent `review marker-mint` for this exact
    # (task, head, domain) could have replaced the marker in between. Re-read
    # it INSIDE this BEGIN IMMEDIATE transaction -- which blocks a concurrent
    # marker-mint's own BEGIN IMMEDIATE until this one commits or rolls back
    # -- so nothing can change the marker between this comparison and the
    # INSERT below.
    current = cx.execute(
        "SELECT marker FROM review_dispatch_markers"
        " WHERE task_id=? AND head_sha=? AND domain=?",
        (r["task_id"], r["head_sha"], r["domain"])).fetchone()
    if current is None or current["marker"] != r["marker"]:
        cx.execute("ROLLBACK")
        out({"ok": False, "error": "review_receipt_denied",
             "reason": "marker_mismatch"}, 3)
    if receipts.marker_consumed(cx, r["marker"], r["comment_url"]):
        cx.execute("ROLLBACK")
        out({"ok": False, "error": "review_receipt_denied",
             "reason": "marker_consumed"}, 3)
    # Issue #734 / ADR-0095. Checked here, before the receipt is upserted, so
    # a re-attestation that would weaken this head's findings leaves BOTH the
    # receipt and the findings untouched. This is the path the review
    # demonstrated: mint a marker for a head someone else reviewed, attest it
    # with the blocker lowered, and the gating table is rewritten at exit 0.
    weakened = _weakened_findings(cx, r, result["findings"])
    if weakened:
        cx.execute("ROLLBACK")
        out({"ok": False, "error": "review_findings_weakened",
             "reasons": weakened, "task_id": r["task_id"],
             "head_sha": r["head_sha"], "domain": r["domain"]}, 3)
    _upsert_review_receipt(cx, r, "attested", rules_digest_at_record, t)
    _write_review_findings(cx, r, result["findings"], t)
    cx.execute("COMMIT")
    out({"ok": True, "receipt": r, "findings_count": len(result["findings"]),
         "reviews_path": reviews_path, "entry_id": entry["entry_id"],
         "entry_degraded_reason": entry_degraded})


def cmd_review_consolidate(cx, args):
    """Pure DB read: is every required domain in, and what do findings say."""
    import nightshift_review_receipts as receipts
    try:
        with open(args.contract, encoding="utf-8") as handle:
            contract_text = handle.read()
    except OSError:
        out({"ok": False, "error": "review_consolidate_denied",
             "reason": "contract_unreadable"}, 3)
    try:
        required = receipts.parse_required_domains(contract_text)
    except receipts.ReceiptDenied as exc:
        out({"ok": False, "error": "review_consolidate_denied",
             "reason": exc.reason}, 3)

    rows = cx.execute(
        "SELECT domain FROM review_receipts WHERE task_id=? AND head_sha=?",
        (args.task, args.head_sha)).fetchall()
    present = {row["domain"] for row in rows}
    missing = sorted(set(required) - present)
    if missing:
        out({"ok": True, "ready": False, "required_domains": required,
             "missing_domains": missing})

    finding_rows = cx.execute(
        "SELECT domain, severity, criterion, summary, fingerprint"
        " FROM review_findings WHERE task_id=? AND head_sha=?",
        (args.task, args.head_sha)).fetchall()
    consolidated = receipts.consolidate_findings(dict(row) for row in finding_rows)
    out({"ok": True, "ready": True, "required_domains": required,
         "findings": consolidated})


def cmd_review_eligibility(cx, args):
    """Pure read (issue #232 / ADR-0040): direct-or-reused receipts, one digest."""
    import nightshift_review_eligibility as eligibility
    try:
        with open(args.contract, encoding="utf-8") as handle:
            contract_text = handle.read()
    except OSError:
        out({"ok": False, "error": "review_eligibility_denied",
             "reason": "contract_unreadable"}, 3)
    try:
        result = eligibility.compute_eligibility(
            cx, args.repo, args.task, args.head_sha, contract_text)
    except eligibility.ReceiptDenied as exc:
        out({"ok": False, "error": "review_eligibility_denied",
             "reason": exc.reason}, 3)
    out({"ok": True, **result})


# ------------------------------------------------------------- bookkeeping -
#
# Issue #286 / ADR-0052: a fail-closed fast path for bookkeeping-only PRs
# (`.omni/STATUS.md`, `.omni/ledger.md`, `.omni/tech-debt.md`,
# `.omni/reports/**`). This is the shadow-planner shape `review plan` already
# established, one layer over: `nightshift_bookkeeping_release` reads and
# computes, `nightshift-ctl` owns every control.db write.
#
# `release` is the only consumer that matters and is NOT this crew's
# sub-agent -- it is a separate, program-routed role (docs/CONTROL-PLANE.md).
# The contract these three verbs expose is exactly what it needs: `plan`
# answers "is this exact head fast-path eligible, and why/why not", `verify
# -head` answers "did the head I planned against change before I merged it",
# `receipt-record` persists the exact merged SHA once `release` has acted, so
# AC-4 ("records the exact merged SHA and a verification receipt") has
# somewhere durable to live.

# Issue #390 security review FOLLOW_UP: bound the external-input read the
# same way `nightshift_review_receipts.MAX_STDOUT` already bounds a
# comparable adjacent-adversarial-input surface (this org's own precedent,
# not a new convention). 1 MiB is generously larger than any real heartbeat
# outcome record and small enough that an unbounded stdin/file cannot turn
# a cheap decision call into an unbounded-memory read.
MAX_OUTCOME_JSON_BYTES = 1_048_576


def _read_outcome_json(path):
    """Read the `outcome` JSON `heartbeat-persist decide`/`record` consume.
    Returns a dict, or None on ANY failure (missing file, bad JSON, not an
    object, or a read exceeding MAX_OUTCOME_JSON_BYTES) -- callers treat
    None as a hard, fail-closed denial, never a crash, matching this
    module's own "never raise" discipline."""
    try:
        if path in (None, "-"):
            raw = sys.stdin.read(MAX_OUTCOME_JSON_BYTES + 1)
        else:
            with open(path) as f:
                raw = f.read(MAX_OUTCOME_JSON_BYTES + 1)
        if len(raw) > MAX_OUTCOME_JSON_BYTES:
            return None
        data = json.loads(raw)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def cmd_heartbeat_persist_decide(cx, args):
    """Issue #390's pure decision endpoint. Reads `--outcome-json` (a path,
    or `-`/omitted for stdin), calls `nightshift_heartbeat_persistence.decide`,
    prints the verdict. Plane-free by construction (PLANE_FREE_VERBS): this
    command never shells to git, never writes a file, never calls `gh`, and
    never touches `control.db` -- AC-1's "zero Git artifacts" is true of this
    command by what it physically cannot do, not merely by what it happens
    not to do."""
    sys.dont_write_bytecode = True
    import nightshift_heartbeat_persistence as hp
    outcome = _read_outcome_json(args.outcome_json)
    if outcome is None:
        out({"ok": False, "error": "heartbeat_persist_decide_denied",
             "reason": "outcome_json_invalid", "should_persist_to_git": False,
             "reason_code": "outcome_json_invalid", "route": "none"}, 3)
    out({"ok": True, **hp.decide(outcome)})


def cmd_heartbeat_persist_record(cx, args):
    """Same decision as `decide`, plus exactly one append-only telemetry row
    (AC-13) -- called for EVERY heartbeat outcome, no-op or durable-delta
    alike, so "no-op heartbeat -> PR count = 0" stays a query result, not a
    narrated claim. Returns `receipt_id`: the one-shot token
    `pr-create --heartbeat-persist-receipt` consumes when
    `should_persist_to_git` is true. A no-op decision's `receipt_id` is still
    returned for completeness/audit but can never be consumed by `pr-create`
    -- `should_persist=1` is part of the consuming UPDATE's WHERE clause."""
    sys.dont_write_bytecode = True
    import nightshift_heartbeat_persistence as hp
    outcome = _read_outcome_json(args.outcome_json)
    if outcome is None:
        out({"ok": False, "error": "heartbeat_persist_record_denied",
             "reason": "outcome_json_invalid"}, 3)
    result = hp.decide(outcome)
    begin(cx)
    t = now()
    cur = cx.execute(
        "INSERT INTO heartbeat_persist_decisions("
        "run_id,input_digest,authority_status,observation_codes_json,"
        "durable_delta_reason_code,should_persist,output_reason_code,route,"
        "recorded_at) VALUES(?,?,?,?,?,?,?,?,?)",
        (args.run_id, result["input_digest"],
         str(outcome.get("authority_status")),
         json.dumps(outcome.get("observation_codes") or []),
         outcome.get("durable_delta_reason_code"),
         1 if result["should_persist_to_git"] else 0,
         result["reason_code"], result["route"], t),
    )
    receipt_id = cur.lastrowid
    cx.execute("COMMIT")
    out({"ok": True, **result, "receipt_id": receipt_id})


def cmd_bookkeeping_plan(cx, args):
    """Classify the exact PR head and, if bookkeeping-only, run the focused
    deterministic checks bundle. Exit 3 only when NO plan could be produced
    at all (bad task/SHA/git state) -- a successfully produced plan whose
    `fast_path_eligible` is false is exit 0 with that field telling the
    caller to use the normal release path (AC-1's fail-closed default is a
    VALUE, not a process failure)."""
    sys.dont_write_bytecode = True
    try:
        import nightshift_bookkeeping_release as bk
    except (ImportError, OSError, SyntaxError):
        out({"ok": False, "error": "bookkeeping_plan_denied",
             "reason": "bundle_identity_unproved"}, 3)
    try:
        plan = bk.build_bookkeeping_plan(
            cx, args.task, args.repo, args.head_sha, main_sha=args.main_sha)
    except bk.BookkeepingDenied as exc:
        out({"ok": False, "error": "bookkeeping_plan_denied",
             "reason": exc.reason, "classification": "normal"}, 3)
    print(bk.canonical_json(plan))


def cmd_bookkeeping_verify_head(cx, args):
    """The cheap, git-free re-check `release` runs immediately before
    cutover (AC-6): the head it is about to merge must be byte-identical to
    the head `bookkeeping plan` classified. No control-plane access needed,
    so this is wired as a plane-free verb (PLANE_FREE_VERBS)."""
    import nightshift_bookkeeping_release as bk
    ok, reason = bk.check_head_identity(args.expected_head_sha, args.actual_head_sha)
    if not ok:
        out({"ok": False, "error": "bookkeeping_verify_denied", "reason": reason}, 3)
    out({"ok": True})


def cmd_bookkeeping_receipt_record(cx, args):
    """Persist one exact-SHA fast-path verdict (AC-4). Append-only: every
    call inserts a new row, never updates one, so the receipt table is
    itself its own audit trail of every classify-then-merge attempt."""
    import nightshift_bookkeeping_release as bk
    if not bk.FULL_OID.fullmatch(args.head_sha or ""):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "head_sha_invalid"}, 3)
    if not bk.FULL_OID.fullmatch(args.base_sha or ""):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "base_sha_invalid"}, 3)
    if args.classification not in ("bookkeeping-only", "normal"):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "classification_invalid"}, 3)
    if args.verdict not in ("pass", "fail"):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "verdict_invalid"}, 3)
    if args.merged_sha is not None and not bk.FULL_OID.fullmatch(args.merged_sha):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "merged_sha_invalid"}, 3)
    try:
        reasons = json.loads(args.reasons_json) if args.reasons_json else []
        if not isinstance(reasons, list):
            raise ValueError
    except (ValueError, TypeError):
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "reasons_not_json_list"}, 3)
    begin(cx)
    task = cx.execute("SELECT id FROM tasks WHERE id=?", (args.task,)).fetchone()
    if task is None:
        cx.execute("ROLLBACK")
        out({"ok": False, "error": "bookkeeping_receipt_denied",
             "reason": "task_missing"}, 3)
    t = now()
    cx.execute(
        "INSERT INTO bookkeeping_receipts(task_id,base_sha,head_sha,"
        "classification,verdict,reasons,merged_sha,recorded_by,recorded_at)"
        " VALUES(?,?,?,?,?,?,?,?,?)",
        (args.task, args.base_sha, args.head_sha, args.classification,
         args.verdict, json.dumps(reasons, sort_keys=True), args.merged_sha,
         args.recorded_by, t))
    cx.execute("COMMIT")
    out({"ok": True, "task_id": args.task, "head_sha": args.head_sha,
         "verdict": args.verdict, "merged_sha": args.merged_sha})


def is_bookkeeping_plan(args):
    return (args.group, getattr(args, "cmd", None)) == ("bookkeeping", "plan")


# ------------------------------------------------------------------ main ---

def main(argv=None):
    p = argparse.ArgumentParser(prog="nightshift-ctl", description=__doc__.splitlines()[0])
    # Resolved AFTER parsing (ADR-0005 D1) so "the user passed --db" stays
    # distinguishable from "we discovered it".
    p.add_argument("--db", default=None,
                   help="path to control.db (default: discovered upward from "
                        "CWD, or $NIGHTSHIFT_CTL_DB)")
    p.add_argument("--now", type=float, default=None,
                   help="override the clock, epoch seconds. Test seam -- see "
                        "ADR-0005 D4. Argv only: there is deliberately no "
                        "environment channel for this.")
    p.add_argument("--capacity", default=None,
                   help="path to capacity.json (default: alongside the db)")
    sub = p.add_subparsers(dest="group", required=True)

    init_p = sub.add_parser("init", help="create the database and schema")
    init_p.set_defaults(func=lambda cx, a: out({"ok": True, "db": a.db}))

    slot = sub.add_parser("slot").add_subparsers(dest="cmd", required=True)
    q = slot.add_parser("acquire")
    q.add_argument("--holder", required=True)
    q.add_argument("--crew")
    q.add_argument("--task")
    q.add_argument("--agent")
    q.add_argument("--title")
    q.add_argument("--purpose")
    q.add_argument("--claim-id", type=int)
    q.add_argument("--claim-generation", type=int)
    q.add_argument("--claim-run-id")
    q.add_argument("--oncall", action="store_true")
    # ADR-0044 §3b — required only when --oncall is set; never argv for the
    # token itself (matches --authority-token-stdin's own rule).
    q.add_argument("--authority-generation", type=int)
    q.add_argument("--authority-token-stdin", action="store_true",
                   help="read the Program authority token from stdin "
                        "(never argv) — required with --oncall")
    q.add_argument("--ttl", type=float)
    # ADR-0084 (#165). NOT dest="repository_id": that dest is
    # `authority_client_gate`'s own trigger for the FULL authority-epoch
    # check on `memory */project show`, and this flag must not silently
    # turn that check on for every `slot acquire` call.
    q.add_argument("--repository-id", type=int, dest="scope_repository_id",
                   help="explicit repository scope (ADR-0084); refused if "
                        "it disagrees with --task's own scope")
    q.set_defaults(func=cmd_slot_acquire)
    q = slot.add_parser("release")
    q.add_argument("--slot", type=int)
    # ADR-0068 (closes #503/F-1) — required, not optional: an optional
    # identity argument is a check that defaults to off (ADR-0002 §4a).
    q.add_argument("--holder", required=True,
                   help="the slot's holder, as <crew>/<agent> or <agent>")
    q.add_argument("--task")
    q.set_defaults(func=cmd_slot_release)
    q = slot.add_parser("heartbeat")
    q.add_argument("--slot", type=int, required=True)
    # ADR-0002 §4a — renewal proves identity. Required, not optional: an
    # optional identity argument is a check that defaults to off.
    q.add_argument("--holder", required=True,
                   help="the slot's holder, as <crew>/<agent> or <agent>")
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_slot_heartbeat)
    q = slot.add_parser("consume")
    q.add_argument("--slot", type=int, required=True)
    q.add_argument("--agent", required=True)
    q.add_argument("--title")
    q.set_defaults(func=cmd_slot_consume)
    q = slot.add_parser("renew-active")
    q.add_argument("--ttl", type=float)
    q.add_argument("--max-age", type=float, default=86400)
    q.set_defaults(func=cmd_slot_renew_active)
    q = slot.add_parser("list")
    q.set_defaults(func=cmd_slot_list)

    claim = sub.add_parser("claim").add_subparsers(dest="cmd", required=True)
    q = claim.add_parser("acquire")
    q.add_argument("--task", required=True)
    q.add_argument("--claimant", required=True)
    q.add_argument("--agent")
    q.add_argument("--title")
    q.add_argument("--session")
    q.add_argument("--worktree")
    q.add_argument("--reason")
    # ADR-0044 §3b — required only when --claimant program; never argv for
    # the token itself (matches --authority-token-stdin's own rule).
    q.add_argument("--authority-generation", type=int)
    q.add_argument("--authority-token-stdin", action="store_true",
                   help="read the Program authority token from stdin "
                        "(never argv) — required with --claimant program")
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_claim_acquire)
    q = claim.add_parser("release")
    q.add_argument("--task", required=True)
    # ADR-0068 (closes #508 D07/RT-19) — required, mirrors lease/slot --holder.
    q.add_argument("--claimant", required=True)
    q.set_defaults(func=cmd_claim_release)
    q = claim.add_parser("renew")
    q.add_argument("--task", required=True)
    q.add_argument("--claimant", required=True)
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_claim_renew)
    q = claim.add_parser("show")
    q.add_argument("--task", required=True)
    q.set_defaults(func=cmd_claim_show)

    lease = sub.add_parser("lease").add_subparsers(dest="cmd", required=True)
    q = lease.add_parser("acquire")
    q.add_argument("--resource", required=True)
    q.add_argument("--holder", required=True)
    q.add_argument("--task")
    q.add_argument("--mode", choices=("edit", "serialize"), default="edit")
    q.add_argument("--note")
    q.add_argument("--ttl", type=float)
    q.add_argument("--repository-id", type=int, dest="scope_repository_id",
                   help="explicit repository scope (ADR-0084); refused if "
                        "it disagrees with --task's own scope")
    q.set_defaults(func=cmd_lease_acquire)
    q = lease.add_parser("release")
    q.add_argument("--resource", required=True)
    # ADR-0068 (closes #503/F-1) — required, mirrors slot release --holder.
    q.add_argument("--holder", required=True)
    q.add_argument("--event", required=True,
                   choices=("pr-opened", "pr-merged", "dropped", "manual"))
    q.add_argument("--repository-id", type=int, dest="scope_repository_id")
    q.set_defaults(func=cmd_lease_release)
    q = lease.add_parser("break")
    q.add_argument("--resource", required=True)
    q.add_argument("--reason", required=True)
    q.add_argument("--repository-id", type=int, dest="scope_repository_id")
    q.set_defaults(func=cmd_lease_break)
    q = lease.add_parser("list")
    q.add_argument("--repository-id", type=int, dest="scope_repository_id")
    q.set_defaults(func=cmd_lease_list)

    authority = sub.add_parser("authority").add_subparsers(dest="cmd", required=True)
    q = authority.add_parser("acquire")
    q.add_argument("--holder-label", required=True,
                   help="diagnostic only, never authenticating (#118)")
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_authority_acquire)
    q = authority.add_parser("renew")
    q.add_argument("--generation", type=int, required=True)
    q.add_argument("--token-stdin", action="store_true",
                   help="read the authority token from stdin (never argv)")
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_authority_renew)
    q = authority.add_parser("release")
    q.add_argument("--generation", type=int, required=True)
    q.add_argument("--token-stdin", action="store_true")
    q.set_defaults(func=cmd_authority_release)
    q = authority.add_parser("permit-dispatch")
    q.add_argument("--generation", type=int, required=True)
    q.add_argument("--digest",
                   help="SHA-256 hex digest of the exact canonicalized call. "
                        "Mints blind: the permit cannot dispatch a review "
                        "seat, because this form never says which seat it is "
                        "(issue #720)")
    q.add_argument("--tool", default="sys_session_send",
                   choices=("sys_session_send", "sys_session_create"))
    q.add_argument("--agent",
                   help="the seat being dispatched; with --tool/--title/"
                        "--args-json this mints for that exact call and "
                        "applies the review-plan gate")
    q.add_argument("--title", default="")
    q.add_argument("--args-json")
    q.add_argument("--task", help="task the review is against (gated seats)")
    q.add_argument("--repo", help="target repository path (gated seats)")
    q.add_argument("--head-sha", help="full 40-hex head (gated seats)")
    q.add_argument("--not-a-review", metavar="REASON",
                   help="declare that this dispatch to a review seat is not a "
                        "review (design input before a crew is chartered, a "
                        "blind architecture draft). Recorded and countable")
    q.add_argument("--token-stdin", action="store_true")
    q.add_argument("--ttl", type=float)
    q.set_defaults(func=cmd_authority_permit_dispatch)
    q = authority.add_parser("show")
    q.set_defaults(func=cmd_authority_show)
    q = authority.add_parser("digest")
    q.add_argument("--tool", required=True,
                   choices=("sys_session_send", "sys_session_create"))
    q.add_argument("--agent", required=True)
    q.add_argument("--title")
    q.add_argument("--args-json", default="{}",
                   help="JSON object matching the dispatch call's own "
                        "args, e.g. '{\"input\":...,\"purpose\":\"implement\"}'")
    q.set_defaults(func=cmd_authority_digest)

    seq = sub.add_parser("seq").add_subparsers(dest="cmd", required=True)
    q = seq.add_parser("next")
    q.add_argument("--name", required=True)
    q.add_argument("--start", type=int, default=1)
    q.add_argument("--resource", help="require an active lease on this resource")
    q.add_argument("--holder", help="…held by this holder")
    q.add_argument("--repository-id", type=int, dest="scope_repository_id",
                   help="scope the --resource lease gate to this repository "
                        "(ADR-0084); no effect without --resource")
    q.set_defaults(func=cmd_seq_next)
    q = seq.add_parser("set")
    q.add_argument("--name", required=True)
    q.add_argument("--next", type=int, required=True)
    q.add_argument("--resource", help="require an active lease on this resource")
    q.add_argument("--holder", help="…held by this holder")
    q.add_argument("--allow-rewind", action="store_true",
                   help="permit LOWERING an existing counter (#619/ADR-0089). "
                        "Creating and raising never need this; rewinding "
                        "reissues numbers that are already in use")
    q.set_defaults(func=cmd_seq_set)

    ck = sub.add_parser("checkpoint").add_subparsers(dest="cmd", required=True)
    q = ck.add_parser("create")
    q.add_argument("--sha")
    q.add_argument("--repo", default=".")
    q.add_argument("--wave")
    q.add_argument("--ref", required=True,
                   help="branch/ref the sha must be verifiably contained in "
                        "(git merge-base --is-ancestor) -- required, #80")
    q.add_argument("--note")
    q.add_argument("--allow-dirty", action="store_true")
    q.set_defaults(func=cmd_checkpoint_create)
    q = ck.add_parser("latest")
    q.add_argument("--wave")
    q.set_defaults(func=cmd_checkpoint_latest)

    task = sub.add_parser("task").add_subparsers(dest="cmd", required=True)
    q = task.add_parser("upsert")
    q.add_argument("--id", required=True)
    for f in TASK_FIELDS:
        if f == "issue":
            q.add_argument("--issue", type=int)
        elif f == "size":
            q.add_argument("--size", choices=("S", "M", "L"))
        elif f == "budget_seconds":
            q.add_argument("--budget-seconds", type=float, dest=f)
        else:
            q.add_argument("--" + f.replace("_", "-"), dest=f)
    # Issue #488 / ADR-0068 addendum -- opt-in, off by default (byte-for-byte
    # unchanged behaviour when omitted, AC1).
    q.add_argument("--seed-shared-admission", action="store_true",
                    default=False, dest="seed_shared_admission",
                    help="Write the missing task_admissions row for an "
                         "already-existing, already-building shared-function "
                         "(product/staff/platform/security/release) task, so "
                         "a reviewer_*/beta_reviewer_* continuation slot can "
                         "be classified against it. Refused for "
                         "crew_alpha/crew_beta tasks and for tasks not yet "
                         "building/ready/fixing.")
    # ADR-0084 (#165): NOT looped in with TASK_FIELDS above -- a field with
    # an at-most-once write invariant (set on INSERT, refused on a
    # disagreeing UPDATE) is unenforceable if the generic `fields`
    # whitelist can also reach it, same reasoning ADR-0043/ADR-0046 give
    # for started_at/extension_seconds.
    q.add_argument("--repository-id", type=int, dest="scope_repository_id",
                   help="explicit repository scope (ADR-0084); stamped on "
                        "a NEW task, immutable on an existing one")
    q.set_defaults(func=cmd_task_upsert)
    q = task.add_parser("show")
    q.add_argument("--id", required=True)
    q.set_defaults(func=cmd_task_show)
    q = task.add_parser("list")
    q.add_argument("--issue", type=int)
    q.add_argument("--crew")
    q.add_argument("--repository-id", type=int, dest="scope_repository_id")
    q.set_defaults(func=cmd_task_list)
    q = task.add_parser("ready")
