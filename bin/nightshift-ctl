#!/usr/bin/env python3
"""nightshift-ctl — the deterministic control plane for the Omnigent crew org.

LLMs decide what SHOULD happen; this tool decides what is ALLOWED to happen;
agents execute. It owns exactly the state that needs concurrency correctness:

    worker_slots   one global semaphore (with an on-call reserve)
    task_claims    at most one active claim per task (heartbeat/recovery races)
    leases         one holder per shared resource (edit vs serialize modes)
    sequences      atomic allocation (migration numbers)
    checkpoints    the base SHA a build wave fans out from
    agent_runs     which worker session is on which slot/task
    vendors        rate-limit cooldowns with doubling backoff
    scheduled_run_detector_state / scheduled_run_observations
                   normalized scheduler-SLO observations and delivery state

Everything narrative (ADRs, specs, handoffs, reports, registries) stays in
files in the repo. Where both exist, THIS database is authoritative for
"who holds what right now"; the files are the readable projection. The
configured numbers (max workers, reserve) stay in .omni/capacity.json —
human-editable — and are read inside every transaction.

Design notes:
- SQLite in WAL mode, every mutation inside BEGIN IMMEDIATE: two concurrent
  invocations serialize at the database, not at a prompt.
- Expiry is lazy AND explicit: every mutating command first expires stale
  rows inside its own transaction, so a crashed holder's slot/claim/lease
  frees itself the moment anyone else asks — no reaper daemon required.
  `nightshift-ctl reap` does the same on demand, for visibility.
- Exit codes: 0 granted/ok · 3 denied/held/cooling · 2 usage · 1 error.
  Output is always one JSON object on stdout.

stdlib only (python3 + sqlite3). No third-party deps, no build step.
"""

import argparse
import hashlib
import fnmatch
import json
import math
import os
import re
import secrets
import shlex
import sqlite3
import stat
import subprocess
import sys
import time
import urllib.parse

# ADR-0005 D1/D2 -- the control plane is DISCOVERED, never invented.
#
# This used to be the default value of --db, resolved against the process CWD,
# and `connect()` created whatever it named. From the wrong directory the tool
# therefore manufactured an empty control plane and answered questions about it:
# `slot acquire` granted (defect 6 through a side door), `claim acquire` granted
# (defect 7), `lease acquire` granted, `slot release` reported {"released": 0}.
# It never errored -- it answered, confidently and wrongly. See issue #31.
DEFAULT_DB_RELPATH = os.path.join(".omni", "control.db")
DEFAULT_DB = DEFAULT_DB_RELPATH  # back-compat alias; no longer a default VALUE


# Commands that never read or write the control plane (verified: neither
# cmd_pr_lint nor cmd_pr_create references `cx`; cmd_pr_head only reads GitHub
# API and never touches the database; cmd_spec_status only reads /proc and
# runs read-only git). `spec status` in particular must run from anywhere a
# driver happens to be standing -- including a checkout with no plane at
# all, which is exactly the situation it exists to describe.
#
# `memory` (#400) joins this group-level set, not PLANE_FREE_VERBS below.
# ADR-0020's own reasoning for verb-granularity is the ASYMMETRIC-sibling
# shape: `project bind`/`show` are plane-free while a later `project`
# lifecycle verb is not, so a bare group entry would let that later verb
# silently inherit an exemption it never earned. `memory` has no such
# sibling -- bootstrap/sync/search/verify/purge/coverage are ALL plane-free
# by construction, because memory.db is a physically separate file from
# control.db (PLAN-400's advisory boundary: no shared connection, so no
# transaction can span a memory read and a control grant). That is exactly
# the shape `spec`/`hook`/`pr-lint` already model here, not the shape
# `project`/`bookkeeping`/`heartbeat-persist` model below. This addition
# does trip the "migrate the older set" comment on PLANE_FREE_VERBS below
# in the literal sense of "another whole group was added" -- but migrating
# `pr-lint`/`pr-create`/`pr-head`/`spec`/`guard-commit`/`hook` into
# verb-granular form is an unrelated, unrequested refactor of five
# unrelated command groups with no asymmetric-sibling problem to fix, so
# it is deliberately left undone here rather than folded into a memory-CLI
# change. If a future memory verb ever needs the plane, THAT verb is the
# real trigger for moving `memory` to PLANE_FREE_VERBS, same as ADR-0020's
# own precedent.
PLANE_FREE_COMMANDS = frozenset({"pr-lint", "pr-create", "pr-head", "spec",
                                 "guard-commit", "hook", "memory"})
# ADR-0020 keeps this second set deliberately verb-granular: future project
# lifecycle verbs must use the plane.  Migrate the older group-level set when
# another whole group is added there, or when one of its groups gains a
# plane-requiring verb; until that trigger, changing every old exemption would
# broaden this bounded feature.
PLANE_FREE_VERBS = frozenset({
    ("project", "bind"), ("project", "show"),
    # Issue #286 / ADR-0052: a pure comparison of two caller-supplied SHAs,
    # no task lookup, no Git, no control.db -- verb-granular because its own
    # sibling verbs (`bookkeeping plan`, `bookkeeping receipt-record`) DO use
    # the plane, exactly the shape ADR-0020 reserves this set for.
    ("bookkeeping", "verify-head"),
    # Issue #390: `heartbeat-persist decide` is the pure decision function
    # exposed as a CLI wrapper -- no control.db read or write, ever. Its
    # sibling `heartbeat-persist record` DOES use the plane (it persists the
    # AC-13 telemetry row), exactly the same asymmetric-sibling shape as
    # `bookkeeping plan` vs `bookkeeping verify-head` above.
    ("heartbeat-persist", "decide"),
})


class ControlPlaneMissing(FileNotFoundError):
    """No control plane exists at the resolved path.

    Subclasses FileNotFoundError (hence OSError) ON PURPOSE: main() already
    routes OSError through `beat_show_verdict_on_unreadable`, the narrow
    interception `security` cleared at 8cd0f88. A missing plane is exactly the
    condition that interception exists for -- nothing can attest the Program
    ran -- so it must reach the SAME code path rather than a parallel one.
    """

    def __init__(self, path, searched_from=None):
        super().__init__(f"no control plane at {path}")
        self.path = path
        self.searched_from = searched_from


def discover_control_plane(start=None):
    """Walk up from `start` (default: CWD) for an EXISTING .omni/control.db.

    Stops at the repo root -- a directory holding `.git`, which is a directory
    in a normal clone and a FILE in a git worktree. That bound is the point:
    without it, discovery from /tmp/x would happily adopt /tmp/.omni, which is
    the same class of bug as the one being fixed. Returns None if nothing is
    found; the caller decides whether that is fatal.
    """
    d = os.path.abspath(start or os.getcwd())
    while True:
        candidate = os.path.join(d, DEFAULT_DB_RELPATH)
        if os.path.isfile(candidate):
            return candidate
        dot_git = os.path.join(d, ".git")
        if os.path.isdir(dot_git):
            return None  # repo root: do not escape it
        if os.path.isfile(dot_git):
            # A git WORKTREE. Its `.git` is a file pointing at the main repo's
            # admin dir. A worktree is the same project, so it shares the one
            # control plane -- and without this, an engineer running ctl from
            # their worktree would get `control_plane_missing` and a hint
            # suggesting `init`, i.e. this defect's own advice on how to
            # recreate it. Follow the pointer instead of guessing.
            main = _main_worktree_root(dot_git)
            if main:
                candidate = os.path.join(main, DEFAULT_DB_RELPATH)
                if os.path.isfile(candidate):
                    return candidate
            return None
        parent = os.path.dirname(d)
        if parent == d:
            return None  # filesystem root
        d = parent


def _main_worktree_root(dot_git_file):
    """Given a worktree's `.git` FILE, return the main worktree's root."""
    try:
        with open(dot_git_file) as f:
            line = f.read().strip()
    except OSError:
        return None
    if not line.startswith("gitdir:"):
        return None
    gitdir = line.split(":", 1)[1].strip()
    if not os.path.isabs(gitdir):
        gitdir = os.path.join(os.path.dirname(dot_git_file), gitdir)
    gitdir = os.path.abspath(gitdir)
    # git writes `commondir` inside the per-worktree admin dir; it is the
    # authoritative pointer back to the shared .git. Fall back to the layout
    # convention (.git/worktrees/<name>) only if it is absent.
    commondir = os.path.join(gitdir, "commondir")
    if os.path.isfile(commondir):
        try:
            with open(commondir) as f:
                common = f.read().strip()
            common = common if os.path.isabs(common) else os.path.join(gitdir, common)
            return os.path.dirname(os.path.abspath(common))
        except OSError:
            pass
    if os.path.basename(os.path.dirname(gitdir)) == "worktrees":
        return os.path.dirname(os.path.dirname(os.path.dirname(gitdir)))
    return None


def resolve_db_path(explicit):
    """Return (path, source). Precedence: --db > NIGHTSHIFT_CTL_DB > discovery.

    "unresolved" means discovery found nothing. The path returned in that case
    is only ever used to NAME the failure -- it is never created.
    """
    if explicit:
        return os.path.abspath(explicit), "flag"
    env = os.environ.get("NIGHTSHIFT_CTL_DB")
    if env:
        return os.path.abspath(env), "env"
    found = discover_control_plane()
    if found:
        return found, "discovered"
    return os.path.abspath(os.path.join(os.getcwd(), DEFAULT_DB_RELPATH)), "unresolved"

CAP_DEFAULTS = {
    "max_concurrent_workers": 5,
    "reserve_for_oncall": 1,
    "slot_ttl_seconds": 14400,   # 4h — a long turn is not a hung turn
    "claim_ttl_seconds": 3600,   # 1h — a recovery claim nobody acted on
    "lease_ttl_seconds": 86400,  # 24h — edit leases only; serialize never expires
    # ADR-0044 §2/Implementation notes: at-most-one-Program-authority fence.
    "authority_ttl_seconds": 1800,        # 30m, renewed before each permit
    "authority_permit_ttl_seconds": 60,   # 60s one-shot dispatch permit window
    # ADR-0002 §3: how old a Program heartbeat may be and still read alive.
    "heartbeat_max_age_seconds": 900,
    # tolerance for clock skew before a heartbeat is "in the future"
    "heartbeat_future_skew_seconds": 60,
}

TASK_FIELDS = ("crew", "agent", "title", "issue", "state", "base_sha",
               "spec_ref", "worktree", "branch", "pr_url", "size",
               "budget_seconds", "paths")
TASK_ROW_FIELDS = ("id",) + TASK_FIELDS + ("created_at", "updated_at")

# Static bundle roster shared with the root policy.  Keeping it in this
# self-contained controller preserves nightshift_publish's attested
# ``python -I -`` execution while giving allocation and policy one authority.
COUNTED_AGENTS = {
    "eng_claude": ("crew_alpha", "engineer"),
    "eng_codex": ("crew_alpha", "engineer"),
    "qa": ("crew_alpha", "qa"),
    "reviewer_claude": ("crew_alpha", "reviewer"),
    "reviewer_codex": ("crew_alpha", "reviewer"),
    "beta_eng_claude": ("crew_beta", "engineer"),
    "beta_eng_codex": ("crew_beta", "engineer"),
    "beta_qa": ("crew_beta", "qa"),
    "beta_reviewer_claude": ("crew_beta", "reviewer"),
    "beta_reviewer_codex": ("crew_beta", "reviewer"),
}
EXEMPT_AGENTS = frozenset({
    "product", "architect", "crew_alpha", "crew_beta", "pm", "beta_pm",
    "ux", "staff", "platform", "security", "release",
})
ONCALL_AGENTS = frozenset({"oncall"})
# Issue #488 / ADR-0068 addendum: shared-function seats whose charter path is
# `nightshift-ctl task upsert` (never a genuine counted `eng_*` NEW dispatch,
# since none of these names is a COUNTED_AGENTS key) and therefore never earn
# a real `task_admissions` row through worker_semaphore's phase=='new' branch.
# Deliberately excludes crew_alpha/crew_beta: their real deliverable tasks
# DO have a genuine engineer, and must keep going through real dispatch-time
# admission -- `task upsert --seed-shared-admission` refuses them outright
# (see cmd_task_upsert), never silently no-ops.
SHARED_FUNCTION_CREWS = frozenset({
    "product", "staff", "platform", "security", "release",
})


def seat_identity(seat):
    """Return the deterministic repo-local git identity for a trusted seat."""
    return seat, "%s@nightshift.seats.invalid" % seat


SCHEMA = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS tasks(
  id TEXT PRIMARY KEY,
  crew TEXT, agent TEXT, title TEXT, issue INTEGER,
  state TEXT NOT NULL DEFAULT 'pending',
  base_sha TEXT, spec_ref TEXT, worktree TEXT, branch TEXT, pr_url TEXT,
  size TEXT CHECK(size IN ('S','M','L')),
  created_at REAL NOT NULL, updated_at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS task_dependencies(
  task_id TEXT NOT NULL,
  depends_on_task_id TEXT NOT NULL,
  PRIMARY KEY(task_id, depends_on_task_id),
  CHECK(task_id <> depends_on_task_id));
-- generation/run_id on task_claims and worker_slots are ADR-0002 §5 fencing:
-- recorded now, ENFORCED in M3 (DoD conditions 6 and 7). Kept out of the
-- table body on purpose: SQLite re-parses the stored CREATE TABLE text on
-- ALTER TABLE ... DROP COLUMN, and a trailing in-body comment makes the last
-- column undroppable.
CREATE TABLE IF NOT EXISTS task_claims(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT NOT NULL,
  claimant TEXT NOT NULL,
  agent TEXT, title TEXT, session_id TEXT, worktree TEXT, reason TEXT,
  state TEXT NOT NULL DEFAULT 'active',
  acquired_at REAL NOT NULL, expires_at REAL, released_at REAL,
  generation INTEGER NOT NULL DEFAULT 0, run_id TEXT);
CREATE UNIQUE INDEX IF NOT EXISTS one_active_claim
  ON task_claims(task_id) WHERE state='active';
CREATE TABLE IF NOT EXISTS worker_slots(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  holder TEXT NOT NULL, crew TEXT, task_id TEXT,
  kind TEXT NOT NULL DEFAULT 'normal',
  state TEXT NOT NULL DEFAULT 'active',
  acquired_at REAL NOT NULL, expires_at REAL, released_at REAL,
  -- one-dispatch capability: set atomically on first (and only) dispatch
  dispatched_at REAL, bound_agent TEXT, bound_title TEXT,
  phase TEXT CHECK(phase IN ('planning','new','continuation')),
  expected_agent TEXT, expected_title TEXT, expected_purpose TEXT,
  continuation_kind TEXT CHECK(continuation_kind IN ('qa','review','implementer')),
  claim_id INTEGER,
  generation INTEGER NOT NULL DEFAULT 0, run_id TEXT);
CREATE TABLE IF NOT EXISTS task_admissions(
  task_id TEXT PRIMARY KEY,
  new_slot_id INTEGER NOT NULL UNIQUE,
  crew TEXT NOT NULL, agent TEXT NOT NULL, title TEXT NOT NULL,
  admitted_at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS leases(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  resource TEXT NOT NULL,
  mode TEXT NOT NULL DEFAULT 'edit',
  holder TEXT NOT NULL, task_id TEXT, note TEXT,
  state TEXT NOT NULL DEFAULT 'active',
  acquired_at REAL NOT NULL, expires_at REAL, released_at REAL);
-- Issue #165/ADR-0084: the pre-165 `one_active_lease ON leases(resource)`
-- index used to live here. It is REMOVED from SCHEMA on purpose (not just
-- dropped in a migration): `ensure_schema` runs `executescript(SCHEMA)`
-- unconditionally on every invocation, so a bare `CREATE UNIQUE INDEX IF
-- NOT EXISTS` left in this string would recreate the exact narrow index
-- the migration below drops, every single call. The repository-scoped
-- replacement (`one_active_lease_per_repository`) is created further down
-- in `ensure_schema`, in the same guarded, additive style as
-- `one_active_new_reservation` and its siblings below.
CREATE TABLE IF NOT EXISTS sequences(name TEXT PRIMARY KEY, next INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS checkpoints(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  wave TEXT, sha TEXT NOT NULL, ref TEXT, note TEXT, created_at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS agent_runs(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  agent TEXT NOT NULL, title TEXT, session_id TEXT,
  slot_id INTEGER, task_id TEXT,
  state TEXT NOT NULL DEFAULT 'running',
  started_at REAL NOT NULL, ended_at REAL);
CREATE TABLE IF NOT EXISTS vendors(
  name TEXT PRIMARY KEY,
  cooldown_until REAL, consecutive_limits INTEGER NOT NULL DEFAULT 0,
  updated_at REAL);
CREATE TABLE IF NOT EXISTS scheduled_run_detector_state(
  task_id TEXT PRIMARY KEY,
  last_run_scheduled_at INTEGER,
  next_expected_at INTEGER,
  current_observation_key TEXT,
  consecutive_failures INTEGER NOT NULL DEFAULT 0,
  updated_at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS scheduled_run_observations(
  observation_key TEXT PRIMARY KEY,
  task_id TEXT NOT NULL,
  run_id TEXT,
  scheduled_at INTEGER NOT NULL,
  conversation_id TEXT,
  status TEXT NOT NULL,
  failure_class TEXT NOT NULL,
  consecutive_failures INTEGER NOT NULL,
  observed_at REAL NOT NULL,
  alerted_at REAL);
CREATE INDEX IF NOT EXISTS scheduled_run_observations_by_task
  ON scheduled_run_observations(task_id, scheduled_at);
-- ADR-0039 / issue #231 -- migration sequence 1 (allocated under the
-- bin/nightshift-ctl serialize lease). Additive only: three new tables, no
-- change to any existing table. See bin/nightshift_review_receipts.py.
CREATE TABLE IF NOT EXISTS review_receipts(
  task_id TEXT NOT NULL,
  head_sha TEXT NOT NULL,
  domain TEXT NOT NULL CHECK(domain IN (
    'pm_acceptance','code_review','qa','cross_crew_review','staff_adr',
    'security','ux')),
  verdict TEXT NOT NULL CHECK(verdict IN ('pass','fail')),
  pr_url TEXT NOT NULL,
  comment_url TEXT NOT NULL,
  marker TEXT NOT NULL,
  report_digest TEXT NOT NULL,
  comment_created_at TEXT NOT NULL,
  validated_at REAL NOT NULL,
  created_at REAL NOT NULL,
  PRIMARY KEY(task_id, head_sha, domain));
CREATE TABLE IF NOT EXISTS review_findings(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT NOT NULL,
  head_sha TEXT NOT NULL,
  domain TEXT NOT NULL,
  severity TEXT NOT NULL CHECK(severity IN (
    'MERGE_BLOCKER','PRE_DEPLOYMENT','FOLLOW_UP')),
  fingerprint TEXT NOT NULL,
  criterion TEXT,
  summary TEXT NOT NULL,
  created_at REAL NOT NULL);
CREATE INDEX IF NOT EXISTS review_findings_by_task_head
  ON review_findings(task_id, head_sha);
CREATE INDEX IF NOT EXISTS review_findings_by_fingerprint
  ON review_findings(fingerprint);
CREATE TABLE IF NOT EXISTS review_dispatch_markers(
  task_id TEXT NOT NULL,
  head_sha TEXT NOT NULL,
  domain TEXT NOT NULL,
  marker TEXT NOT NULL,
  minted_at REAL NOT NULL,
  PRIMARY KEY(task_id, head_sha, domain));
-- ADR-0044 §1 — at most one Program-role session may act. Additive only,
-- nothing existing altered. One row per generation (same active-row-lock
-- shape as one_active_claim/one_active_lease above); a generation that
-- transitions to 'released' or 'expired' can never become 'active' again
-- (no ABA — AC-6), because acquire always INSERTs the next generation
-- rather than reusing a row.
CREATE TABLE IF NOT EXISTS program_authority(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  generation INTEGER NOT NULL,
  token_hash TEXT NOT NULL,
  holder_label TEXT NOT NULL,
  acquired_at REAL NOT NULL,
  renewed_at REAL,
  expires_at REAL NOT NULL,
  released_at REAL,
  state TEXT NOT NULL DEFAULT 'active' CHECK(state IN ('active','released','expired')));
CREATE UNIQUE INDEX IF NOT EXISTS one_active_program_authority
  ON program_authority(state) WHERE state='active';
-- One-use, short-TTL permit for the exact call about to be made. digest is
-- the SHA-256 of a canonicalized {tool,agent,title,args} (ROOT-policy
-- consumer) or of a canonicalized CLI invocation (nightshift-ctl-internal
-- consumer) — both defined and consumed by their own call sites, not here.
CREATE TABLE IF NOT EXISTS program_action_permits(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  generation INTEGER NOT NULL,
  action_digest TEXT NOT NULL,
  expires_at REAL NOT NULL,
  consumed_at REAL,
  -- Issue #720 / ADR-0091. NULL means "minted blind" -- the caller handed a
  -- bare `--digest` and this file never learned which seat the permit
  -- authorises. A gated review seat REFUSES to consume a NULL-gate permit,
  -- which is what stops the blind path being a way around the mint gate.
  review_gate TEXT);
CREATE INDEX IF NOT EXISTS program_action_permits_lookup
  ON program_action_permits(action_digest, generation) WHERE consumed_at IS NULL;
-- Issue #286 / ADR-0052 -- migration sequence 3 (allocated under the
-- bin/nightshift-ctl serialize lease). Additive only: one new table, no
-- change to any existing table. See bin/nightshift_bookkeeping_release.py.
-- `release`'s exact-SHA proof of the merged bookkeeping-only PR (AC-4):
-- one append-only row per classify-then-merge attempt, never updated.
CREATE TABLE IF NOT EXISTS bookkeeping_receipts(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT NOT NULL,
  base_sha TEXT NOT NULL,
  head_sha TEXT NOT NULL,
  classification TEXT NOT NULL CHECK(classification IN (
    'bookkeeping-only','normal')),
  verdict TEXT NOT NULL CHECK(verdict IN ('pass','fail')),
  reasons TEXT NOT NULL,
  merged_sha TEXT,
  recorded_by TEXT NOT NULL,
  recorded_at REAL NOT NULL);
CREATE INDEX IF NOT EXISTS bookkeeping_receipts_by_task
  ON bookkeeping_receipts(task_id, head_sha);
-- Issue #390 -- migration sequence 4 (allocated under the bin/nightshift-ctl
-- serialize lease). Additive only: one new table, no change to any existing
-- table. See bin/nightshift_heartbeat_persistence.py.
-- Every heartbeat-persist decision -- no-op or durable-delta alike -- gets
-- exactly one append-only row here (AC-13): this table is what makes
-- "no-op heartbeat -> PR count = 0" an OBSERVABLE invariant, not a narrated
-- one. `id` doubles as the one-shot enforcement receipt
-- `pr-create --heartbeat-persist-receipt` consumes: `consumed_at` starts
-- NULL and is set exactly once by a compare-and-set UPDATE, the same
-- one-shot idiom `program_action_permits` already established (ADR-0044).
CREATE TABLE IF NOT EXISTS heartbeat_persist_decisions(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  run_id TEXT NOT NULL,
  input_digest TEXT NOT NULL,
  authority_status TEXT NOT NULL,
  observation_codes_json TEXT NOT NULL,
  durable_delta_reason_code TEXT,
  should_persist INTEGER NOT NULL CHECK(should_persist IN (0,1)),
  output_reason_code TEXT NOT NULL,
  route TEXT NOT NULL CHECK(route IN (
    'none','bookkeeping_fast_path','governed_normal_path')),
  recorded_at REAL NOT NULL,
  consumed_at REAL);
CREATE INDEX IF NOT EXISTS heartbeat_persist_decisions_by_run
  ON heartbeat_persist_decisions(run_id);
-- Issue #424 / ADR-0055 -- migration sequence 8 (allocated by
-- `seq next --name migrations` under the bin/nightshift-ctl SERIALIZE lease
-- 26, holder crew_alpha; the draft ADR predicted 5 and was wrong, which is
-- the entire reason the number is allocated rather than read off this file).
-- Additive only: one new table, no change to any existing table.
--
-- One append-only row per close ATTEMPT made through `issue close`. The row
-- is written BEFORE the GitHub write and confirmed after it: `applied_at`
-- starts NULL and is set exactly once by a compare-and-set UPDATE -- the
-- same one-shot idiom program_action_permits (ADR-0044) and
-- heartbeat_persist_decisions (#390) already established above. A crash
-- between the two leaves a visible stale intent row, which is what
-- `issue undisposed` reports; it never leaves a closed issue with no
-- disposition (ADR-0055 option C, rejected) and never leaves a phantom
-- delivery in the AC-7 report (option B, rejected).
--
-- The paired CHECKs make an incoherent row UNREPRESENTABLE rather than
-- merely discouraged: a deferred close cannot carry a superseded_by, and a
-- sensitive (P0/security) close cannot exist without evidence.
--
-- No UNIQUE index on `issue`: an issue may legitimately be reopened and
-- re-closed, and that history is the point of the table.
CREATE TABLE IF NOT EXISTS issue_close_dispositions(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  issue INTEGER NOT NULL,
  disposition TEXT NOT NULL CHECK(disposition IN (
    'delivered','superseded','deferred')),
  superseded_by INTEGER,
  deferred_to TEXT,
  evidence TEXT,
  sensitive INTEGER NOT NULL CHECK(sensitive IN (0,1)),
  -- DUPLICATE is retained in this CHECK deliberately even though the
  -- gateway cannot WRITE it: `gh issue close --reason` accepts only
  -- {completed|not planned} (gh 2.45.0, verified at build time) and the
  -- REST state_reason enum has no `duplicate` either, so the gateway
  -- refuses it as state_reason_unsupported rather than silently writing a
  -- reason that disagrees with this row. The value stays legal here because
  -- GitHub REPORTS it (12 of this repo's issues carry it, per #424's own
  -- census) and a future backfill of already-closed issues must be able to
  -- record what GitHub actually says.
  state_reason TEXT NOT NULL CHECK(state_reason IN (
    'COMPLETED','NOT_PLANNED','DUPLICATE')),
  comment_body TEXT NOT NULL,
  actor TEXT NOT NULL,
  recorded_at REAL NOT NULL,
  applied_at REAL,
  CHECK((disposition='superseded') = (superseded_by IS NOT NULL)),
  CHECK((disposition='deferred')   = (deferred_to   IS NOT NULL)),
  CHECK(sensitive=0 OR evidence IS NOT NULL));
CREATE INDEX IF NOT EXISTS issue_close_dispositions_by_actor
  ON issue_close_dispositions(actor, recorded_at);
CREATE INDEX IF NOT EXISTS issue_close_dispositions_by_issue
  ON issue_close_dispositions(issue, recorded_at);
-- Issue #720 / ADR-0091 -- migration seq 14, same allocation as the
-- program_action_permits.review_gate column below. Additive only.
--
-- Decision 3: a planner that cannot answer must never REDUCE review coverage,
-- so the permit is minted anyway and full fanout stands. But a control that
-- silently degrades to "allow everything" is the exact defect class #716
-- exists to name, so every degraded and every shadow-only mint lands here as
-- one countable row. The retro can then ask how often the gate was actually
-- deciding anything -- a question `escaped` alone cannot answer, because a
-- gate that never ran and a gate that never had to refuse both read as zero.
CREATE TABLE IF NOT EXISTS review_gate_degradations(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  recorded_at REAL NOT NULL,
  agent TEXT NOT NULL,
  domain TEXT NOT NULL,
  task_id TEXT,
  head_sha TEXT,
  repo TEXT,
  outcome TEXT NOT NULL,
  reason TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS review_gate_degradations_by_time
  ON review_gate_degradations(recorded_at);
-- Issue #474 / ADR-0063 -- migration sequence 12 (allocated by
-- `seq next --name migrations --resource 'bin/nightshift-ctl' --holder
-- crew_alpha` under crew_alpha's own self-held SERIALIZE lease 41 on this
-- file -- ADR-0063's Amendment: there is no db/migrations/** path in this
-- repo and no platform grant to acquire; the same ordinary self-serialize
-- discipline migration sequence 8 already used). Additive only: two new
-- tables, no change to any existing table.
--
-- `dod_conditions`: the last-ingested snapshot of `tests/dod_validate.py
-- --json`'s per-condition output (Issue #423-A). `dod ingest` UPSERTs this
-- BY condition_id (AC-3) -- one row per D01..D24, never appended to, so
-- re-ingesting identical input leaves the table content-identical. Created
-- EMPTY; the first `dod ingest` populates it.
CREATE TABLE IF NOT EXISTS dod_conditions(
  condition_id TEXT PRIMARY KEY,
  verdict TEXT NOT NULL CHECK(verdict IN ('PASS','FAIL','BLOCKED','MANUAL')),
  reason TEXT NOT NULL DEFAULT '',
  blocking_artifact TEXT,
  ingested_at REAL NOT NULL,
  run_id TEXT);
-- `task_dod_links`: many-to-many task-to-condition linkage (ADR-0063
-- Decision, Option C). Created EMPTY by this issue (#423-A) -- nothing
-- populates a real row here yet; that is a separate, later task per the
-- ADR's Consequences section. `on_dod_path`/`linked_conditions` (added to
-- `_task_readiness_snapshot` below, read-only, dormant) are the only
-- readers until #423-C activates admission on top of the same table.
CREATE TABLE IF NOT EXISTS task_dod_links(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT NOT NULL,
  condition_id TEXT NOT NULL,
  blocking_artifact TEXT,
  created_at REAL NOT NULL,
  UNIQUE(task_id, condition_id));
CREATE INDEX IF NOT EXISTS task_dod_links_by_task
  ON task_dod_links(task_id);
CREATE INDEX IF NOT EXISTS task_dod_links_by_condition
  ON task_dod_links(condition_id);
-- `dod_heartbeat_observations`: one row per recorded DoD heartbeat delta
-- (AC-6) -- append-only, so "the previous heartbeat's own recorded value"
-- (issue #474's own wording) is a real prior row, never an assumed
-- baseline, and "two consecutive heartbeats both delta 0" is a query over
-- the last two rows for a given run/series rather than in-memory state that
-- does not survive a restart.
CREATE TABLE IF NOT EXISTS dod_heartbeat_observations(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  observed_at REAL NOT NULL,
  pass_count INTEGER NOT NULL,
  delta INTEGER NOT NULL,
  escalated INTEGER NOT NULL CHECK(escalated IN (0,1)));
"""

# GitHub's closing keywords, incl. `owner/repo#N` forms. A task PR carrying
# one of these lets the FIRST merged PR close a backlog issue that other
# task PRs are still feeding — the exact bug pr-lint exists to stop.
CLOSING_RE = re.compile(
    r"\b(clos(?:e|es|ed)|fix(?:es|ed)?|resolv(?:e|es|ed))\b\s*:?\s+([\w./-]+)?#(\d+)",
    re.IGNORECASE,
)
REFS_RE = re.compile(r"\brefs?\b\s*:?\s+([\w./-]+)?#\d+", re.IGNORECASE)


# ADR-0005 D4 -- injectable clock. `platform` root-caused issue #32: expiry is
# lazy AND explicit, so a test that sleeps past a TTL races its own setup under
# load. Virtual time removes the race and the six real-clock sleeps with it.
# SECURITY NOTE: advancing this FORWARD makes expire_stale reap live slots,
# claims and edit leases. See ADR-0005 "New risk introduced by D4".
_NOW_OVERRIDE = None


def set_clock_override(value):
    global _NOW_OVERRIDE
    _NOW_OVERRIDE = value


def now() -> float:
    if _NOW_OVERRIDE is not None:
        return _NOW_OVERRIDE
    return time.time()


def out(obj, code=0):
    print(json.dumps(obj, sort_keys=True))
    sys.exit(code)


def is_plane_free(args):
    """Whether this exact parsed verb may run without opening control.db.

    Issue #390: `pr-create` stays plane-free for the ordinary case (AC-12,
    byte-for-byte unchanged from before this issue) -- it needs the plane on
    THIS invocation only when a `--heartbeat-persist-receipt` marker is
    actually present, because only that marker's consumption ever touches
    `cx`. Every other PLANE_FREE_COMMANDS/PLANE_FREE_VERBS entry, and every
    `pr-create` call with no such marker, is entirely unaffected.
    """
    if args.group == "pr-create" and getattr(args, "heartbeat_persist_receipt", None) is not None:
        return False
    return args.group in PLANE_FREE_COMMANDS or (args.group, getattr(args, "cmd", None)) in PLANE_FREE_VERBS


def authority_client_gate(args):
    """Refuse this invocation when the authority binding says the legacy
    control plane is no longer authoritative.

    The scope this gate can address depends on the verb:

      * `memory ...` / `project show` carry `--state-root` AND
        `--repository-id`, so the per-repository registry at
        `<state_root>/authority/<repository_id>/authority.db` is addressable
        and the FULL check runs (backend, epoch, quiesce).
      * every other verb resolves only to the directory holding control.db,
        from which no registry is addressable. The absent-registry rule
        still applies there: an `external` claim is refused and the shadow
        namespace is refused, which is the part that matters for a legacy
        client.

    Both outcomes are honest about which one happened -- the returned
    binding carries `registry: present|absent|unaddressable` -- so nothing
    downstream can mistake "not addressable from here" for "checked and
    clean".
    """
    # Importing a sibling module normally writes `bin/__pycache__/`. Every
    # other lazy import in this file suppresses that; do the same, and
    # RESTORE the flag afterwards so this gate -- which now runs on every
    # control-plane verb -- does not silently change bytecode behaviour for
    # the rest of the process.
    previous = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        import nightshift_authority as nsa
    except (ImportError, OSError, SyntaxError):
        return None
    finally:
        sys.dont_write_bytecode = previous
    state_root = getattr(args, "state_root", None)
    repository_id = getattr(args, "repository_id", None)
    path = state_root or os.path.dirname(os.path.abspath(args.db))
    try:
        return nsa.guard_connect(path, repository_id=repository_id,
                                  state_root=state_root)
    except nsa.AuthorityError as exc:
        out({"ok": False, "error": exc.reason_code, **exc.details}, 3)


class ControlPlaneUntrusted(OSError):
    """The control DB at the resolved path is not one this uid made.

    An OSError so `beat show` still turns it into a not-alive verdict."""

    def __init__(self, path, reason):
        super().__init__(f"untrusted control plane at {path}: {reason}")
        self.path = path
        self.reason = reason


CONTROL_DB_SIDECARS = ("", "-wal", "-shm", "-journal")


def check_control_db_trust(db_path):
    """Audit C9: refuse a control DB this operator did not make.

    Discovery adopts `.omni/control.db` from the checkout, so a target repo
    that TRACKS one -- or its -wal, which sqlite replays on open -- supplies
    forged slots, authority rows and triggers. Refused: any of the four
    files that git tracks, that is a symlink, that another uid owns, or that
    group/other can write. A file of ours that is merely group/other
    READABLE (every plane before this check) is tightened to 0600, which
    only removes access. Prefer an explicit `--db`/`NIGHTSHIFT_CTL_DB`.
    """
    present = []
    for suffix in CONTROL_DB_SIDECARS:
        path = db_path + suffix
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            raise ControlPlaneUntrusted(path, "is a symlink")
        if info.st_uid != os.geteuid():
            raise ControlPlaneUntrusted(path, "is owned by another user")
        if info.st_mode & 0o022:
            raise ControlPlaneUntrusted(path, "is writable by group or other")
        if info.st_mode & 0o044:
            os.chmod(path, stat.S_IMODE(info.st_mode) & 0o700)
        present.append(os.path.basename(path))
    if not present:
        return
    real_dir = os.path.dirname(os.path.realpath(db_path))
    rc, tracked, err = _git_ro(real_dir, "ls-files", "-z", "--", *present)
    if rc == 0 and tracked:
        raise ControlPlaneUntrusted(db_path, "is tracked by git -- a "
                                    "checkout supplied it")
    if rc not in (0, 127) and "not a git repository" not in err:
        raise ControlPlaneUntrusted(db_path, "cannot tell whether git "
                                    "tracks it: " + err)


def connect(db_path, create=False, readonly=False):
    """Open the control plane. Creates ONLY when explicitly told to (`init`).

    The non-creating open goes through SQLite URI mode=rw, which REFUSES to
    create the file. The isfile() check above it is for the error message, not
    for the guarantee -- resting the guarantee on a stat() would leave a
    check-then-open race that could still create a phantom plane.
    """
    if create and readonly:
        raise ValueError("a control plane cannot be created read-only")
    if create:
        os.makedirs(os.path.dirname(db_path) or ".", exist_ok=True)
        try:
            # Born 0600 (sqlite gives its -wal/-shm the same mode), so a new
            # plane never needs the tightening below.
            os.close(os.open(db_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                             | os.O_NOFOLLOW, 0o600))
        except FileExistsError:
            pass
        check_control_db_trust(db_path)
        cx = sqlite3.connect(db_path, timeout=30, isolation_level=None)
    else:
        if not os.path.isfile(db_path):
            raise ControlPlaneMissing(db_path)
        check_control_db_trust(db_path)
        mode = "ro" if readonly else "rw"
        uri = "file:" + urllib.parse.quote(db_path) + "?mode=" + mode
        # `immutable=1` was tried here to stop `mode=ro` from materializing
        # `-wal`/`-shm` sidecar files on a WAL-mode database, but it tells
        # SQLite the file will never change for the life of the connection,
        # so a row committed by a concurrent writer but not yet checkpointed
        # into the base file becomes invisible -- silent stale reads/data
        # loss against a control plane under continuous concurrent write
        # load. Reverted (`architect` finding on PR #239, reproduced by
        # execution). See ADR-0038 (supersedes ADR-0036 for this one claim):
        # the guarantee this connection actually owes is no control-plane
        # DATA mutation, no write transaction, no schema change, and no
        # silent staleness for committed-but-uncheckpointed rows -- NOT "no
        # sidecar file ever touched", which is not achievable for any
        # connection to a WAL-mode SQLite database without this regression.
        try:
            cx = sqlite3.connect(uri, uri=True, timeout=30, isolation_level=None)
        except sqlite3.OperationalError as exc:
            if "unable to open" in str(exc).lower():
                raise ControlPlaneMissing(db_path) from exc
            raise
    cx.row_factory = sqlite3.Row
    cx.execute("PRAGMA busy_timeout=30000")
    if readonly:
        cx.execute("PRAGMA query_only=ON")
    return cx


# LIVENESS-RECORD-v1 §3 / ADR-0002 §3 — the shape `security` ruled after
# crew_beta raised it in cross-crew review of PR #16.
CONTROL_PLANE_UNREADABLE = {"alive": False,
                            "reason_code": "control_plane_unreadable"}


def beat_show_verdict_on_unreadable(args, exc):
    """Turn "cannot open the control plane" into a VERDICT, for `beat show`.

    §3 promises consumers that `beat show` emits one JSON object on stdout on
    EVERY path, and that a not-alive answer is exit **3**. The error path
    broke both halves of that promise: a corrupt, unreadable or uncreatable
    control plane escaped as a traceback with no JSON and exit 1.

    Exit 1 is a crash, and **a crash is not a verdict**. crew_beta's watchdog
    branches on 0 (alive) vs 3 (not alive), so an exit-1 traceback is neither
    — the dead-man's switch mishandles the one failure it most needs to
    catch, the control plane itself being gone. An unreadable control plane
    genuinely IS a verdict of not-alive: nothing can attest the Program ran,
    and ADR-0002 §3 says an unverifiable heartbeat is not a
    live one.

    **Scoped to `beat show` on purpose.** `beat show` exists to answer "is
    this owner alive?", so an unreadable plane has a correct answer: no. No
    other subcommand has one — reporting exit 3 from `slot acquire` would
    say "denied, queue and retry" about a plane that is broken, hiding an
    outage behind a routine verdict. Everything else keeps failing loudly,
    and `test_other_subcommands_do_not_fake_a_verdict` pins that.

    Returns normally (so the caller re-raises) unless this is `beat show`.
    """
    if getattr(args, "group", None) != "beat":
        return
    if getattr(args, "cmd", None) != "show":
        return
    # Diagnostic only, and deliberately on stderr: §3's contract is about the
    # JSON object on STDOUT, whose keys are exactly the two ruled above. An
    # operator paged by this still needs to know which plane, and why.
    print(f"nightshift-ctl: control plane unreadable at {args.db!r}: "
          f"{type(exc).__name__}: {exc}", file=sys.stderr)
    out(dict(CONTROL_PLANE_UNREADABLE), 3)


def add_column(cx, table, col, decl):
    """Add a column, tolerating having LOST the migration race.

    `ensure_schema` runs on every invocation, outside any transaction
    (`connect` uses isolation_level=None), so `PRAGMA table_info` and the
    `ALTER` that follows it are not atomic: with N agents starting at once
    against a pre-migration database, several read "column missing" and
    several ALTERs are issued. The losers used to raise
    `OperationalError: duplicate column name` and exit **1**.

    Exit 1 is not exit 3. A worker whose `slot heartbeat` lands in that window
    gets no verdict at all — it crashes — and the watchdog's `|| true`
    swallows it. Losing this race is a SUCCESS: the column exists, which is
    the only thing the caller wanted.

    Anything that is NOT a duplicate column re-raises. Swallowing every
    OperationalError would replace a crash with a migration that silently
    does nothing, which is strictly worse.
    """
    try:
        cx.execute(f"ALTER TABLE {table} ADD COLUMN {col} {decl}")
        return True
    except sqlite3.OperationalError as e:
        if "duplicate column name" in str(e).lower():
            return False
        raise


def rename_column(cx, table, old, new):
    """Rename a column, tolerating having LOST the same race as add_column.

    The loser finds the rename already done and its own `ALTER` fails with
    `no such column`. Same reasoning, same failure mode; fixing only the
    ADD COLUMN loops would leave a latent instance of the identical bug.
    """
    try:
        cx.execute(f"ALTER TABLE {table} RENAME COLUMN {old} TO {new}")
        return True
    except sqlite3.OperationalError as e:
        msg = str(e).lower()
        if "no such column" in msg or "duplicate column name" in msg:
            return False
        raise


def _report_index_conflict(name, label, conflicts):
    """Print, never raise, the exact conflicting groups a guarded unique
    index precheck found. Shared by every ``_guarded_unique_index`` call so
    the report shape is one spelling, not one per index."""
    groups = ", ".join(str(tuple(row)) for row in conflicts) or "(unknown)"
    print(
        f"nightshift-ctl: WARNING: skipping unique index {name!r} ({label}) "
        f"-- pre-existing conflicting rows: {groups}. Resolve the duplicate "
        "active rows (release, reap, or manually correct them), then rerun "
        "any nightshift-ctl command to retry the migration.",
        file=sys.stderr,
    )


def _guarded_unique_index(cx, name, create_sql, conflict_sql, label):
    """Create a partial unique index, tolerating pre-existing legacy dupes.

    ADR-0062 / #471 (staff MERGE_BLOCKER, folded into the ADR's addendum):
    ``ensure_schema`` runs unconditionally on every non-readonly invocation,
    so a bare ``CREATE UNIQUE INDEX`` that hits a pre-existing violating row
    would raise ``IntegrityError`` UNCAUGHT and crash every subsequent
    ``nightshift-ctl`` command org-wide -- not a fail-closed deny, a total
    control-plane outage, and one the tool itself could then never be used
    to diagnose. Mirrors the ``add_column``/``rename_column`` race-tolerant
    idiom above: detect the exact failure mode ahead of time, report it, and
    return without raising, rather than letting the caller crash. Unlike
    ``add_column``, the conflict here is data (duplicate active rows), not a
    race between two concurrent schema migrations, so this prechecks with a
    ``GROUP BY ... HAVING COUNT(*) > 1`` query before attempting the
    ``CREATE`` at all; the ``try/except IntegrityError`` around the
    ``CREATE`` itself is defense in depth for the residual TOCTOU window
    between that precheck and the statement (``ensure_schema`` runs outside
    a transaction, same as every migration above).

    Returns True if the index exists (already present or just created),
    False if it was skipped this invocation because of a conflict -- the
    index is retried, and self-heals, on every future ``ensure_schema``
    call once the legacy rows are gone.
    """
    conflicts = cx.execute(conflict_sql).fetchall()
    if conflicts:
        _report_index_conflict(name, label, conflicts)
        return False
    try:
        cx.execute(create_sql)
        return True
    except sqlite3.IntegrityError:
        # Lost a genuine race against the precheck above (a duplicate row
        # was inserted between the SELECT and this CREATE) -- same
        # non-fatal outcome as a detected precheck hit: report and skip,
        # never raise uncaught through ensure_schema.
        conflicts = cx.execute(conflict_sql).fetchall()
        _report_index_conflict(name, label, conflicts)
        return False


# ------------------------------------------------------- repository scope --
# Issue #165 / ADR-0084 -- every control-plane WORK table (`tasks`,
# `task_dependencies`, `task_claims`, `worker_slots`, `leases`) is scoped by
# `repository_id`. `authority.db` (bin/nightshift_authority.py) is the
# single attested answer to "which repository is this" -- this plane's own
# `meta.repository_id` binding is a PROJECTION of that attestation, never a
# second source of truth, and `nightshift_authority.validate_repository_id`
# stays the SOLE repository-id validator: this file adds no second one.
# The single exception is SCOPE_HOME below, a control-plane-local sentinel
# that never appears in authority.db, an export manifest, or a conformance
# decision.
SCOPE_HOME = 0  # "this plane's own, possibly-not-yet-named repository" --
                # every row written before this migration means exactly
                # this, and the migration's own DEFAULT is what backfills
                # it (see ensure_schema below).


class RepositoryScopeError(Exception):
    """Raised by `resolve_scope`/`_validate_scope_value`; never crosses a
    `cmd_*` function uncaught. Every call site catches this and reports
    through whichever payload shape that verb already uses (`_scope_out`
    below, or a hand-rolled equivalent for a verb with its own established
    denial idiom), always adding `reason_code` -- so every ADR-0084
    refusal is machine-matchable the same way regardless of the
    surrounding verb's own legacy shape.
    """

    def __init__(self, reason_code, **details):
        super().__init__(reason_code)
        self.reason_code = reason_code
        self.details = dict(details)


_SCOPE_REASON_TEXT = {
    "repository_scope_unbound": (
        "a non-zero --repository-id was given but this plane has never "
        "been bound to a home repository -- see `nightshift-ctl repo bind`"),
    "repository_scope_conflicts_with_task": (
        "the explicit --repository-id disagrees with the target task's "
        "own repository scope"),
    "repository_scope_conflicts_with_home": (
        "reap --delete refuses an explicit --repository-id that disagrees "
        "with this plane's bound (or unbound-home) scope -- it would "
        "correlate delete-eligibility against a bucket this plane's own "
        "tasks are never in, silently discarding their protection"),
    "repository_scope_immutable": (
        "a task's repository scope is set once, at creation, and never "
        "changed"),
    "repository_scope_already_bound": (
        "this plane is already bound to a different repository"),
    "repository_scope_plane_not_single_repository": (
        "this plane already holds rows scoped to more than one "
        "repository -- there is no single home left to name"),
    "repository_scope_not_attested": (
        "authority.db has no attested registry for that repository_id -- "
        "control.db's binding must never be able to disagree with it"),
    "cross_repository_dependency": (
        "a dependency edge cannot cross repositories"),
}


def _import_nightshift_authority():
    """Same lazy-import idiom `authority_client_gate` already uses (avoids
    writing `bin/__pycache__/` from a sibling module import)."""
    previous = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        import nightshift_authority as nsa
        return nsa
    finally:
        sys.dont_write_bytecode = previous


def _validate_scope_value(value):
    """The ONE control-plane wrapper around repository identity: SCOPE_HOME
    (0, and only a real, non-bool `int` 0) names this plane's own,
    possibly-unbound repository; anything else goes straight through
    `nightshift_authority.validate_repository_id` -- the sole validator
    (ADR-0084) -- so this file defines no second one. This is the single
    isinstance/range check on a repository id anywhere in this file; every
    other value is judged by that one imported function.
    """
    if value == SCOPE_HOME and isinstance(value, int) and not isinstance(value, bool):
        return SCOPE_HOME
    nsa = _import_nightshift_authority()
    try:
        return nsa.validate_repository_id(value)
    except nsa.AuthorityError as exc:
        raise RepositoryScopeError(exc.reason_code, **exc.details) from exc


def _meta_get(cx, key):
    row = cx.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
    return row["value"] if row else None


def resolve_scope(cx, args, *, task_row=None):
    """The one place repository scope is decided for a write or scoped
    read (ADR-0084). Reads only control rows, and only inside the CALLER's
    own transaction -- it opens none itself, and raises (never calls
    `out()`) so every call site keeps full control of its own COMMIT/
    ROLLBACK, exactly like every other guard in this file.

    Resolution order:
      1. `task_row["repository_id"]`, when a task is already in play.
         Claims and slots reach this branch with NO explicit flag of their
         own -- they inherit structurally and cannot be handed a
         conflicting scope. An explicit `--repository-id` that DISAGREES
         (only reachable from a verb that also accepts `--task`, e.g.
         `lease acquire`, or from `task upsert`'s own INSERT path) is
         refused as `repository_scope_conflicts_with_task`.
      2. An explicit `--repository-id` (dest `scope_repository_id`) -- but
         refused as `repository_scope_unbound` if it names anything other
         than SCOPE_HOME while this plane has never been bound. Once
         bound, ANY explicit id is accepted: naming a second repository is
         legitimate only once the first repository has a name.
      3. `meta.repository_id` -- the bound home, if one exists.
      4. SCOPE_HOME (0) -- the unnamed home every pre-#165 row already
         means, and what a never-bound plane keeps meaning forever.
    """
    explicit = getattr(args, "scope_repository_id", None)
    if explicit is not None:
        explicit = _validate_scope_value(explicit)
    if task_row is not None:
        task_scope = task_row["repository_id"]
        if explicit is not None and explicit != task_scope:
            raise RepositoryScopeError(
                "repository_scope_conflicts_with_task",
                repository_id=explicit, task_repository_id=task_scope)
        return task_scope
    bound = _meta_get(cx, "repository_id")
    bound_id = int(bound) if bound is not None else None
    if explicit is not None:
        if explicit != SCOPE_HOME and bound_id is None:
            raise RepositoryScopeError("repository_scope_unbound",
                                       repository_id=explicit)
        return explicit
    if bound_id is not None:
        return bound_id
    return SCOPE_HOME


def _scope_out(cx, exc, *, commit=True, **extra):
    """Shared reporting for a `RepositoryScopeError`. `commit=True` (the
    default) COMMITs first -- the established `_slot_denied`/lease-verb
    idiom this file already uses everywhere, which preserves whatever
    `expire_stale` cleanup the caller's own transaction already applied --
    `commit=False` is for a call site that never opened a transaction in
    the first place (a bare read, e.g. `task list`), where a COMMIT would
    raise `OperationalError: cannot commit -- no transaction is active`.
    """
    if commit:
        cx.execute("COMMIT")
    payload = {"ok": False,
               "reason": _SCOPE_REASON_TEXT.get(exc.reason_code, exc.reason_code),
               "reason_code": exc.reason_code}
    payload.update(exc.details)
    payload.update(extra)
    out(payload, 3)


def ensure_schema(cx):
    cx.executescript(SCHEMA)
    # Every migration below goes through add_column/rename_column: the PRAGMA
    # is a fast path, NOT the safety property. The helper is what makes a
    # concurrent first-run against the live database return a verdict instead
    # of a traceback.
    # migrate databases created before slots became one-dispatch capabilities
    cols = {r[1] for r in cx.execute("PRAGMA table_info(worker_slots)")}
    for col, decl in (("dispatched_at", "REAL"), ("bound_agent", "TEXT"),
                      ("bound_title", "TEXT")):
        if col not in cols:
            add_column(cx, "worker_slots", col, decl)
    # ADR-0002 §5 — fencing generation. Additive only, exactly the shape of
    # the dispatched_at migration above: new columns with defaults, no data
    # rewrite, no destructive change, and NO enforcement (that is M3).
    for table in ("worker_slots", "task_claims"):
        tcols = {r[1] for r in cx.execute(f"PRAGMA table_info({table})")}
        if "generation" not in tcols:
            add_column(cx, table, "generation", "INTEGER NOT NULL DEFAULT 0")
        if "run_id" not in tcols:
            add_column(cx, table, "run_id", "TEXT")
    slot_cols = {r[1] for r in cx.execute("PRAGMA table_info(worker_slots)")}
    for col, decl in (
        ("phase", "TEXT CHECK(phase IN ('planning','new','continuation'))"),
        ("expected_agent", "TEXT"),
        ("expected_title", "TEXT"),
        ("expected_purpose", "TEXT"),
        ("continuation_kind",
         "TEXT CHECK(continuation_kind IN ('qa','review','implementer'))"),
        ("claim_id", "INTEGER"),
    ):
        if col not in slot_cols:
            add_column(cx, "worker_slots", col, decl)
    # Legacy rows keep phase NULL and therefore match neither predicate.
    cx.execute(
        "CREATE UNIQUE INDEX IF NOT EXISTS one_active_new_reservation "
        "ON worker_slots(task_id) "
        "WHERE state='active' AND phase='new'"
    )
    cx.execute(
        "CREATE UNIQUE INDEX IF NOT EXISTS one_active_planning_target "
        "ON worker_slots(task_id,expected_agent) "
        "WHERE state='active' AND phase='planning'"
    )
    cx.execute(
        "CREATE UNIQUE INDEX IF NOT EXISTS one_active_slot_per_claim "
        "ON worker_slots(claim_id) WHERE state='active' "
        "AND phase='continuation' AND claim_id IS NOT NULL"
    )
    # Issue #236/#471 / ADR-0062 -- migration seq 10 (allocated under this
    # bin/nightshift-ctl serialize lease, id 40). Two additive partial
    # unique indexes closing the two gaps staff's review of ADR-0062 found:
    #
    # 1. one_active_qa_review_continuation: `claim_id IS NOT NULL`
    #    structurally excludes QA/review continuation slots (claim_id is
    #    always NULL for them) from one_active_slot_per_claim above, so two
    #    concurrent QA (or review) continuation acquisitions for the same
    #    task were never caught. Same-task ambiguity.
    # 2. one_undispatched_dispatch_identity: worker_semaphore's ADR-0062
    #    derivation query has no task_id filter (task_id is what it derives)
    #    -- its uniqueness rests entirely on (expected_agent, expected_title)
    #    never colliding ACROSS tasks, which nothing enforced before this.
    #    Cross-task ambiguity -- a distinct class from (1), not the same gap
    #    at a different width (staff's finding: the reconciliation had
    #    wrongly treated the narrower index as sufficient).
    #
    # Both guarded by _guarded_unique_index (staff MERGE_BLOCKER): a bare
    # CREATE UNIQUE INDEX hitting a pre-existing legacy-duplicate active row
    # would raise IntegrityError uncaught here, crashing every subsequent
    # nightshift-ctl invocation org-wide, not just the one that produced the
    # duplicate -- ensure_schema runs unconditionally on every non-readonly
    # call. Report and skip instead; self-heals once the legacy rows clear.
    _guarded_unique_index(
        cx,
        "one_active_qa_review_continuation",
        "CREATE UNIQUE INDEX IF NOT EXISTS one_active_qa_review_continuation "
        "ON worker_slots(task_id, continuation_kind) WHERE state='active' "
        "AND phase='continuation' AND continuation_kind IN ('qa','review')",
        "SELECT task_id, continuation_kind, COUNT(*) AS n FROM worker_slots "
        "WHERE state='active' AND phase='continuation' "
        "AND continuation_kind IN ('qa','review') "
        "GROUP BY task_id, continuation_kind HAVING COUNT(*) > 1",
        "one active QA/review continuation slot per task",
    )

    # Issue #165/ADR-0084 supersedes this exact index with a
    # repository-scoped one (below, once `repository_id` exists on
    # `worker_slots`) -- the pre-165 narrow index's own comment already
    # named the gap this closes: its uniqueness rested entirely on
    # (expected_agent, expected_title) never colliding ACROSS repositories,
    # which nothing enforced before this. Left uncreated here on purpose;
    # see `one_undispatched_dispatch_identity_per_repository` below.
    # migrate databases created before the pod -> crew rename
    for table in ("worker_slots", "tasks"):
        tcols = {r[1] for r in cx.execute(f"PRAGMA table_info({table})")}
        if "pod" in tcols and "crew" not in tcols:
            rename_column(cx, table, "pod", "crew")
    # ADR-0031 / issue #210 -- historical tasks remain valid with NULL size.
    # Keep this on add_column so concurrent first invocations against an old
    # control plane have the same race-safe behavior as every prior migration.
    tcols = {r[1] for r in cx.execute("PRAGMA table_info(tasks)")}
    if "size" not in tcols:
        add_column(cx, "tasks", "size", "TEXT CHECK(size IN ('S','M','L'))")
    # Issue #214 / ADR-0043 -- durable, nullable task-execution-start marker.
    # Additive only, same shape as the size migration above. Set exactly once
    # by cmd_slot_acquire's NEW-grant transaction (never by `task upsert`:
    # deliberately absent from TASK_FIELDS so the whitelist stays structurally
    # incapable of writing it).
    if "started_at" not in tcols:
        add_column(cx, "tasks", "started_at", "REAL")
    # Issue #215 / ADR-0045 (amends ADR-0032's precedence table) -- durable,
    # nullable per-task execution budget in seconds. Additive only, same
    # shape as size/started_at above. Unlike started_at, this IS a
    # Program-set input (like size), so it lives in TASK_FIELDS and is
    # settable via `task upsert`, guarded by require_valid_budget_seconds.
    if "budget_seconds" not in tcols:
        add_column(cx, "tasks", "budget_seconds", "REAL")
    # Issue #217 / ADR-0046 -- one durable, bounded extension for an
    # expired task. Three additive, nullable columns, same idiom as
    # started_at/budget_seconds above. Deliberately absent from
    # TASK_FIELDS/TASK_ROW_FIELDS (ADR-0043's rationale applies again): a
    # field with an "at most once, ever" write invariant (AC4a) is
    # unenforceable if `task upsert`'s generic whitelist can also reach it.
    # Written only inside cmd_task_extend's own guarded transaction.
    if "extension_seconds" not in tcols:
        add_column(cx, "tasks", "extension_seconds", "REAL")
    if "extension_reason" not in tcols:
        add_column(cx, "tasks", "extension_reason", "TEXT")
    if "extended_at" not in tcols:
        add_column(cx, "tasks", "extended_at", "REAL")
    # Issue #223 / ADR-0060 -- migration seq 9 (allocated under this
    # bin/nightshift-ctl serialize lease, id 38). Three additive, nullable
    # REAL columns recording queue-time/time-to-main task-lifecycle
    # timestamps, same idiom as started_at/budget_seconds/extension_seconds
    # above. All three are deliberately absent from
    # TASK_FIELDS/TASK_ROW_FIELDS: each has a "first observed, ever" write
    # invariant (never rewritten by a later observation of the same event,
    # never cleared by a restart/reopen) that `task upsert`'s generic
    # whitelist would make unenforceable, exactly ADR-0043's/ADR-0046's
    # rationale.
    #   ready_at        -- set the first time _task_readiness_snapshot
    #                       observes reason_code=="ready" for this task
    #                       (write-on-first-observed-read; every caller of
    #                       that shared function participates, not just
    #                       `task show`/`task ready`).
    #   pr_opened_at     -- set the first time `task upsert --pr-url ...`
    #                       is called for this task (the control plane
    #                       learning the delivery PR exists).
    #   integrated_at    -- set the first time `task upsert --state
    #                       integrated` is called for this task.
    # The pr_opened_at/integrated_at writes live inside cmd_task_upsert's
    # own guarded transaction, WHERE <col> IS NULL, matching this DoR's
    # explicit instruction to copy the established idiom rather than open a
    # new subsystem.
    if "ready_at" not in tcols:
        add_column(cx, "tasks", "ready_at", "REAL")
    if "pr_opened_at" not in tcols:
        add_column(cx, "tasks", "pr_opened_at", "REAL")
    if "integrated_at" not in tcols:
        add_column(cx, "tasks", "integrated_at", "REAL")
    # Issue #541 -- canonical path scope, so "can these two run together?" is
    # a QUERY rather than a human's guess at decomposition time. Nullable and
    # additive: every row predating this migration has NULL scope and keeps
    # today's behaviour exactly, so the check can only REMOVE a real collision,
    # never invent one.
    #
    # Appended LAST on purpose. `add_column` order IS physical column order,
    # and fixtures that rebuild the table with a positional
    # `INSERT INTO ... SELECT * FROM tasks` (tests/test_task_graph.py) depend
    # on it. Inserting mid-table silently shifts every later column and fails
    # as "table has N columns but N+1 values were supplied".
    if "paths" not in {r[1] for r in cx.execute("PRAGMA table_info(tasks)")}:
        add_column(cx, "tasks", "paths", "TEXT")
    # Issue #165 / ADR-0084 -- repository scope on every control-plane WORK
    # table. `NOT NULL DEFAULT 0` (SCOPE_HOME) rather than a plain nullable
    # column: SQLite treats NULL as distinct in a UNIQUE index (verified
    # empirically, sqlite 3.53.4), so a nullable scope column would
    # silently VOID the two partial-unique indexes this migration narrows
    # below -- every legacy (NULL) row would read as a distinct value and
    # the uniqueness guarantee they exist for would be gone, not merely
    # widened. `NOT NULL DEFAULT 0` makes the ALTER itself the backfill:
    # every pre-migration row becomes integer 0, meaning exactly what it
    # always meant -- "this plane's own repository" -- so nothing loses
    # meaning. Deliberately NO type name in the declaration (`NOT NULL
    # DEFAULT 0 CHECK(...)`, not `INTEGER NOT NULL DEFAULT 0 CHECK(...)`):
    # INTEGER column affinity would silently convert a raw '7' to 7 BEFORE
    # the CHECK runs, accepting the exact TEXT-vs-INTEGER confusion this
    # column exists to make impossible (also verified empirically).
    # `tasks` is appended LAST among its own columns, same "add_column
    # order IS physical column order" rule the `paths` comment above
    # states -- this loop runs after every other `tasks` column addition
    # in this function, so repository_id lands after `paths` on both a
    # migrated and a fresh-then-migrated plane.
    for _scope_table in ("tasks", "task_dependencies", "task_claims",
                         "worker_slots", "leases"):
        if "repository_id" not in {
                r[1] for r in cx.execute(f"PRAGMA table_info({_scope_table})")}:
            add_column(
                cx, _scope_table, "repository_id",
                "NOT NULL DEFAULT 0 "
                "CHECK(typeof(repository_id)='integer' AND repository_id>=0)")
    # Two of the pre-165 uniqueness guarantees rested on a key that is NOT
    # plane-global and must therefore be widened to include repository_id,
    # or a resource/identity in one repository reads as identical to the
    # same string in another. Every OTHER partial unique index in this file
    # (one_active_claim, one_active_new_reservation,
    # one_active_planning_target, one_active_slot_per_claim,
    # one_active_qa_review_continuation, one_active_program_authority) is
    # already keyed on `task_id`/`state` alone and needs no change: `tasks.id`
    # is a plane-global PRIMARY KEY (pinned by
    # test_repository_scope.IndexPremise), so a task id already resolves to
    # exactly one repository and every task_id-keyed index is already
    # per-repository as a structural consequence.
    #
    # Guarded exactly like `one_active_qa_review_continuation`/
    # `one_undispatched_dispatch_identity` above: a bare `CREATE UNIQUE
    # INDEX` hitting a pre-existing conflicting row would raise
    # `IntegrityError` UNCAUGHT here and crash every subsequent
    # `nightshift-ctl` invocation org-wide -- report and skip instead,
    # self-healing once the legacy rows clear. `one_active_lease`/
    # `one_undispatched_dispatch_identity` (the pre-165 narrow indexes) are
    # dropped ONLY when the guarded create below actually returns True --
    # dropping either unconditionally would leave the plane with NO
    # uniqueness at all on the rare, self-healing call where a legacy
    # duplicate blocked the new index's creation, which is strictly worse
    # than the bug being fixed.
    if _guarded_unique_index(
        cx,
        "one_active_lease_per_repository",
        "CREATE UNIQUE INDEX IF NOT EXISTS one_active_lease_per_repository "
        "ON leases(repository_id, resource) WHERE state='active'",
        "SELECT repository_id, resource, COUNT(*) AS n FROM leases "
        "WHERE state='active' GROUP BY repository_id, resource "
        "HAVING COUNT(*) > 1",
        "one active lease per (repository_id, resource)",
    ):
        cx.execute("DROP INDEX IF EXISTS one_active_lease")
    if _guarded_unique_index(
        cx,
        "one_undispatched_dispatch_identity_per_repository",
        "CREATE UNIQUE INDEX IF NOT EXISTS "
        "one_undispatched_dispatch_identity_per_repository "
        "ON worker_slots(repository_id, expected_agent, expected_title) "
        "WHERE state='active' AND dispatched_at IS NULL",
        "SELECT repository_id, expected_agent, expected_title, COUNT(*) AS n "
        "FROM worker_slots WHERE state='active' AND dispatched_at IS NULL "
        "GROUP BY repository_id, expected_agent, expected_title "
        "HAVING COUNT(*) > 1",
        "one active undispatched slot per (repository_id, expected_agent, "
        "expected_title)",
    ):
        cx.execute("DROP INDEX IF EXISTS one_undispatched_dispatch_identity")
    # Issue #232 / ADR-0040 -- migration seq 2 (allocated under the
    # bin/nightshift-ctl serialize lease). Additive only: one nullable column
    # on the existing review_receipts table, no PK change, no data rewrite.
    # `review receipt-record` stamps the CURRENTLY COMMITTED ruleset's digest
    # at validation time; `review eligibility` compares it against a freshly
    # computed digest and treats any mismatch (including NULL, i.e. a
    # pre-migration row) as ruleset drift -- fail closed, never guessed.
    rr_cols = {r[1] for r in cx.execute("PRAGMA table_info(review_receipts)")}
    if "rules_digest" not in rr_cols:
        add_column(cx, "review_receipts", "rules_digest", "TEXT")
    # Issue #717 / ADR-0090 -- migration seq 13 (allocated under the
    # bin/nightshift-ctl serialize lease). Additive only: one nullable
    # column on review_receipts, no PK change, no data rewrite.
    #
    # ADR-0039 proves a receipt is bound to a fresh, unedited, correctly-marked
    # PR comment. `review log` records reviews that have no such comment --
    # because the reviewing seat ran outside the semaphore, or because posting
    # one would trigger a workflow on a repository Nightshift does not own.
    # Those receipts are real records of real findings and they are NOT the
    # same evidence. Without this column the two are indistinguishable in the
    # table, which is how a weaker record quietly inherits a stronger claim.
    # NULL means "written before this column existed" and is never read as
    # `attested`. No gate consumes this column yet: ADR-0090 names teaching
    # `review eligibility` to distinguish the sources as the first follow-up,
    # deliberately left to ADR-0040's own review rather than folded in here.
    if "source" not in rr_cols:
        add_column(cx, "review_receipts", "source", "TEXT")
    # Issue #720 / ADR-0091 -- migration seq 14 (allocated under the
    # bin/nightshift-ctl serialize lease). Additive only: one nullable column
    # on program_action_permits, no PK change, no data rewrite.
    #
    # `review_gate` records WHICH review domain the mint verified against the
    # plan before issuing the permit. A permit minted through the bare
    # `--digest` path -- the only path that existed before this issue -- has
    # no idea which seat it authorises and therefore stores NULL. The fence
    # treats NULL as "ungated", so it cannot dispatch a gated review seat.
    # Every pre-migration row is NULL, which is the fail-closed reading: an
    # old permit authorises exactly what it always did, and nothing more.
    pap_cols = {r[1] for r in cx.execute(
        "PRAGMA table_info(program_action_permits)")}
    if "review_gate" not in pap_cols:
        add_column(cx, "program_action_permits", "review_gate", "TEXT")


def holder_matches(holder, who):
    """Does `who` prove ownership of a slot acquired by `holder`?

    Accepts the full `<crew>/<agent>` form or the bare agent name. This is
    the single predicate behind BOTH `slot consume` and `slot heartbeat`
    (ADR-0002 §4a) — one spelling of the rule, so the two verbs cannot
    drift apart into a renewal path that is weaker than the dispatch path.
    """
    holder = holder or ""
    return bool(who) and (holder == who or holder.endswith("/" + who))


def consume_slot(cx, slot_id, agent, title, t):
    """Atomically bind a slot to its one dispatch. Shared by `slot consume`
    and (logic-for-logic) the worker_semaphore policy.

    Returns (ok, reason). The CAS is the UPDATE's WHERE clause: only an
    active, unexpired, never-dispatched slot transitions — a second dispatch
    on the same slot changes zero rows and is refused.
    """
    row = cx.execute(
        "SELECT holder, state, expires_at, dispatched_at, bound_agent "
        "FROM worker_slots WHERE id=?", (slot_id,)).fetchone()
    if row is None:
        return False, "slot does not exist — acquire one with `nightshift-ctl slot acquire`"
    holder = row["holder"] or ""
    if agent and not holder_matches(holder, agent):
        return False, (f"slot {slot_id} was acquired for holder '{holder}', "
                       f"not for agent '{agent}' — one slot per worker, "
                       "acquired as <crew>/<agent>")
    cur = cx.execute(
        "UPDATE worker_slots SET dispatched_at=?, bound_agent=?, bound_title=? "
        "WHERE id=? AND state='active' AND dispatched_at IS NULL "
        "AND (expires_at IS NULL OR expires_at > ?)",
        (t, agent, title, slot_id, t))
    if cur.rowcount == 1:
        return True, None
    if row["dispatched_at"] is not None:
        return False, (f"slot {slot_id} already authorized a dispatch "
                       f"(agent '{row['bound_agent']}') — a slot is a "
                       "one-dispatch capability; acquire a fresh one")
    return False, f"slot {slot_id} is {row['state']} or expired — acquire a fresh one"


def load_capacity(args):
    path = args.capacity or os.environ.get("NIGHTSHIFT_CTL_CAPACITY") or os.path.join(
        os.path.dirname(args.db) or ".", "capacity.json"
    )
    cap = dict(CAP_DEFAULTS)
    try:
        with open(path) as f:
            data = json.load(f)
        for k in CAP_DEFAULTS:
            if isinstance(data.get(k), (int, float)):
                cap[k] = data[k]
    except (OSError, ValueError):
        pass  # missing/invalid file: safe defaults, never a crash
    return cap


def require_valid_ttl(ttl, verb, subject):
    """Refuse a non-positive or non-finite ttl. ADR-0008 (extends ADR-0007).

    Two different corruptions share one root cause -- `ttl` is trusted
    arithmetic input and is never checked:

    * RENEWAL verbs (`slot heartbeat`, `slot renew-active`, `claim renew`)
      compute `expires_at = t + ttl` unconditionally. A NEGATIVE ttl back-dates
      it, so the call that was meant to EXTEND the lifetime instead expires the
      row at the instant it is granted -- while still printing `ok: true`. On
      `slot heartbeat`, the ADR-0002 path every worker calls every turn, that
      silently releases a live worker's slot and re-opens confirmed defect 6
      ("the worker budget is not global") through the renewal path.
    * ACQUIRE verbs (`slot acquire`, `lease acquire`, `claim acquire`) used
      `t + ttl if ttl > 0 else None`, where NULL means never-expires. A
      non-positive ttl therefore fell back to an IMMORTAL row that `reap` can
      never free, so every later acquire on that id returns exit 3 forever --
      a permanently wedged task.

    `inf` needs its own check: `inf > 0` is True, so a `> 0` test alone passes
    it through and `expires_at` becomes infinite -- the never-expire wedge by
    another route. `not (ttl > 0)` (rather than `ttl <= 0`) is deliberate: it
    is the form that also catches NaN, for which every comparison is False.

    We REFUSE rather than clamp (R-55). Clamping to a sane default would hide
    the caller's bug forever, and the caller most likely to hit this is R-26's
    published hourly ttl formula, which goes negative in the last 180s of every
    hour. That is a bug that must surface, loudly, at its source.

    Exit 2 = usage error (docs/CONTROL-PLANE.md Conventions), never 3, which is
    reserved for denied/held/cooling.
    """
    if not (ttl > 0) or not math.isfinite(ttl):
        payload = {
            "ok": False,
            "granted": False,
            "reason": (
                f"--ttl must be a finite positive number of seconds; got {ttl!r}. "
                f"A negative, zero, or non-finite (inf/-inf/nan) ttl does not "
                f"shorten '{verb}' -- it back-dates expires_at (releasing the very "
                f"row it was told to renew) or stores never-expires (wedging the "
                f"resource so reap can never free it), in both cases while "
                f"reporting success. If you are near an hourly boundary (R-26), "
                f"recompute ttl instead of passing a stale, negative, or "
                f"non-finite value."
            ),
            "verb": verb,
            "ttl": ttl,
        }
        payload.update(subject)
        out(payload, 2)


def _is_finite_number(value):
    """True iff `value` is a real number safe for arithmetic. Issue #215.

    Guards `budget_seconds` reads against a damaged/out-of-band value (a
    write-time guard bypassed, e.g. a direct DB write) without raising --
    `bool` is excluded because it is technically an `int` subclass and is
    never a meaningful duration.
    """
    return (
        isinstance(value, (int, float))
        and not isinstance(value, bool)
        and math.isfinite(value)
    )


def _is_valid_budget_seconds(value):
    """True iff `value` is safe to use as a task's execution budget.

    Same predicate `require_valid_budget_seconds` enforces at WRITE time
    (finite AND > 0) -- reused here so read-time damage detection (AC9)
    cannot silently drift from write-time validation. Issue #215
    MERGE_BLOCKER-2 (crew_beta, round 1): the original read-time guard
    checked only `_is_finite_number` and never `> 0`, so a direct-DB-written
    `budget_seconds` of `0` or negative -- exactly AC9's "write-time guard
    bypassed" scenario -- read as valid and produced a bogus
    `budget_expired` instead of being treated as absent.
    """
    return _is_finite_number(value) and value > 0


def require_valid_budget_seconds(value, task_id):
    """Refuse a non-positive or non-finite tasks.budget_seconds. Issue #215.

    Same corruption class ADR-0008's require_valid_ttl guards against, for a
    different column: a non-positive or non-finite `budget_seconds` would
    make the expiry test in `_task_readiness_snapshot`
    (`now() >= started_at + budget_seconds`) either always true (zero or
    negative -- expires the instant the task starts), never true (`inf`), or
    never comparable (`nan`, every comparison is False) -- while `task
    upsert` still reported success. We REFUSE rather than clamp or silently
    accept, for the same reason ADR-0008 refuses a bad ttl: the caller's bug
    must surface at its source.

    Exit 2 = usage error (docs/CONTROL-PLANE.md Conventions), never 3, which
    is reserved for denied/held/cooling. A `None` value (not supplied on this
    call) is not an error -- `budget_seconds` is optional.
    """
    if value is None:
        return
    if not _is_valid_budget_seconds(value):
        out({
            "ok": False,
            "reason": (
                f"--budget-seconds must be a finite positive number of "
                f"seconds; got {value!r}. A negative, zero, or non-finite "
                f"(inf/-inf/nan) budget does not shorten a task's execution "
                f"window -- it expires the task the instant it starts, "
                f"never expires it, or never compares at all, in every case "
                f"while 'task upsert' reports success."
            ),
            "verb": "task upsert",
            "id": task_id,
            "budget_seconds": value,
        }, 2)


def expire_stale(cx, t):
    """Expire everything past its TTL. Runs inside the caller's transaction."""
    reaped = {}
    cur = cx.execute(
        "UPDATE task_claims SET state='expired', released_at=? "
        "WHERE state='active' AND expires_at IS NOT NULL AND expires_at < ?",
        (t, t),
    )
    reaped["claims_expired"] = cur.rowcount
    cur = cx.execute(
        "SELECT id FROM worker_slots "
        "WHERE state='active' AND expires_at IS NOT NULL AND expires_at < ?",
        (t,),
    )
    dead_slots = [r["id"] for r in cur.fetchall()]
    if dead_slots:
        qs = ",".join("?" * len(dead_slots))
        cx.execute(
            f"UPDATE worker_slots SET state='reaped', released_at=? WHERE id IN ({qs})",
            [t] + dead_slots,
        )
        cx.execute(
            f"UPDATE agent_runs SET state='dead', ended_at=? "
            f"WHERE state='running' AND slot_id IN ({qs})",
            [t] + dead_slots,
        )
    reaped["slots_reaped"] = len(dead_slots)
    cur = cx.execute(
        "UPDATE leases SET state='expired', released_at=? "
        "WHERE state='active' AND mode='edit' "
        "AND expires_at IS NOT NULL AND expires_at < ?",
        (t, t),
    )
    reaped["leases_expired"] = cur.rowcount
    # ADR-0044 §1/AC-4 — a crashed/never-released Program authority frees
    # itself the same lazy-expiry way as every other row in this file; the
    # NEXT `authority acquire` then sees no active row and advances the
    # generation. No force-break exists on purpose (Decision §5).
    cur = cx.execute(
        "UPDATE program_authority SET state='expired', released_at=? "
        "WHERE state='active' AND expires_at < ?",
        (t, t),
    )
    reaped["program_authority_expired"] = cur.rowcount
    return reaped


def begin(cx):
    cx.execute("BEGIN IMMEDIATE")


# ---------------------------------------------------------------- slots ----

def _current_control_run_id(cx):
    row = cx.execute(
        "SELECT value FROM meta WHERE key='current_run_id'"
    ).fetchone()
    return row["value"] if row and row["value"] else None


def _slot_denied(cx, reason, **facts):
    cx.execute("COMMIT")
    out({"granted": False, "reason": reason, **facts}, 3)


def _next_slot_generation(cx, task_id):
    row = cx.execute(
        "SELECT COALESCE(MAX(generation),0)+1 AS generation "
        "FROM worker_slots WHERE task_id=?", (task_id,)
    ).fetchone()
    return int(row["generation"])


def _active_admission(cx, task_id):
    return cx.execute(
        "SELECT * FROM task_admissions WHERE task_id=?", (task_id,)
    ).fetchone()


def _exact_new_retry(cx, args, run_id):
    row = cx.execute(
        "SELECT * FROM worker_slots WHERE task_id=? AND state='active' "
        "AND phase='new'", (args.task,)
    ).fetchone()
    if row is None:
        return None
    exact = (
        row["holder"] == args.holder
        and row["crew"] == args.crew
        and row["expected_agent"] == args.agent
        and row["expected_title"] == args.title
        and row["expected_purpose"] == args.purpose
        and row["run_id"] == run_id
    )
    if not exact:
        _slot_denied(
            cx, "task already has a competing NEW reservation",
            task=args.task, slot_id=row["id"],
        )
    return row


def _exact_claim_slot_retry(cx, args, claim, run_id):
    row = cx.execute(
        "SELECT * FROM worker_slots WHERE claim_id=? AND state='active' "
        "AND phase='continuation'", (claim["id"],)
    ).fetchone()
    if row is None:
        return None
    exact = (
        row["holder"] == args.holder
        and row["crew"] == args.crew
        and row["task_id"] == args.task
        and row["expected_agent"] == args.agent
        and row["expected_title"] == args.title
        and row["expected_purpose"] == args.purpose
        and row["continuation_kind"] == "implementer"
        and row["run_id"] == run_id
    )
    if not exact:
        _slot_denied(cx, "claim already has a competing continuation slot",
                     claim_id=claim["id"], slot_id=row["id"])
    return row


def _derive_normal_phase(cx, args, task, admission, run_id):
    spec = COUNTED_AGENTS.get(args.agent)
    if spec is None:
        _slot_denied(cx, "unknown normal worker", agent=args.agent)
    expected_crew, role = spec
    if args.crew != expected_crew:
        _slot_denied(cx, "slot crew does not match target worker", task=args.task,
                     agent=args.agent)
    if not holder_matches(args.holder, args.agent):
        _slot_denied(cx, "slot holder does not match target agent",
                     holder=args.holder, agent=args.agent)

    if args.purpose in {"explore", "search"}:
        if role not in {"engineer", "qa"}:
            _slot_denied(cx, "PLANNING requires an engineer or QA target")
        if task["crew"] != expected_crew:
            _slot_denied(cx, "PLANNING target must belong to the task crew")
        if task["state"] != "pending" or admission is not None:
            _slot_denied(cx, "PLANNING requires a pending, unadmitted task")
        if cx.execute(
            "SELECT 1 FROM worker_slots WHERE task_id=? AND state='active' "
            "AND phase='new'", (args.task,)
        ).fetchone():
            _slot_denied(cx, "PLANNING waits for the active NEW reservation")
        if cx.execute(
            "SELECT 1 FROM worker_slots WHERE task_id=? AND expected_agent=? "
            "AND state='active' AND phase='planning'", (args.task, args.agent)
        ).fetchone():
            _slot_denied(cx, "target already has an active PLANNING slot")
        return "planning", None, None

    if admission is None:
        if args.purpose != "implement" or role != "engineer":
            _slot_denied(cx, "only the task implementer may request NEW")
        if (task["crew"] != expected_crew or task["agent"] != args.agent
                or task["title"] != args.title
                or task["state"] != "pending" or task["pr_url"]):
            _slot_denied(cx, "NEW must match the pending task implementer/title")
        retry = _exact_new_retry(cx, args, run_id)
        if retry is not None:
            return "new", None, retry
        if cx.execute(
            "SELECT 1 FROM worker_slots WHERE task_id=? AND state='active' "
            "AND phase='planning'", (args.task,)
        ).fetchone():
            _slot_denied(cx, "NEW waits for active PLANNING to finish")
        verdict = _task_readiness_snapshot(cx).get(args.task)
        if not verdict or not verdict["dispatchable"]:
            _slot_denied(
                cx, "task is not READY for NEW",
                task=args.task,
                reason_code=(verdict or {}).get("reason_code", "unknown_task"),
                blocked_by=(verdict or {}).get("blocked_by", []),
            )
        return "new", None, None

    if task["state"] not in {"building", "ready", "fixing"}:
        _slot_denied(cx, "continuation requires building, ready, or fixing state")
    # security-530 round 2: mirror the root gate's invariant here too so a
    # forged/stale admission (crew changed away after seeding, via 3
    # separate `task upsert` calls) is refused at slot-acquire time, not
    # just re-caught by the root policy at actual dispatch. `admission` is
    # never None on this path -- the `admission is None` branch above
    # always returns or denies before control reaches here.
    if admission["crew"] != task["crew"]:
        _slot_denied(
            cx,
            "continuation admission crew does not match the task's current crew",
        )
    if role == "qa" and args.purpose == "implement":
        if task["crew"] != expected_crew:
            _slot_denied(cx, "QA continuation target must belong to the task crew")
        continuation_kind = "qa"
    elif role == "reviewer" and args.purpose == "review":
        continuation_kind = "review"
    elif (role == "engineer" and args.purpose == "implement"
          and admission["crew"] == expected_crew
          and admission["agent"] == args.agent
          and admission["title"] == args.title):
        continuation_kind = "implementer"
    else:
        _slot_denied(cx, "unsupported continuation target or purpose")
    if continuation_kind in {"qa", "review"}:
        # Issue #724 / ADR-0092. ADR-0033 required PR-stage evidence here
        # because a QA/review continuation, unlike an implementer's, is bound
        # to no `task_claims` row -- ADR-0062 names that missing claim as the
        # structural gap, and the PR was the substitute for it. So a reviewer
        # before the PR exists is admissible on the evidence the PR was
        # standing in for: the implementer's own live claim, which says a
        # build is genuinely in flight and is control-plane state the reviewer
        # cannot assert for itself.
        #
        # Deliberately NOT a new `continuation_kind`: the kind is what this
        # is (a review), the claim is merely what proves it may run now. The
        # ADR-0062 index then keeps covering it unchanged, and no CHECK
        # constraint has to be rebuilt to add a value that would have carried
        # no information the task row does not already hold.
        #
        # QA is untouched -- #716 item I calls its PR requirement legitimate,
        # and QA needs a built artefact rather than a diff to read.
        if not task["pr_url"]:
            if continuation_kind != "review" or not cx.execute(
                # Bound the same way the implementer continuation binds its
                # own claim, rather than accepting any active row: the claim
                # must belong to THIS task's implementer, in THIS run, and
                # must not predate the admission it is supposed to evidence.
                # An unbound `state='active'` lookup would also accept a claim
                # left over from a previous run against an older admission.
                "SELECT 1 FROM task_claims c JOIN task_admissions a"
                "  ON a.task_id = c.task_id"
                " WHERE c.task_id=? AND c.state='active'"
                "   AND c.agent=? AND c.run_id=?"
                "   AND c.acquired_at >= a.admitted_at",
                (args.task, task["agent"], run_id)
            ).fetchone():
                _slot_denied(
                    cx,
                    "QA/review continuation requires task PR evidence"
                    if continuation_kind == "qa" else
                    "review before a PR exists requires the implementer's "
                    "active claim -- there is no build in flight to review",
                    task=args.task)
        # Issue #236/#471 / ADR-0062: matching pre-INSERT check for the
        # one_active_qa_review_continuation partial unique index above --
        # deny a second concurrent acquire for the same (task_id,
        # continuation_kind) cleanly here, same idiom as PLANNING's own
        # "target already has an active PLANNING slot" check above, rather
        # than relying on the index alone to turn a legitimate retry into a
        # raw IntegrityError at INSERT time.
        if cx.execute(
            "SELECT 1 FROM worker_slots WHERE task_id=? AND "
            "continuation_kind=? AND state='active' AND phase='continuation'",
            (args.task, continuation_kind),
        ).fetchone():
            _slot_denied(
                cx, "task already has an active QA/review continuation slot",
                task=args.task, continuation_kind=continuation_kind,
            )
        claim = None
    else:
        if (args.claim_id is None or args.claim_generation is None
                or not args.claim_run_id):
            _slot_denied(cx, "implementer continuation requires exact claim metadata")
        claim = cx.execute(
            "SELECT * FROM task_claims WHERE id=? AND task_id=? AND state='active'",
            (args.claim_id, args.task),
        ).fetchone()
        if claim is None:
            _slot_denied(cx, "implementer continuation requires an active claim")
        if (claim["agent"] != args.agent or claim["title"] != args.title
                or claim["generation"] != args.claim_generation
                or claim["run_id"] != args.claim_run_id
                or claim["generation"] <= 0 or not claim["run_id"]
                or claim["run_id"] != run_id
                or claim["acquired_at"] < admission["admitted_at"]):
            _slot_denied(cx, "active claim is not bound to this implementer/run")

    # Issue #216 (ADR-0032 + ADR-0045): recheck budget_expired LAST, after
    # every kind/role/crew/pr_url/claim validity check above, so a request
    # already invalid for another reason keeps its own more specific denial
    # (AC1, AC7) instead of being masked by this one. Keyed on
    # reason_code=="budget_expired" EXACTLY, never on `dispatchable` --
    # every continuation-eligible task already has dispatchable=False (its
    # state != "pending"), so checking `dispatchable` here would deny 100%
    # of continuation dispatch unconditionally, for every kind (AC9).
    verdict = _task_readiness_snapshot(cx).get(args.task)
    if verdict and verdict["reason_code"] == "budget_expired":
        _slot_denied(
            cx, "continuation denied: task budget_seconds has expired",
            task=args.task, reason_code="budget_expired",
        )
    return "continuation", continuation_kind, claim

def parse_scope(raw):
    """Split a task's `paths` scope into patterns. Comma- or newline-separated,
    blanks dropped. `None`/empty means NO DECLARED SCOPE, which is deliberately
    NOT the same as "matches nothing": an undeclared scope never refuses, so
    this stays backward-compatible with every task row written before #541."""
    if not raw:
        return []
    parts = [p.strip() for chunk in str(raw).split("\n") for p in chunk.split(",")]
    return [p for p in parts if p]


def _pattern_overlaps(a, b):
    """True when two path patterns can name a common file.

    `leases.resource` matching is exact-string today -- `program/skills/
    allocate/SKILL.md` says so outright: "the control plane matches resources
    by string, not by glob overlap". That makes `src/**` and `src/foo/x.py`
    read as unrelated resources, which is exactly the false-disjointness that
    lets two workers edit the same tree. So compare BOTH directions with
    fnmatch, and additionally treat a directory prefix as containing its
    subtree, since `src/**` must overlap `src/foo/x.py` in either order.
    """
    if a == b:
        return True
    if fnmatch.fnmatch(a, b) or fnmatch.fnmatch(b, a):
        return True
    # `dir/**` (or `dir/`) contains everything beneath `dir/`
    for x, y in ((a, b), (b, a)):
        base = x.rstrip("*").rstrip("/")
        if base and ("*" in x or x.endswith("/")) and (y == base or y.startswith(base + "/")):
            return True
    return False


def scopes_overlap(scope_a, scope_b):
    """True when any pattern in one scope can collide with any in the other.

    Either side empty -> False. An undeclared scope is not a claim on
    everything; it is the absence of a claim, and must not start refusing work
    that runs fine today.
    """
    pa, pb = parse_scope(scope_a), parse_scope(scope_b)
    if not pa or not pb:
        return False
    return any(_pattern_overlaps(x, y) for x in pa for y in pb)


def cmd_slot_acquire(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["slot_ttl_seconds"]
    require_valid_ttl(ttl, "slot acquire", {"holder": args.holder})
    kind = "oncall" if args.oncall else "normal"
    begin(cx)
    expire_stale(cx, t)
    if kind == "oncall":
        if args.agent != "oncall" or args.holder != "oncall":
            _slot_denied(cx, "only the exact oncall target may use the reserve")
        # ADR-0044 Decision §3b (widened per program's ruling, PR #298):
        # Program's own direct acquisition of the incident-response reserve
        # slot must present a live, current-generation authority token —
        # scoped to args.oncall is True only. An ordinary crew worker-slot
        # acquisition (e.g. crew_alpha/qa acquiring a PLANNING slot) never
        # sets --oncall and is correctly unaffected.
        auth_token = _read_authority_token(args, "authority_token_stdin")
        auth_row = cx.execute(
            "SELECT * FROM program_authority WHERE generation=? AND state='active'",
            (args.authority_generation,)).fetchone()
        if not _authority_token_matches(auth_token, auth_row):
            _slot_denied(
                cx,
                "oncall slot acquisition requires a live, current-generation "
                "Program authority token (ADR-0044 §3b) — wrong token, wrong "
                "generation, or expired authority row",
            )
        phase = continuation_kind = claim = None
        run_id = None
        generation = 0
        try:
            repository_id = resolve_scope(cx, args, task_row=None)
        except RepositoryScopeError as exc:
            _scope_out(cx, exc)
    else:
        missing = [name for name in ("crew", "task", "agent", "title", "purpose")
                   if not getattr(args, name)]
        if missing:
            _slot_denied(cx, "classified normal slot is missing exact fields",
                         missing=missing)
        task = cx.execute("SELECT * FROM tasks WHERE id=?", (args.task,)).fetchone()
        if task is None:
            _slot_denied(cx, "unknown task", task=args.task)
        try:
            repository_id = resolve_scope(cx, args, task_row=task)
        except RepositoryScopeError as exc:
            _scope_out(cx, exc, task=args.task)
        run_id = _current_control_run_id(cx)
        if not run_id:
            _slot_denied(cx, "no current run id; set `nightshift-ctl run current --set` first")
        admission = _active_admission(cx, args.task)
        phase, continuation_kind, claim = _derive_normal_phase(
            cx, args, task, admission, run_id
        )
        retry = claim if phase == "new" else None
        if phase == "continuation" and continuation_kind == "implementer":
            retry = _exact_claim_slot_retry(cx, args, claim, run_id)
        if retry is not None:
            cx.execute("COMMIT")
            out({"granted": True, "reused": True, "slot_id": retry["id"],
                 "kind": kind, "phase": phase,
                 "continuation_kind": retry["continuation_kind"],
                 "claim_id": retry["claim_id"],
                 "generation": retry["generation"], "run_id": retry["run_id"],
                 "expires_at": retry["expires_at"]})
        generation = (claim["generation"]
                      if continuation_kind == "implementer"
                      else _next_slot_generation(cx, args.task))
        # Issue #541 -- refuse a grant whose declared path scope collides with
        # work already in flight, INSIDE this same BEGIN IMMEDIATE as the grant
        # itself. Checked here and not at decomposition time because ADR-0049's
        # "anything sharing a file goes sequentially" is a human predicting the
        # overlap; this is the machine observing it.
        #
        # NORMAL slots only. The on-call reserve is the incident lane and must
        # never be blocked by scope -- an incident is precisely when you need
        # to touch a file somebody else holds.
        scope = task["paths"] if "paths" in task.keys() else None
        if scope:
            # A task's OWN leases are its reservation, not a conflict.  The
            # documented workflow acquires edit leases BEFORE touching a file,
            # so without this exclusion a task that follows the workflow
            # deadlocks itself and can never be granted a slot (#570).  The
            # in-flight-task loop below already excludes self the same way.
            for lease in cx.execute(
                    "SELECT resource, holder FROM leases "
                    "WHERE state='active' AND repository_id=? "
                    "AND (task_id IS NULL OR task_id <> ?)",
                    (repository_id, args.task)).fetchall():
                if scopes_overlap(scope, lease["resource"]):
                    _slot_denied(cx, "task scope overlaps an active lease",
                                 resource=lease["resource"],
                                 holder=lease["holder"], task=args.task)
            for other in cx.execute(
                    "SELECT w.task_id AS tid, w.holder AS holder, t.paths AS paths "
                    "FROM worker_slots w JOIN tasks t ON t.id = w.task_id "
                    "WHERE w.state='active' AND w.task_id IS NOT NULL "
                    "AND t.repository_id=? AND w.task_id <> ?",
                    (repository_id, args.task)).fetchall():
                if scopes_overlap(scope, other["paths"]):
                    _slot_denied(cx, "task scope overlaps an in-flight task",
                                 conflicting_task=other["tid"],
                                 holder=other["holder"], task=args.task)
    rows = cx.execute(
        "SELECT kind, holder, crew, task_id, phase FROM worker_slots "
        "WHERE state='active'"
    ).fetchall()
    total = len(rows)
    normal = sum(1 for r in rows if r["kind"] == "normal")
    max_w = int(cap["max_concurrent_workers"])
    reserve = int(cap["reserve_for_oncall"])
    if kind == "normal":
        granted = normal < max_w - reserve and total < max_w
        if phase == "planning":
            planning = sum(1 for row in rows if row["phase"] == "planning")
            planning_cap = max(1, max_w - reserve - 1)
            granted = granted and planning < planning_cap
    else:
        granted = total < max_w
    if not granted:
        cx.execute("COMMIT")
        out(
            {
                "granted": False,
                "reason": "worker budget exhausted",
                "kind": kind,
                "active_total": total,
                "active_normal": normal,
                "max_concurrent_workers": max_w,
                "reserve_for_oncall": reserve,
                "holders": [dict(r) for r in rows],
            },
            3,
        )
    # Issue #236/#471 / ADR-0062, security F-SEC-1 (round-1 MERGE_BLOCKER):
    # matching pre-INSERT check for the one_undispatched_dispatch_identity
    # partial unique index above. The AC-5 guard in _derive_normal_phase
    # only covers the qa/review continuation branch; every OTHER path that
    # reaches this single shared INSERT (planning, new, continuation-
    # implementer, oncall) was left unguarded, so a legitimate
    # different-task, same-(agent,title) sequence -- e.g. task A holds a
    # PLANNING slot for (eng_claude, T) and task B then acquires a NEW slot
    # for the same (eng_claude, T) -- hit the index's uncaught
    # sqlite3.IntegrityError here instead of a clean deny. `begin(cx)`
    # (BEGIN IMMEDIATE) already holds this function's write lock for the
    # whole transaction, so -- unlike ensure_schema's cross-process race --
    # a plain precheck is race-free here; no try/except needed, same as the
    # qa/review precheck's own idiom in this same file.
    if cx.execute(
        "SELECT 1 FROM worker_slots WHERE state='active' AND "
        "dispatched_at IS NULL AND repository_id=? AND expected_agent=? "
        "AND expected_title=?",
        (repository_id, args.agent, args.title),
    ).fetchone():
        _slot_denied(
            cx,
            "another active undispatched slot already exists for this "
            "exact (agent, title) -- dispatch identity must stay unique "
            "within a repository",
            agent=args.agent, title=args.title,
        )
    cur = cx.execute(
        "INSERT INTO worker_slots("
        "holder,crew,task_id,kind,state,acquired_at,expires_at,phase,"
        "expected_agent,expected_title,expected_purpose,continuation_kind,"
        "claim_id,generation,run_id,repository_id) "
        "VALUES(?,?,?,?,'active',?,?,?,?,?,?,?,?,?,?,?)",
        (args.holder, args.crew, args.task, kind, t, t + ttl, phase,
         args.agent, args.title, args.purpose, continuation_kind,
         claim["id"] if claim is not None else None, generation, run_id,
         repository_id),
    )
    slot_id = cur.lastrowid
    # Issue #214 / ADR-0043 (amended): `tasks.started_at` is NOT set here.
    # A `phase='new'` reservation is mutable -- it can expire or be released
    # unconsumed, and creates no admission (ADR-0033) -- so this used to be
    # able to pin the wrong (early) timestamp if this exact reservation was
    # never consumed and the task was genuinely admitted later, since the
    # write's own `WHERE started_at IS NULL` guard would then refuse the
    # correct, later write. The write now lives in `worker_semaphore`'s
    # `phase == "new"` branch (`deploy/policies/omnipods_policies.py`), the
    # same transaction as the real `INSERT INTO task_admissions` /
    # `UPDATE tasks SET state='building'` -- the only place ADR-0033
    # recognises as genuine admission. See the ADR-0043 amendment note.
    cx.execute("COMMIT")
    out({"granted": True, "reused": False, "slot_id": slot_id, "kind": kind,
         "phase": phase, "continuation_kind": continuation_kind,
         "claim_id": claim["id"] if claim is not None else None,
         "generation": generation, "run_id": run_id,
         "expires_at": t + ttl,
         "active_after": total + 1, "max_concurrent_workers": max_w})


def cmd_slot_release(cx, args):
    """Release a slot the CALLER HOLDS. ADR-0068 (closes #503/F-1).

    Before this check, `--holder` was accepted but optional on both release
    paths -- an unverified signal treated as proof, the same shape ADR-0002
    §4a already closed for `slot heartbeat`. `--slot` alone (or `--holder`
    naming someone else's slot) no longer releases anything.
    """
    t = now()
    begin(cx)
    expire_stale(cx, t)
    if args.slot is not None:
        row = cx.execute(
            "SELECT holder FROM worker_slots WHERE id=? AND state='active'",
            (args.slot,)).fetchone()
        if row is not None and not holder_matches(row["holder"] or "", args.holder):
            cx.execute("COMMIT")
            out({"ok": False, "slot_id": args.slot,
                 "reason": (f"slot {args.slot} was acquired for holder "
                            f"'{row['holder']}', not for '{args.holder}' — a "
                            "slot is released only by its holder, never by "
                            "whoever knows its id (ADR-0002 §4a / ADR-0068)")},
                3)
        cur = cx.execute(
            "UPDATE worker_slots SET state='released', released_at=? "
            "WHERE id=? AND state='active'", (t, args.slot))
    else:
        rows = cx.execute(
            "SELECT id, holder FROM worker_slots WHERE state='active'"
            + (" AND task_id=?" if args.task else ""),
            ([args.task] if args.task else [])).fetchall()
        ids = [r["id"] for r in rows
               if holder_matches(r["holder"] or "", args.holder)]
        n = 0
        if ids:
            qs = ",".join("?" * len(ids))
            cur = cx.execute(
                f"UPDATE worker_slots SET state='released', released_at=? "
                f"WHERE id IN ({qs}) AND state='active'", [t] + ids)
            n = cur.rowcount
        cx.execute("COMMIT")
        out({"ok": True, "released": n}, 0 if n else 3)
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": True, "released": n}, 0 if n else 3)


def cmd_slot_heartbeat(cx, args):
    """Renew a slot the CALLER HOLDS. ADR-0002 §4a.

    Before this check, `slot heartbeat --slot <n>` renewed on knowledge of an
    integer alone. Wiring workers onto that would have satisfied the letter of
    "worker-owned renewal" while reproducing, in miniature, the defect
    ADR-0002 exists to remove: an unverified signal treated as proof. The
    check is the same one `consume_slot` has always applied to dispatch.
    """
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["slot_ttl_seconds"]
    require_valid_ttl(ttl, "slot heartbeat", {"slot_id": args.slot})
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute("SELECT holder, state FROM worker_slots WHERE id=?",
                     (args.slot,)).fetchone()
    if row is None:
        cx.execute("COMMIT")
        out({"ok": False, "slot_id": args.slot,
             "reason": f"slot {args.slot} does not exist"}, 3)
    holder = row["holder"] or ""
    if not holder_matches(holder, args.holder):
        cx.execute("COMMIT")
        out({"ok": False, "slot_id": args.slot,
             "reason": (f"slot {args.slot} was acquired for holder "
                        f"'{holder}', not for '{args.holder}' — a slot is "
                        "renewed by its holder, never by whoever knows its "
                        "id (ADR-0002 §4a)")}, 3)
    cur = cx.execute(
        "UPDATE worker_slots SET expires_at=? WHERE id=? AND state='active'",
        (t + ttl, args.slot))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": bool(n), "slot_id": args.slot, "holder": holder,
         "expires_at": t + ttl}, 0 if n else 3)


def cmd_slot_consume(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    ok, reason = consume_slot(cx, args.slot, args.agent, args.title, t)
    cx.execute("COMMIT")
    if ok:
        out({"ok": True, "slot_id": args.slot, "agent": args.agent})
    out({"ok": False, "reason": reason, "slot_id": args.slot}, 3)


def cmd_slot_renew_active(cx, args):
    """Extend TTLs for in-flight slots — called by the watchdog while the org
    is demonstrably alive, so a genuinely long worker turn is never reaped
    mid-flight. `--max-age` caps it: a leaked slot still dies within a day,
    and when the org goes silent the watchdog stops renewing entirely, which
    is exactly when TTL recovery should take over."""
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["slot_ttl_seconds"]
    require_valid_ttl(ttl, "slot renew-active", {"max_age": args.max_age})
    begin(cx)
    expire_stale(cx, t)
    cur = cx.execute(
        "UPDATE worker_slots SET expires_at=? "
        "WHERE state='active' AND acquired_at > ?",
        (t + ttl, t - args.max_age))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": True, "renewed": n, "ttl": ttl, "max_age": args.max_age})


def cmd_slot_list(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    rows = cx.execute(
        "SELECT * FROM worker_slots WHERE state='active' ORDER BY acquired_at").fetchall()
    cx.execute("COMMIT")
    out({"active": [dict(r) for r in rows]})


# ---------------------------------------------------------------- claims ---

def cmd_claim_acquire(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["claim_ttl_seconds"]
    require_valid_ttl(ttl, "claim acquire", {"task": args.task})
    begin(cx)
    expire_stale(cx, t)
    task = cx.execute("SELECT * FROM tasks WHERE id=?", (args.task,)).fetchone()
    admission = _active_admission(cx, args.task)
    if task is None or admission is None:
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "implementer claim requires an admitted known task"}, 3)
    if task["state"] not in {"building", "ready", "fixing"}:
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "claim requires building, ready, or fixing state"}, 3)
    # ADR-0084: no `--repository-id` flag exists on this verb (a claim
    # always inherits its scope from the task it claims, structurally --
    # there is no argument here that could disagree with it).
    repository_id = resolve_scope(cx, args, task_row=task)
    if (args.agent != admission["agent"] or args.title != admission["title"]):
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "claim must match the original admitted engineer/title"}, 3)
    run_id = _current_control_run_id(cx)
    if not run_id:
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "no current run id; set `nightshift-ctl run current --set` first"}, 3)
    row = cx.execute(
        "SELECT COALESCE(MAX(generation),0)+1 AS generation "
        "FROM task_claims WHERE task_id=?", (args.task,)
    ).fetchone()
    generation = int(row["generation"])
    if args.claimant == "program":
        # ADR-0044 Decision §3b (widened per program's ruling, PR #298):
        # Program's own direct claim-first recovery must present a live,
        # current-generation authority token before the claim row is
        # inserted. A crew's own claim-first recovery of ITS OWN task
        # (--claimant crew_alpha, etc.) is a completely different action —
        # unaffected, not gated — this branch only fires for the literal
        # string "program".
        auth_token = _read_authority_token(args, "authority_token_stdin")
        auth_row = cx.execute(
            "SELECT * FROM program_authority WHERE generation=? AND state='active'",
            (args.authority_generation,)).fetchone()
        if not _authority_token_matches(auth_token, auth_row):
            cx.execute("COMMIT")
            out({"granted": False,
                 "reason": "program claim-first recovery requires a live, "
                           "current-generation Program authority token "
                           "(ADR-0044 §3b) — wrong token, wrong generation, "
                           "or expired authority row",
                 "task": args.task}, 3)
    try:
        cur = cx.execute(
            "INSERT INTO task_claims"
            "(task_id,claimant,agent,title,session_id,worktree,reason,state,"
            "acquired_at,expires_at,generation,run_id,repository_id)"
            " VALUES(?,?,?,?,?,?,?,'active',?,?,?,?,?)",
            (args.task, args.claimant, args.agent, args.title, args.session,
             args.worktree, args.reason, t, t + ttl, generation, run_id,
             repository_id),
        )
        claim_id = cur.lastrowid
        cx.execute("COMMIT")
        out({"granted": True, "claim_id": claim_id, "task": args.task,
             "generation": generation, "run_id": run_id,
             "expires_at": t + ttl})
    except sqlite3.IntegrityError:
        holder = cx.execute(
            "SELECT * FROM task_claims WHERE task_id=? AND state='active'",
            (args.task,)).fetchone()
        cx.execute("COMMIT")
        h = dict(holder) if holder else {}
        out({
            "granted": False,
            "reason": "task already claimed — stand down; the claimant owns recovery",
            "holder": h,
            "reuse": {"agent": h.get("agent"), "title": h.get("title")},
        }, 3)


def cmd_claim_release(cx, args):
    """Release a claim the CALLER HOLDS. ADR-0068 (closes #508 D07/RT-19).

    Before this check, `claim release --task <id>` took no identity
    parameter at all -- any caller could release any claim, wiping the
    "someone is recovering this" signal for a session still legitimately
    live (docs/audit/CONCURRENCY.md Q1/Q3, F-1). Mirrors `slot release`'s
    identical fix and `slot heartbeat`'s original ADR-0002 §4a pattern.
    """
    t = now()
    begin(cx)
    row = cx.execute(
        "SELECT claimant FROM task_claims WHERE task_id=? AND state='active'",
        (args.task,)).fetchone()
    if row is None:
        cx.execute("COMMIT")
        out({"ok": False, "task": args.task,
             "reason": "no active claim on that task"}, 3)
    if not holder_matches(row["claimant"] or "", args.claimant):
        cx.execute("COMMIT")
        out({"ok": False, "task": args.task,
             "reason": (f"task {args.task} is claimed by "
                        f"'{row['claimant']}', not by '{args.claimant}' — a "
                        "claim is released only by its claimant, never by "
                        "whoever knows the task id (ADR-0068)")}, 3)
    cur = cx.execute(
        "UPDATE task_claims SET state='released', released_at=? "
        "WHERE task_id=? AND state='active'", (t, args.task))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": True, "released": n}, 0 if n else 3)


def cmd_claim_renew(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["claim_ttl_seconds"]
    # #77: a non-positive (or NaN/inf) ttl back-dates expires_at, silently
    # releasing the claim it was told to renew while still reporting
    # ok: true. R-26's own published TTL formula goes negative in the last
    # 180s of every hour -- refuse loudly rather than write a claim into a
    # state the caller didn't ask for. Exit 2 = usage error (docs/CONTROL-
    # PLANE.md Conventions), never 3 (reserved for denied/held/cooling) and
    # never a silent clamp (ADR-0007).
    if not (ttl > 0) or not math.isfinite(ttl):
        out({"ok": False,
             "reason": f"--ttl must be a finite positive number of seconds; got {ttl!r}. "
                       "A negative, zero, or non-finite (inf/-inf) ttl back-dates or "
                       "never-expires expires_at and releases or permanently wedges "
                       "the claim instead of renewing it. If you are near an hourly "
                       "boundary (R-26), recompute ttl instead of passing a stale, "
                       "negative, or non-finite value.",
             "task": args.task, "ttl": ttl}, 2)
    begin(cx)
    row = cx.execute(
        "SELECT claimant FROM task_claims WHERE task_id=? AND state='active'",
        (args.task,)).fetchone()
    if row is None:
        cx.execute("COMMIT")
        out({"ok": False, "task": args.task,
             "reason": "no active claim on that task"}, 3)
    if not holder_matches(row["claimant"] or "", args.claimant):
        cx.execute("COMMIT")
        out({"ok": False, "task": args.task,
             "reason": (f"task {args.task} is claimed by "
                        f"'{row['claimant']}', not by '{args.claimant}' — a "
                        "claim is renewed only by its claimant, never by "
                        "whoever knows the task id (ADR-0068)")}, 3)
    cur = cx.execute(
        "UPDATE task_claims SET expires_at=? WHERE task_id=? AND state='active'",
        (t + ttl, args.task))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": bool(n), "task": args.task, "expires_at": t + ttl}, 0 if n else 3)


def cmd_claim_show(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute(
        "SELECT * FROM task_claims WHERE task_id=? AND state='active'",
        (args.task,)).fetchone()
    cx.execute("COMMIT")
    if row:
        out({"claimed": True, "holder": dict(row)})
    out({"claimed": False, "task": args.task}, 3)


# ---------------------------------------------------------------- leases ---

def cmd_lease_acquire(cx, args):
    cap = load_capacity(args)
    t = now()
    if args.mode == "serialize":
        expires = None  # held until PR merged/dropped, never TTL'd away
    else:
        ttl = args.ttl if args.ttl is not None else cap["lease_ttl_seconds"]
        # `serialize` above is the ONE legitimate never-expires path (held
        # until the PR merges or is dropped), so the guard lives in this
        # branch only -- it must not turn a correct serialize lease into an
        # error. See ADR-0008 "The serialize carve-out".
        require_valid_ttl(ttl, "lease acquire", {"resource": args.resource})
        expires = t + ttl
    begin(cx)
    expire_stale(cx, t)
    # ADR-0084: `--task` is optional and pre-dates this feature -- an
    # unknown task must fall through to the ordinary explicit/bound/
    # SCOPE_HOME resolution below, never start refusing a `--task` this
    # verb has always accepted with no existence check.
    task_row = (cx.execute("SELECT * FROM tasks WHERE id=?", (args.task,)).fetchone()
                if args.task else None)
    try:
        repository_id = resolve_scope(cx, args, task_row=task_row)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, resource=args.resource)
    try:
        cur = cx.execute(
            "INSERT INTO leases(resource,mode,holder,task_id,note,state,"
            "acquired_at,expires_at,repository_id)"
            " VALUES(?,?,?,?,?,'active',?,?,?)",
            (args.resource, args.mode, args.holder, args.task, args.note, t,
             expires, repository_id))
        lease_id = cur.lastrowid
        cx.execute("COMMIT")
        out({"granted": True, "lease_id": lease_id, "resource": args.resource,
             "mode": args.mode, "expires_at": expires})
    except sqlite3.IntegrityError:
        holder = cx.execute(
            "SELECT * FROM leases WHERE resource=? AND repository_id=? "
            "AND state='active'",
            (args.resource, repository_id)).fetchone()
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "resource already leased — queue behind the holder",
             "holder": dict(holder) if holder else {}}, 3)


def cmd_lease_release(cx, args):
    """Release a lease the CALLER HOLDS. ADR-0068 (closes #503/F-1).

    `--holder` was accepted but optional -- `if args.holder and ...` skipped
    the check entirely when omitted. Now required at the parser and verified
    unconditionally, same shape as `slot release`/`claim release`.
    """
    t = now()
    begin(cx)
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, resource=args.resource)
    row = cx.execute(
        "SELECT * FROM leases WHERE resource=? AND repository_id=? "
        "AND state='active'",
        (args.resource, repository_id)).fetchone()
    if not row:
        cx.execute("COMMIT")
        out({"ok": False, "reason": "no active lease on that resource"}, 3)
    if not holder_matches(row["holder"] or "", args.holder):
        cx.execute("COMMIT")
        out({"ok": False, "reason": "lease held by someone else",
             "holder": row["holder"]}, 3)
    if row["mode"] == "serialize" and args.event not in ("pr-merged", "dropped"):
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": "serialize lease releases only on pr-merged or dropped — "
                       "it protects ordering through review, not just editing",
             "mode": "serialize", "event": args.event}, 3)
    cx.execute(
        "UPDATE leases SET state='released', released_at=?, note=COALESCE(note,'') || ? "
        "WHERE id=?", (t, " released:" + args.event, row["id"]))
    cx.execute("COMMIT")
    out({"ok": True, "resource": args.resource, "event": args.event})


def cmd_lease_break(cx, args):
    t = now()
    begin(cx)
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, resource=args.resource)
    cur = cx.execute(
        "UPDATE leases SET state='broken', released_at=?, note=COALESCE(note,'') || ? "
        "WHERE resource=? AND repository_id=? AND state='active'",
        (t, " broken:" + args.reason, args.resource, repository_id))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": bool(n), "resource": args.resource, "reason": args.reason},
        0 if n else 3)


def cmd_lease_list(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc)
    rows = cx.execute(
        "SELECT * FROM leases WHERE state='active' AND repository_id=? "
        "ORDER BY acquired_at", (repository_id,)).fetchall()
    cx.execute("COMMIT")
    out({"active": [dict(r) for r in rows]})


# ------------------------------------------------------- program authority ---
# ADR-0044: at most one Program-role session may act. This primitive is the
# fence itself (§1/§2); the two enforcement points that CONSUME it — the
# ROOT policy in program/config.yaml (Decision §3) and the --claimant
# program / --oncall token checks inside `claim acquire`/`slot acquire`
# (Decision §3b) — are a separate, dependent task and are not built here.

def _read_authority_token(args, stdin_attr="token_stdin"):
    """Never argv (ADR-0044 Decision §3b's own rule, applied here too).
    `--token-stdin` reads the raw token from stdin; otherwise falls back to
    the NIGHTSHIFT_CTL_AUTHORITY_TOKEN env var, mirroring this file's
    existing --db / NIGHTSHIFT_CTL_DB precedence. Returns None if neither is
    set — callers treat that identically to a wrong token (denied, exit 3).
    `stdin_attr` lets the §3b call sites (`claim acquire`/`slot acquire`,
    flag `--authority-token-stdin`, dest `authority_token_stdin`) share this
    exact same predicate rather than re-deriving it, per the ADR's own
    instruction to match §2's token-handling rule.
    """
    if getattr(args, stdin_attr, False):
        tok = sys.stdin.read().strip()
        if tok:
            return tok
    env = os.environ.get("NIGHTSHIFT_CTL_AUTHORITY_TOKEN")
    return env.strip() if env else None


def _authority_token_matches(token, row):
    if row is None or token is None:
        return False
    return hashlib.sha256(token.encode()).hexdigest() == row["token_hash"]


def cmd_authority_acquire(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["authority_ttl_seconds"]
    require_valid_ttl(ttl, "authority acquire", {"holder_label": args.holder_label})
    begin(cx)
    expire_stale(cx, t)
    incumbent = cx.execute(
        "SELECT * FROM program_authority WHERE state='active'").fetchone()
    if incumbent is not None:
        # Read-only stand-down: AC-2 requires ZERO mutation on denial.
        cx.execute("COMMIT")
        out({"granted": False,
             "reason": "a live Program authority already holds the fence — stand down cleanly",
             "holder_label": incumbent["holder_label"],
             "generation": incumbent["generation"],
             "expires_at": incumbent["expires_at"]}, 3)
    prior = cx.execute(
        "SELECT generation, state FROM program_authority "
        "ORDER BY generation DESC LIMIT 1"
    ).fetchone()
    if prior is None:
        generation = 1
        reason = "no prior Program authority — first acquisition"
    else:
        generation = int(prior["generation"]) + 1
        if prior["state"] == "expired":
            reason = (f"prior generation {prior['generation']} expired "
                      "(TTL lapsed, no force-break — ADR-0044 §5)")
        else:
            reason = f"prior generation {prior['generation']} released cleanly"
    token = secrets.token_hex(32)
    token_hash = hashlib.sha256(token.encode()).hexdigest()
    cur = cx.execute(
        "INSERT INTO program_authority"
        "(generation,token_hash,holder_label,acquired_at,expires_at,state)"
        " VALUES(?,?,?,?,?,'active')",
        (generation, token_hash, args.holder_label, t, t + ttl))
    authority_id = cur.lastrowid
    cx.execute("COMMIT")
    out({"granted": True, "authority_id": authority_id, "generation": generation,
         "token": token, "expires_at": t + ttl, "reason": reason})


def cmd_authority_renew(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["authority_ttl_seconds"]
    require_valid_ttl(ttl, "authority renew", {"generation": args.generation})
    token = _read_authority_token(args)
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute(
        "SELECT * FROM program_authority WHERE generation=? AND state='active'",
        (args.generation,)).fetchone()
    if not _authority_token_matches(token, row):
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": "wrong token, wrong generation, or expired authority row"}, 3)
    cx.execute(
        "UPDATE program_authority SET expires_at=?, renewed_at=? WHERE id=?",
        (t + ttl, t, row["id"]))
    cx.execute("COMMIT")
    out({"ok": True, "generation": args.generation, "expires_at": t + ttl})


def cmd_authority_release(cx, args):
    t = now()
    token = _read_authority_token(args)
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute(
        "SELECT * FROM program_authority WHERE generation=? AND state='active'",
        (args.generation,)).fetchone()
    if not _authority_token_matches(token, row):
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": "wrong token, wrong generation, or expired authority row"}, 3)
    cx.execute(
        "UPDATE program_authority SET state='released', released_at=? WHERE id=?",
        (t, row["id"]))
    cx.execute("COMMIT")
    out({"ok": True, "generation": args.generation})


def consume_program_action_permit(cx, digest, generation, t, review_gate=None):
    """Atomically consume a matching, unexpired, current-generation permit.

    Returns True iff exactly one row was consumed (compare-and-set via
    rowcount, same shape this file already uses for one-shot resources).
    Runs inside the CALLER's own transaction — it does not begin/commit.
    This is the single enforcement primitive Decision §3 (ROOT policy) and
    §3b (claim/slot token gates) both call; building on it is a separate,
    dependent task.
    """
    if review_gate is None:
        cur = cx.execute(
            "UPDATE program_action_permits SET consumed_at=? "
            "WHERE action_digest=? AND generation=? AND consumed_at IS NULL "
            "AND expires_at>?",
            (t, digest, generation, t))
        return cur.rowcount == 1
    # Issue #720 / ADR-0091: the dispatched seat carries a review domain, so
    # only a permit whose mint verified that domain against the plan will do.
    # `review_gate IS NULL` is every permit minted through the bare `--digest`
    # path and every row that predates the column -- both mean "this permit
    # never learned which seat it authorises", and neither may stand in for a
    # gated one. Without this clause the mint gate would be advisory: any
    # blind permit for the same digest would dispatch the seat anyway.
    # `exempt` is accepted alongside the domain because the fence cannot tell
    # a review dispatch from a design-input one -- both are `sys_session_send`
    # to the same seat. The declaration made at mint time is the only signal
    # that exists, which is exactly why it is recorded and counted rather than
    # merely allowed.
    cur = cx.execute(
        "UPDATE program_action_permits SET consumed_at=? "
        "WHERE action_digest=? AND generation=? AND consumed_at IS NULL "
        "AND expires_at>? AND review_gate IN (?,?,?)",
        (t, digest, generation, t, review_gate, "exempt", "fallback"))
    return cur.rowcount == 1


def canonical_dispatch_digest(tool, agent, title, args):
    """SHA-256 hex digest of the canonicalized {tool,agent,title,args} tuple
    a Program-role dispatch is about to make (ADR-0044 Decision §3).

    Two independent call sites must agree on exactly this shape without ever
    drifting apart: the ROOT policy (`deploy/policies/omnipods_policies.py`)
    loads this file via the attested-controller path and calls THIS
    function against the live tool-call event it is evaluating, and
    `authority digest` below lets whatever issues the matching permit
    (Program's own scheduled-task prompt, per ADR-0044 §7 — not built here)
    compute the identical value ahead of time. A missing/non-dict `args` is
    normalised to `{}` and a missing `title` to `""` so both call sites
    tolerate the same absent-field shapes identically rather than one
    raising and the other not.
    """
    payload = {
        "tool": tool,
        "agent": agent,
        "title": title if title is not None else "",
        "args": args if isinstance(args, dict) else {},
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def cmd_authority_digest(cx, args):
    try:
        parsed_args = json.loads(args.args_json) if args.args_json else {}
    except json.JSONDecodeError as exc:
        out({"ok": False, "reason": f"--args-json is not valid JSON: {exc}"}, 2)
    if not isinstance(parsed_args, dict):
        out({"ok": False, "reason": "--args-json must decode to a JSON object"}, 2)
    digest = canonical_dispatch_digest(args.tool, args.agent, args.title, parsed_args)
    out({"ok": True, "digest": digest, "tool": args.tool, "agent": args.agent,
         "title": args.title, "args": parsed_args})


def _permit_call_digest(args):
    """The digest this permit will authorise, from either accepted form.

    `--digest` is the original form (ADR-0044 §3) and stays: it is what the
    runbook, the fence cutover and Program's own prompt were written against.
    What it cannot do is say WHICH seat it authorises, which is why the
    review gate below is unreachable from it -- and why a permit minted this
    way carries `review_gate` NULL and cannot dispatch a gated review seat.

    The tuple form computes the identical value through the identical
    function the root policy calls (`canonical_dispatch_digest`), so there is
    one definition of "this exact call" and not two that drift.
    """
    if args.digest:
        # Every gate-bearing argument is listed, not just the digest inputs.
        # A caller that passes `--digest` alongside `--task/--head-sha/
        # --not-a-review` is asking for a gated mint and would silently get an
        # ungated one -- told nothing, and refused later at the fence.
        supplied = [name for name, value in (
            ("--agent", args.agent), ("--title", args.title),
            ("--args-json", args.args_json), ("--task", args.task),
            ("--repo", args.repo), ("--head-sha", args.head_sha),
            ("--not-a-review", getattr(args, "not_a_review", None)),
        ) if value]
        if supplied:
            out({"ok": False,
                 "reason": "--digest names the call by its hash and cannot be "
                           "gated on the review plan; it does not combine with "
                           + ", ".join(supplied)}, 2)
        return args.digest, None
    if not args.agent:
        out({"ok": False,
             "reason": "pass either --digest or --tool with --agent"}, 2)
    try:
        parsed = json.loads(args.args_json) if args.args_json else {}
    except json.JSONDecodeError as exc:
        out({"ok": False, "reason": f"--args-json is not valid JSON: {exc}"}, 2)
    if not isinstance(parsed, dict):
        out({"ok": False, "reason": "--args-json must decode to a JSON object"}, 2)
    return (canonical_dispatch_digest(args.tool, args.agent, args.title, parsed),
            args.agent)


def _review_dispatch_gate(cx, agent, args, t):
    """Apply issue #720's plan gate.

    Returns ``(review_gate, degradation_row_or_None)``. The row is handed
    back rather than written here because the caller has not yet proved it
    holds the authority token: writing it now would let an unauthenticated
    caller append to the control plane, and a degradation count anyone can
    inflate is not evidence of anything.

    Runs BEFORE the caller opens `BEGIN IMMEDIATE`: it shells out to git for
    a base-to-head diff, and holding the control plane's write lock across
    that is how a 32-second freeze gets built.

    Returns None for an agent that is not gated, which is every agent except
    `security`, `ux` and `staff` -- see the module docstring for why that set
    is neither larger nor smaller.
    """
    if agent is None:
        return None, None
    sys.dont_write_bytecode = True
    try:
        import nightshift_review_dispatch_gate as gate
    except (ImportError, OSError, SyntaxError):
        out({"ok": False, "reason": "review dispatch gate unavailable"}, 3)
    if gate.gate_for_agent(agent) is None:
        return None, None
    try:
        outcome, domain, reason = gate.decide(
            cx, agent, args.task, args.repo, args.head_sha,
            getattr(args, "not_a_review", None))
    except gate.GateInput as exc:
        out({"ok": False, "reason": str(exc)}, 2)
    if outcome == gate.REFUSED:
        out({"ok": False, "error": "review_gate_refused", "agent": agent,
             "domain": domain, "task": args.task, "head_sha": args.head_sha,
             "reason": "the review plan for this head does not name "
                       f"{domain}; dispatching it anyway would make the "
                       "planner advisory again (ADR-0091)"}, 3)
    if outcome == gate.EXEMPT:
        # Recorded like a degradation because it is one of the same thing:
        # a dispatch to a review seat that the plan did not authorise. The
        # difference is that someone said so on the record.
        return gate.EXEMPT_GATE, (t, agent, domain, args.task, args.head_sha,
                                  args.repo, outcome, reason)
    if outcome in (gate.DEGRADED, gate.FOREIGN):
        # Decision 3/4: coverage is never reduced by a planner that cannot
        # answer, and never by a repository whose layout the ruleset does not
        # describe -- but neither stays invisible, and neither may masquerade
        # as a verified permit. `fallback`, not the domain.
        return gate.FALLBACK_GATE, (t, agent, domain, args.task, args.head_sha,
                                    args.repo, outcome, reason)
    return domain, None


def cmd_authority_permit_dispatch(cx, args):
    cap = load_capacity(args)
    t = now()
    ttl = args.ttl if args.ttl is not None else cap["authority_permit_ttl_seconds"]
    require_valid_ttl(ttl, "authority permit-dispatch", {"generation": args.generation})
    token = _read_authority_token(args)
    digest, agent = _permit_call_digest(args)
    review_gate, degradation = _review_dispatch_gate(cx, agent, args, t)
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute(
        "SELECT * FROM program_authority WHERE generation=? AND state='active'",
        (args.generation,)).fetchone()
    if not _authority_token_matches(token, row):
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": "wrong token, wrong generation, or expired authority row"}, 3)
    if degradation is not None:
        cx.execute(
            "INSERT INTO review_gate_degradations(recorded_at,agent,domain,"
            "task_id,head_sha,repo,outcome,reason) VALUES(?,?,?,?,?,?,?,?)",
            degradation)
    cur = cx.execute(
        "INSERT INTO program_action_permits(generation,action_digest,expires_at,"
        "review_gate) VALUES(?,?,?,?)",
        (args.generation, digest, t + ttl, review_gate))
    permit_id = cur.lastrowid
    cx.execute("COMMIT")
    out({"ok": True, "permit_id": permit_id, "generation": args.generation,
         "action_digest": digest, "expires_at": t + ttl,
         "review_gate": review_gate})


def cmd_authority_show(cx, args):
    t = now()
    begin(cx)
    expire_stale(cx, t)
    row = cx.execute(
        "SELECT * FROM program_authority WHERE state='active'").fetchone()
    cx.execute("COMMIT")
    if row is None:
        out({"active": False})
    d = dict(row)
    d.pop("token_hash", None)
    out({"active": True, **d})


# ------------------------------------------------------------- sequences ---

def require_sequence_lease(cx, args, action):
    """Refuse a sequence write unless `--resource`'s lease is held by `--holder`.

    Issue #619 / ADR-0089. Lifted out of `cmd_seq_next` UNCHANGED so that
    `cmd_seq_set` gates on exactly the same rule instead of a second, subtly
    different copy of it -- two hand-maintained lease gates in one file drift,
    and the one that drifts is the one nobody is reading. `seq next`'s refusal
    string is preserved byte for byte; `action` is the only thing that varies,
    because "sequence allocation requires ..." is simply false on `seq set`,
    which sets rather than allocates.

    The gate stays OPTIONAL in both callers: no `--resource` means no lease
    requirement. That is what keeps an ad-hoc sequence (`--name adr`) usable
    without first inventing a resource string to lease, while `migrations`
    keeps its serialize-lease discipline.

    COMMIT lands before `out()` because `out()` is `sys.exit` and an open
    `BEGIN IMMEDIATE` would be rolled back on close -- the caller has already
    opened the transaction when this runs.
    """
    if not args.resource:
        return
    # #700/ADR-0084 made `leases` repository-scoped while this helper was in
    # flight. A lease lookup with no repository_id would match another
    # repository's lease on an identically-named resource -- exactly #165's
    # sharpest case -- so the scope resolution main added inline is carried
    # into the helper rather than lost when the two were merged.
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, resource=args.resource)
    row = cx.execute(
        "SELECT holder FROM leases WHERE resource=? AND repository_id=? "
        "AND state='active'",
        (args.resource, repository_id)).fetchone()
    if not row or (args.holder and row["holder"] != args.holder):
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": f"sequence {action} requires holding the lease on "
                       + args.resource,
             "holder": row["holder"] if row else None}, 3)


def cmd_seq_next(cx, args):
    # Issue #619 / ADR-0089 -- ADR numbers are allocated here now, and this
    # comment records what that does and does NOT mean.
    #
    # `--name` is deliberately a free string. `adr` is a CALLER CONVENTION,
    # not a code path: there is no `adr` branch, constant or `choices=`
    # anywhere in this file, and adding one would throw away the generality
    # that made ADR numbering an S-sized task instead of a second allocator.
    #
    # WHAT THIS COUNTER IS BLIND TO, stated plainly so nobody mistakes it for
    # a guarantee it does not make: it never reads `docs/decisions/`,
    # `.omni/adr-drafts/`, `.omni/salvage/`, any worktree, or any open PR. It
    # is SEEDED, not derived -- `--start` is honoured only on first insert,
    # and ADR-0089 seeded `adr` at 76 from a high-water mark of 0075. So it
    # cannot see a number somebody typed by hand and cannot refuse one that is
    # already occupied on disk.
    #
    # That is settled, not an oversight. ADR-0089 splits REFUSE from DETECT.
    # REFUSE lives here, in the database, touching no disk -- which is exactly
    # what makes it monotone, hermetic and fast. DETECT lives in
    # `tests/test_ctl_adr_seq.py`, which scans the checked-out
    # `docs/decisions/` (on a `pull_request` event, the merge commit) for
    # duplicate ids. Do not move DETECT in here: a git or network read inside
    # `BEGIN IMMEDIATE` on the live control plane was ADR-0089 option D, and
    # it was rejected.
    #
    # Numbers get consumed and abandoned when a draft ADR dies, so this
    # sequence WILL grow gaps. Reclaiming them is forbidden (ADR-0089 option
    # C): every retired ADR number is still cited by old reviews and ledgers,
    # so reissuing one converts a citation that fails LOUDLY (dangling) into
    # one that resolves to a real, unrelated document -- #651's defect,
    # manufactured on purpose.
    t = now()
    begin(cx)
    expire_stale(cx, t)
    require_sequence_lease(cx, args, "allocation")
    cx.execute(
        "INSERT INTO sequences(name,next) VALUES(?,?) ON CONFLICT(name) DO NOTHING",
        (args.name, args.start))
    row = cx.execute("SELECT next FROM sequences WHERE name=?", (args.name,)).fetchone()
    value = row["next"]
    cx.execute("UPDATE sequences SET next=? WHERE name=?", (value + 1, args.name))
    cx.execute("COMMIT")
    out({"ok": True, "name": args.name, "value": value})


def cmd_seq_set(cx, args):
    """Set a sequence's next value. CREATE at any value; never LOWER silently.

    Issue #619 / ADR-0089. This is an ADMINISTRATIVE COMMAND ON THE LIVE
    CONTROL PLANE and it was completely ungated: no lease, no authority, an
    unconditional upsert. After the counter had issued 76, `seq set --name adr
    --next 60` silently rewound it and the next `seq next` reissued a number
    already on disk. An allocator whose entire value is "a number cannot be
    hand-picked" was shipping beside a sibling that hand-picks them, so the
    guarantee was false rather than merely incomplete.

    Two narrow changes:

    * the same OPTIONAL `--resource`/`--holder` lease gate `seq next` already
      has, through the shared helper rather than a second copy;
    * LOWERING an existing counter refuses (exit 3) unless `--allow-rewind`.

    CREATING a row at any value stays unconditional, and RAISING stays
    unconditional. That is not laxity -- it is the two paths that must keep
    working. `deploy/nightshift-state-backup.sh:29-30` documents restoring a
    rebuilt box by re-seeding sequences with this command, and a fresh plane
    has no row, so restore CREATES and is untouched. A poisoned counter has no
    other repair route, so `--allow-rewind` keeps that hatch open; it just
    stops rewinding being what happens when nobody meant it.

    `expire_stale` is now called here, as `cmd_seq_next` already does. Without
    it the new lease gate would honour a lease that has TTL-expired but not
    yet been reaped, i.e. gate on a holder who no longer holds anything.
    """
    t = now()
    begin(cx)
    expire_stale(cx, t)
    require_sequence_lease(cx, args, "set")
    row = cx.execute("SELECT next FROM sequences WHERE name=?",
                     (args.name,)).fetchone()
    if row is not None and args.next < row["next"] and not args.allow_rewind:
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": f"refusing to rewind sequence {args.name}: next is "
                       f"{row['next']}, requested {args.next}. Every number "
                       f"from {args.next} to {row['next'] - 1} has already "
                       "been issued, and reissuing one collides with whatever "
                       "is already using it (pass --allow-rewind if that is "
                       "genuinely intended)",
             "name": args.name, "next": row["next"],
             "requested": args.next}, 3)
    cx.execute(
        "INSERT INTO sequences(name,next) VALUES(?,?) "
        "ON CONFLICT(name) DO UPDATE SET next=excluded.next",
        (args.name, args.next))
    cx.execute("COMMIT")
    out({"ok": True, "name": args.name, "next": args.next})


# ------------------------------------------------------------ checkpoints --

# The ONE way this controller runs git against a checkout. A seat can plant
# `<gitlink>/.git/config` with `core.fsmonitor=<cmd>`; git recurses into that
# "populated submodule" to judge dirtiness and runs <cmd> here, outside the
# seat's sandbox. So: no global/system config, no inherited GIT_* (except
# GIT_INDEX_FILE -- the pre-commit guard judges the index git hands it),
# fsmonitor and hooks off, and worktree-reading diffs never recurse.
GIT_HARDENING = ("-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null")
_GIT_ENV_KEEP = frozenset({"GIT_INDEX_FILE"})
_GIT_WORKTREE_DIFF_VERBS = frozenset({"status", "diff", "diff-files", "diff-index"})
_GIT_NETWORK_VERBS = frozenset({"fetch", "push", "ls-remote"})


def _git_env():
    env = {k: v for k, v in os.environ.items()
           if not k.startswith("GIT_") or k in _GIT_ENV_KEEP}
    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1",
               GIT_TERMINAL_PROMPT="0", GIT_NO_REPLACE_OBJECTS="1")
    return env


def _git_argv(repo, argv, hooks_query=False):
    argv = list(argv)
    flags = list(GIT_HARDENING)
    if hooks_query:
        # `rev-parse --git-path hooks` must answer where the committer's git
        # looks, so this one config query keeps the repository's hooksPath.
        flags = flags[:2]
    if argv and argv[0] in _GIT_WORKTREE_DIFF_VERBS and not (
            {"--cached", "--staged"} & set(argv)):
        argv.insert(1, "--ignore-submodules=all")
    if argv and argv[0] in _GIT_NETWORK_VERBS:
        # Global config (and its credential helper) is gone; authenticate
        # through gh, the credential every other GitHub call here uses.
        gh = shlex.quote(os.environ.get("NIGHTSHIFT_CTL_GH", "gh"))
        flags += ["-c", "credential.helper=",
                  "-c", f"credential.helper=!{gh} auth git-credential"]
        if argv[0] == "fetch":
            argv.insert(1, "--no-recurse-submodules")
        elif argv[0] == "push":
            argv.insert(1, "--recurse-submodules=no")
    return ["git", "-C", repo, *flags, *argv]


def _git(repo, *argv):
    return subprocess.run(
        _git_argv(repo, argv), env=_git_env(),
        capture_output=True, text=True, check=True).stdout.strip()


def cmd_checkpoint_create(cx, args):
    sha = args.sha
    if not sha:
        if not args.allow_dirty:
            dirty = subprocess.run(
                _git_argv(args.repo, ("status", "--porcelain", "--",
                                      "docs", ".omni/handoffs")),
                env=_git_env(), capture_output=True, text=True).stdout.strip()
            if dirty:
                out({"ok": False,
                     "reason": "specs/ADRs/handoffs are dirty — commit them first "
                               "so every worker can see the exact version it was "
                               "contracted against",
                     "dirty": dirty.splitlines()}, 3)
        try:
            sha = _git(args.repo, "rev-parse", "HEAD")
        except subprocess.CalledProcessError as e:
            out({"ok": False, "reason": "git rev-parse failed",
                 "stderr": e.stderr.strip()}, 1)
    # #80: a checkpoint must be verifiably CONTAINED in the ref it claims to
    # check point -- otherwise a detached-HEAD checkout (or a stale/explicit
    # --sha) can record a sha that is not on the integration branch at all,
    # and every worker fanned out from it gets a base_sha that does not
    # exist where they will open their PR. --ref is required (ADR-0007 D):
    # a checkpoint with no stated ref is exactly how this happened twice
    # already (wave-3 checkpoints ff39fbb and 27f3915, both ref=NULL).
    mb = subprocess.run(
        _git_argv(args.repo, ("merge-base", "--is-ancestor", sha, args.ref)),
        env=_git_env(), capture_output=True, text=True)
    if mb.returncode != 0:
        if mb.returncode == 1:
            reason = (f"sha {sha} is not on ref {args.ref!r} — refusing to record "
                      "a checkpoint that is not reachable from the ref it claims "
                      "to checkpoint (#80). Check out (or pass --sha for) a commit "
                      "that is actually on that ref.")
        else:
            reason = (f"could not verify sha {sha} against ref {args.ref!r}: "
                      f"{mb.stderr.strip()} — check that --repo and --ref both "
                      "resolve in this repository.")
        out({"ok": False, "reason": reason, "sha": sha, "ref": args.ref}, 2)
    t = now()
    begin(cx)
    cur = cx.execute(
        "INSERT INTO checkpoints(wave,sha,ref,note,created_at) VALUES(?,?,?,?,?)",
        (args.wave, sha, args.ref, args.note, t))
    cid = cur.lastrowid
    cx.execute("COMMIT")
    out({"ok": True, "checkpoint_id": cid, "sha": sha, "wave": args.wave,
         "ref": args.ref})


def cmd_checkpoint_latest(cx, args):
    q = "SELECT * FROM checkpoints"
    params = []
    if args.wave:
        q += " WHERE wave=?"
        params.append(args.wave)
    q += " ORDER BY id DESC LIMIT 1"
    row = cx.execute(q, params).fetchone()
    if row:
        out({"ok": True, "checkpoint": dict(row)})
    out({"ok": False, "reason": "no checkpoint recorded"}, 3)


# ---------------------------------------------------------------- tasks ----

def _cycle_bound_tasks(task_ids, adjacency):
    """Return every vertex in a non-trivial strongly connected component."""
    seen = set()
    finished = []
    for start in sorted(task_ids):
        if start in seen:
            continue
        seen.add(start)
        stack = [(start, iter(sorted(adjacency[start])))]
        while stack:
            node, children = stack[-1]
            try:
                child = next(children)
            except StopIteration:
                finished.append(node)
                stack.pop()
                continue
            if child not in seen:
                seen.add(child)
                stack.append((child, iter(sorted(adjacency[child]))))

    reverse = {task_id: set() for task_id in task_ids}
    for task_id, dependencies in adjacency.items():
        for dependency in dependencies:
            reverse[dependency].add(task_id)

    seen.clear()
    cycle_bound = set()
    for start in reversed(finished):
        if start in seen:
            continue
        component = set()
        stack = [start]
        seen.add(start)
        while stack:
            node = stack.pop()
            component.add(node)
            for parent in sorted(reverse[node], reverse=True):
                if parent not in seen:
                    seen.add(parent)
                    stack.append(parent)
        if len(component) > 1 or start in adjacency[start]:
            cycle_bound.update(component)
    return cycle_bound


# ADR-0032's own completion set for READINESS purposes -- distinct from
# TERMINAL_TASK_STATES below, which is the worktree-reap set and answers a
# different question ("is this task's worktree litter?"). ADR-0032's frozen
# Verification item 8 requires `integrated` to always report `not_pending`,
# but `integrated` is deliberately NOT in TERMINAL_TASK_STATES (an
# integrated task's worktree question is out of that set's scope). Issue
# #215 / ADR-0045 MERGE_BLOCKER-1 (staff, round 1): the new budget_expired
# branch had reused TERMINAL_TASK_STATES and so incorrectly let an ordinary
# fully-shipped, `integrated` task read `budget_expired` once its budget
# window lapsed. `ready`/`building`/`fixing` are deliberately NOT in this
# set -- see ADR-0045 for why an over-budget task in one of those states
# SHOULD read `budget_expired` rather than the generic `not_pending`.
READINESS_TERMINAL_STATES = frozenset(
    {"done", "merged", "dropped", "superseded", "integrated"}
)


def _task_timing(ready_at, started_at, integrated_at):
    """Derive issue #223 AC7's three timing values from the three
    underlying task-lifecycle timestamps.

    Uses the same damaged-value guard (`_is_finite_number`) already
    established for `started_at`/`budget_seconds`/`extension_seconds`
    (issue #215/#217): a missing OR out-of-band timestamp reads as absent,
    never as a bogus subtraction. AC7 is explicit that a not-yet-known
    value is null, never invented -- each derived value requires BOTH of
    its inputs to be present, or it is null.
    """
    ready_ok = _is_finite_number(ready_at)
    started_ok = _is_finite_number(started_at)
    integrated_ok = _is_finite_number(integrated_at)
    return {
        "queue_time": (
            started_at - ready_at if ready_ok and started_ok else None
        ),
        "time_to_main": (
            integrated_at - ready_at if ready_ok and integrated_ok else None
        ),
        "active_delivery_time": (
            integrated_at - started_at if started_ok and integrated_ok else None
        ),
    }


def _task_readiness_snapshot(cx, *, repository_id=None):
    """Derive every ADR-0032 verdict from one coherent full-graph read.

    Issue #423-A / ADR-0063's `on_dod_path`/`linked_conditions` (dormant,
    additive) ride as two correlated subqueries in the SELECT list below,
    not a second `cx.execute` -- this function's single-joined-read
    invariant (see `test_readiness_uses_one_joined_read_and_persists_only_
    ready_at`) is a real property other code depends on, so DoD linkage
    data joins in-statement rather than via its own separate query.

    `repository_id` is keyword-only, defaulting to `None` -- plane-global,
    byte-for-byte the pre-#700 behaviour -- because this function is also
    called with exactly one positional argument from `slot acquire`'s NEW
    gate, the continuation-budget gate, and `task extend`
    (`_task_readiness_snapshot(cx).get(...)`), and is re-exported as
    `task_readiness_snapshot` by deploy/policies/omnipods_policies.py,
    which calls it the same one-positional-arg way. A required positional
    here would break all of those. Only `task ready` (issue #700 follow-up)
    passes an explicit `repository_id`, the same way `task list` resolves
    its own scope (ADR-0084).

    Issue #700 follow-up: the `LEFT JOIN tasks AS p` below carries
    `AND p.repository_id=t.repository_id` UNCONDITIONALLY, not only when
    `repository_id` is given. `cmd_task_dependency_add` already refuses to
    create a cross-repository edge, so on every row any verb can produce
    this predicate is a no-op -- but it makes the read path fail closed
    too, on the same one-in-a-lifetime chance a future write path forgets
    that guard: a forged cross-repository edge resolves `p.id` to NULL,
    which the existing `prerequisite_id is None` rule below already turns
    into `blocked_by`/`blocked_dependency`, and the same NULL keeps the
    edge out of `adjacency`, so `_cycle_bound_tasks` can never find an SCC
    spanning two repositories either.
    """
    query = (
        "SELECT t.*, d.depends_on_task_id AS dependency_id, "
        "p.id AS prerequisite_id, p.state AS prerequisite_state, "
        "(SELECT GROUP_CONCAT(l.condition_id) FROM task_dod_links AS l "
        " WHERE l.task_id=t.id) AS dod_linked_condition_ids, "
        "(SELECT COUNT(*) FROM task_dod_links AS l2 "
        " JOIN dod_conditions AS dc ON dc.condition_id=l2.condition_id "
        " WHERE l2.task_id=t.id AND dc.verdict='FAIL') AS dod_fail_link_count "
        "FROM tasks AS t "
        "LEFT JOIN task_dependencies AS d ON d.task_id=t.id "
        "LEFT JOIN tasks AS p ON p.id=d.depends_on_task_id "
        "AND p.repository_id=t.repository_id "
    )
    params = []
    if repository_id is not None:
        query += "WHERE t.repository_id=? "
        params.append(repository_id)
    query += "ORDER BY t.id,d.depends_on_task_id"
    rows = cx.execute(query, params).fetchall()

    tasks = {}
    dependency_facts = {}
    # started_at is deliberately absent from TASK_FIELDS/TASK_ROW_FIELDS
    # (ADR-0043) so `task upsert` stays structurally incapable of writing
    # it, and is therefore never copied into the exposed per-task dict --
    # kept in its own map instead, read-only, purely for the budget_expired
    # computation below (issue #215 / ADR-0045). This does not change
    # `task show`/`task ready`'s output contract.
    started_ats = {}
    # extension_seconds is likewise deliberately absent from
    # TASK_ROW_FIELDS (issue #217 / ADR-0046) -- same read-only side map,
    # purely for the budget_expired computation below.
    extension_seconds_by_task = {}
    for row in rows:
        task_id = row["id"]
        if task_id not in tasks:
            tasks[task_id] = {field: row[field] for field in TASK_ROW_FIELDS}
            started_ats[task_id] = row["started_at"]
            extension_seconds_by_task[task_id] = row["extension_seconds"]
            # Issue #223 / ADR-0060: unlike started_at/extension_seconds,
            # these three ARE copied into the exposed per-task dict --
            # nothing pre-existing depends on their absence (unlike
            # started_at's established, deliberately-protected output
            # contract noted above), and AC7 asks for them to be readable.
            # Still absent from TASK_FIELDS/TASK_ROW_FIELDS, so `task
            # upsert` stays structurally incapable of writing any of the
            # three directly.
            tasks[task_id]["ready_at"] = row["ready_at"]
            tasks[task_id]["pr_opened_at"] = row["pr_opened_at"]
            tasks[task_id]["integrated_at"] = row["integrated_at"]
            # Issue #165 / ADR-0084: exposed read-only, same precedent as
            # the three lines above -- absent from TASK_FIELDS/
            # TASK_ROW_FIELDS so `task upsert`'s generic whitelist stays
            # structurally incapable of writing it (its own write path,
            # stamp-on-INSERT/refuse-on-conflicting-UPDATE, lives in
            # cmd_task_upsert).
            tasks[task_id]["repository_id"] = row["repository_id"]
            # Issue #423-A / ADR-0063 (dormant, read-only, additive): the
            # two correlated subqueries above are identical across every
            # repeated row for this task_id (they don't depend on the
            # dependency-edge join), so it is safe to read them only on
            # this first-seen branch.
            linked_raw = row["dod_linked_condition_ids"]
            tasks[task_id]["linked_conditions"] = (
                sorted(cid for cid in linked_raw.split(",") if cid)
                if linked_raw else []
            )
            tasks[task_id]["on_dod_path"] = bool(row["dod_fail_link_count"])
            dependency_facts[task_id] = []
        dependency_id = row["dependency_id"]
        if dependency_id is not None:
            dependency_facts[task_id].append(
                (dependency_id, row["prerequisite_id"],
                 row["prerequisite_state"])
            )

    task_ids = set(tasks)
    adjacency = {
        task_id: {
            dependency_id for dependency_id, prerequisite_id, _ in facts
            if prerequisite_id is not None and dependency_id in task_ids
        }
        for task_id, facts in dependency_facts.items()
    }
    cycle_bound = _cycle_bound_tasks(task_ids, adjacency)
    t = now()

    enriched = {}
    for task_id in sorted(tasks):
        task = tasks[task_id]
        facts = dependency_facts[task_id]
        task["depends_on"] = [dependency_id for dependency_id, _, _ in facts]
        task["blocked_by"] = [
            dependency_id
            for dependency_id, prerequisite_id, prerequisite_state in facts
            if prerequisite_id is None or prerequisite_state != "integrated"
        ]
        if task["state"] != "pending":
            # Issue #215 / ADR-0045 (amends this table): a non-terminal,
            # started, over-budget task gets the more specific
            # `budget_expired` reason. Terminal states are checked FIRST so
            # `budget_expired` can never override a terminal verdict (AC6).
            # READINESS_TERMINAL_STATES (ADR-0032's own completion set),
            # NOT TERMINAL_TASK_STATES (the worktree-reap set) -- see the
            # comment on READINESS_TERMINAL_STATES above (MERGE_BLOCKER-1).
            # `_is_finite_number`/`_is_valid_budget_seconds` treat a
            # damaged/out-of-band `started_at`/`budget_seconds` as absent
            # rather than raising or manufacturing an expiry (AC9,
            # MERGE_BLOCKER-2). `dispatchable` stays `False` in every branch
            # here -- only the reason string changes.
            if task["state"] in READINESS_TERMINAL_STATES:
                dispatchable, reason = False, "not_pending"
            elif (
                _is_finite_number(started_ats[task_id])
                and _is_valid_budget_seconds(task["budget_seconds"])
                and t >= (
                    started_ats[task_id] + task["budget_seconds"]
                    # Issue #217 / ADR-0046 (amends this row again): a
                    # committed, valid one-shot extension pushes the
                    # deadline out by exactly its own seconds -- never a
                    # substitute for a budget (AC6). Same damaged-value
                    # guard as budget_seconds itself: a bad/out-of-band
                    # extension_seconds reads as no extension, never a
                    # crash or a bogus expiry.
                    + (
                        extension_seconds_by_task[task_id]
                        if _is_valid_budget_seconds(
                            extension_seconds_by_task[task_id])
                        else 0
                    )
                )
            ):
                dispatchable, reason = False, "budget_expired"
            else:
                dispatchable, reason = False, "not_pending"
        elif task["size"] is None:
            dispatchable, reason = False, "missing_size"
        elif task["size"] not in {"S", "M", "L"}:
            dispatchable, reason = False, "invalid_size"
        elif task["size"] == "L":
            dispatchable, reason = False, "needs_split"
        elif task_id in cycle_bound:
            dispatchable, reason = False, "dependency_cycle"
        elif task["blocked_by"]:
            dispatchable, reason = False, "blocked_dependency"
        else:
            dispatchable, reason = True, "ready"
        # Issue #223 / ADR-0060 AC1: write-on-first-observed-read. This is
        # a shared read function -- `task show`, `task ready`, the
        # continuation-slot verdict lookups, and `task extend` all reach it
        # -- so gating on `reason == "ready"` here, rather than adding a
        # write to each caller, covers every path that can ever observe
        # readiness. Guarded by `WHERE ready_at IS NULL` so a task's FIRST
        # observed-ready moment is recorded exactly once, ever, and is
        # never reset by a later read (AC1's own wording) or a restart
        # (AC6) -- the guard makes exactly-once a property of the
        # statement, not of "this branch only runs once" staying true.
        if reason == "ready" and task["ready_at"] is None:
            cx.execute(
                "UPDATE tasks SET ready_at=? WHERE id=? AND ready_at IS NULL",
                (t, task_id),
            )
            task["ready_at"] = t
        task["dispatchable"] = dispatchable
        task["reason_code"] = reason
        task.update(
            _task_timing(task["ready_at"], started_ats[task_id],
                         task["integrated_at"])
        )
        enriched[task_id] = task
    return enriched


def cmd_task_upsert(cx, args):
    require_valid_budget_seconds(getattr(args, "budget_seconds", None), args.id)
    t = now()
    begin(cx)
    row = cx.execute("SELECT id, repository_id FROM tasks WHERE id=?",
                     (args.id,)).fetchone()
    # Issue #165 / ADR-0084: repository scope is set ONCE, at creation, and
    # is deliberately absent from TASK_FIELDS (same "a field with an
    # at-most-once write invariant is unenforceable if the generic
    # whitelist can also reach it" reasoning as started_at/extension_seconds
    # above) -- so its own write path lives here, not in the generic
    # `fields` loop below. An existing task's scope is immutable: an
    # explicit `--repository-id` that disagrees with what is already on the
    # row is refused outright, before any other check in this function
    # runs. A NEW task (row is None) has its scope resolved and stamped
    # into the INSERT further down.
    explicit_scope = getattr(args, "scope_repository_id", None)
    if row is not None and explicit_scope is not None:
        try:
            explicit_scope = _validate_scope_value(explicit_scope)
        except RepositoryScopeError as exc:
            _scope_out(cx, exc, task=args.id)
        if explicit_scope != row["repository_id"]:
            cx.execute("COMMIT")
            out({"ok": False,
                 "reason": _SCOPE_REASON_TEXT["repository_scope_immutable"],
                 "reason_code": "repository_scope_immutable",
                 "task": args.id, "repository_id": explicit_scope,
                 "existing_repository_id": row["repository_id"]}, 3)
    # Issue #488 (AC2): --seed-shared-admission resolves against whatever task
    # row already exists BEFORE this call's own field updates are applied. A
    # task that does not exist yet gets no insert of any kind under this
    # flag -- seeding is strictly a follow-up operation on an already-charted
    # task, never a way to charter one.
    if getattr(args, "seed_shared_admission", False) and row is None:
        cx.execute("COMMIT")
        out({"ok": False, "task": args.id, "reason": "task_missing"}, 3)
    fields = {k: getattr(args, k) for k in TASK_FIELDS if getattr(args, k) is not None}
    # security round-1 MERGE_BLOCKER (PR #530): a same-call TOCTOU. Before this
    # check, `task upsert --id T --crew product --seed-shared-admission` on a
    # REAL crew_alpha/crew_beta task T would apply `crew='product'` in the
    # UPDATE below, then `_seed_shared_admission` re-read the row AFTER that
    # update and saw the now-forged crew -- seeding admission for a task that
    # was never legitimately a shared-function task, then a second, separate
    # `task upsert --id T --crew crew_alpha` call could flip it back, leaving
    # a crew_alpha/crew_beta task holding admission AC3 exists specifically to
    # deny it. `--seed-shared-admission` is now refused outright if this same
    # call also tries to change any other field -- it only ever reads a row
    # some EARLIER, already-committed call produced, never one it is about to
    # write itself in the same transaction.
    if getattr(args, "seed_shared_admission", False) and fields:
        cx.execute("COMMIT")
        out({"ok": False, "task": args.id, "reason": (
            "--seed-shared-admission must be the only change requested in this "
            f"call (also received: {', '.join(sorted(fields))}) -- combining it "
            "with a field update in the same call would let that update's new "
            "value (e.g. --crew) be read back by the admission check before "
            "anyone else observes it, a same-call TOCTOU. Commit the field "
            "change as its own `task upsert` call first, then seed separately."
        )}, 3)
    if row:
        if fields:
            sets = ", ".join(f"{k}=?" for k in fields)
            cx.execute(f"UPDATE tasks SET {sets}, updated_at=? WHERE id=?",
                       list(fields.values()) + [t, args.id])
    else:
        try:
            new_repository_id = resolve_scope(cx, args, task_row=None)
        except RepositoryScopeError as exc:
            _scope_out(cx, exc, task=args.id)
        fields.setdefault("state", "pending")
        cols = ["id"] + list(fields) + ["repository_id", "created_at", "updated_at"]
        vals = [args.id] + list(fields.values()) + [new_repository_id, t, t]
        cx.execute(
            f"INSERT INTO tasks({','.join(cols)}) VALUES({','.join('?'*len(vals))})",
            vals)
    # Issue #223 / ADR-0060 AC3/AC4: guarded first-write, same idiom as
    # started_at/extension_seconds -- `WHERE <col> IS NULL` inside this
    # same transaction, never a separate connection or a raw settable
    # `task upsert` flag (ready_at/pr_opened_at/integrated_at are all
    # absent from TASK_FIELDS). Runs for BOTH the UPDATE and INSERT
    # branches above so a task created with a pr_url/integrated state
    # already set (e.g. a backfill) still gets its first-observed
    # timestamp, not just tasks that transition into it later.
    if "pr_url" in fields:
        # AC3: the control plane first learns this task's delivery PR
        # exists. `task upsert --pr-url ...` is one of the two DoR-accepted
        # hook points; `pr-head`/`pr-create` are read-only/exec-only today
        # and touch no task row, so wiring this one alone is sufficient and
        # first-write-wins makes adding the other safe later.
        cx.execute(
            "UPDATE tasks SET pr_opened_at=? WHERE id=? AND pr_opened_at IS NULL",
            (t, args.id),
        )
    if fields.get("state") == "integrated":
        # AC4: task state first reaches 'integrated'.
        cx.execute(
            "UPDATE tasks SET integrated_at=? WHERE id=? AND integrated_at IS NULL",
            (t, args.id),
        )
    seed_result = None
    if getattr(args, "seed_shared_admission", False):
        seed_result = _seed_shared_admission(cx, args.id, t)
        if seed_result.get("ok") is False:
            cx.execute("COMMIT")
            out(seed_result, 3)
    cx.execute("COMMIT")
    row = cx.execute("SELECT * FROM tasks WHERE id=?", (args.id,)).fetchone()
    payload = {"ok": True, "task": dict(row)}
    if seed_result is not None:
        payload.update(seed_result)
    out(payload)


def _seed_shared_admission(cx, task_id, t):
    """Issue #488 / ADR-0068 addendum.

    Supplies the ONE thing a `nightshift-ctl task upsert`-charted task can
    never earn on its own: a `task_admissions` row, which
    `worker_semaphore`'s continuation branch (deploy/policies/omnipods_
    policies.py) hard-requires (`admission is not None`) before ANY
    `reviewer_*`/`qa` continuation slot can be classified for it, regardless
    of that continuation's own role-specific checks. That row is otherwise
    written in exactly one place -- worker_semaphore's `phase=='new'` branch
    -- reachable only via a genuine counted `eng_*` NEW dispatch, which no
    shared-function seat (SHARED_FUNCTION_CREWS) ever performs.

    Always returns a dict merged into (denial) or added onto (success) the
    caller's response; `ok: False` tells the caller to COMMIT and emit it
    directly instead of the normal success payload (AC2-AC4 denial paths).

    Deliberately does NOT touch `tasks.state` (AC4) or run for
    crew_alpha/crew_beta (AC3) -- this function's entire blast radius is
    "supply the missing lineage row for a task that already exists, already
    belongs to a shared-function seat, and is already in a continuation-
    eligible state."
    """
    task = cx.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
    if task["crew"] not in SHARED_FUNCTION_CREWS:
        return {
            "ok": False, "task": task_id,
            "reason": (
                f"task {task_id} belongs to crew '{task['crew']}', not a "
                "shared-function seat -- crew_alpha/crew_beta tasks must "
                "earn task_admissions through real dispatch-time admission "
                "(worker_semaphore phase=='new'), never this flag"
            ),
        }
    if task["state"] not in {"building", "ready", "fixing"}:
        return {
            "ok": False, "task": task_id,
            "reason": (
                f"task {task_id} is in state '{task['state']}', not "
                "building/ready/fixing -- continuation dispatch is denied "
                "regardless of admission, so seeding now would write a row "
                "nothing can use yet; run `task upsert --state building` "
                "(or equivalent) first"
            ),
        }
    existing = _active_admission(cx, task_id)
    if existing is not None:
        # AC5: idempotent no-op -- no second INSERT (task_admissions.task_id
        # is a PRIMARY KEY; a raw second INSERT would raise, not degrade
        # cleanly).
        return {"created": False, "task_admissions": dict(existing)}
    slot_id = cx.execute(
        "INSERT INTO worker_slots("
        "holder,crew,task_id,kind,state,acquired_at,released_at,"
        "phase,continuation_kind,generation) "
        "VALUES(?,?,?,'seed','released',?,?,NULL,NULL,0)",
        (task["agent"], task["crew"], task_id, t, t),
    ).lastrowid
    cx.execute(
        "INSERT INTO task_admissions("
        "task_id,new_slot_id,crew,agent,title,admitted_at) "
        "VALUES(?,?,?,?,?,?)",
        (task_id, slot_id, task["crew"], task["agent"], task["title"], t),
    )
    admission = cx.execute(
        "SELECT * FROM task_admissions WHERE task_id=?", (task_id,)
    ).fetchone()
    return {
        "created": True, "slot_id": slot_id,
        "task_admissions": dict(admission),
    }


def cmd_task_show(cx, args):
    tasks = _task_readiness_snapshot(cx)
    if args.id in tasks:
        out({"ok": True, "task": tasks[args.id]})
    out({"ok": False, "reason": "unknown task"}, 3)


def cmd_task_list(cx, args):
    # Read-only and, before ADR-0084, never inside a transaction -- kept
    # that way: resolving scope is a single SELECT against `meta`, with no
    # write of its own to protect, so it needs no BEGIN IMMEDIATE around it
    # (unlike every write path above, which resolves scope INSIDE its own
    # transaction).
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, commit=False)
    q, params = "SELECT * FROM tasks", [repository_id]
    conds = ["repository_id=?"]
    if args.issue is not None:
        conds.append("issue=?")
        params.append(args.issue)
    if args.crew:
        conds.append("crew=?")
        params.append(args.crew)
    q += " WHERE " + " AND ".join(conds)
    rows = cx.execute(q + " ORDER BY created_at", params).fetchall()
    out({"tasks": [dict(r) for r in rows]})


def cmd_task_ready(cx, args):
    # Issue #700 follow-up: this is the dispatch-selection verb (per
    # program/config.yaml, "task ready governs which REGISTERED task is
    # dispatchable"), so it resolves scope exactly like `task list` does
    # above -- same `resolve_scope` call, same `--repository-id` flag/dest,
    # same refusal idiom -- so the two verbs cannot disagree about which
    # repository's tasks are visible. Resolved BEFORE the snapshot runs,
    # so a refused scope stamps `ready_at` (ADR-0060 AC1) on nothing.
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, commit=False)
    tasks = _task_readiness_snapshot(cx, repository_id=repository_id)
    out({"tasks": [task for task in tasks.values() if task["dispatchable"]]})


def cmd_task_dependency_add(cx, args):
    if args.id == args.depends_on:
        out({"ok": False, "reason": "task cannot depend on itself"}, 2)

    begin(cx)
    task = cx.execute("SELECT id, repository_id FROM tasks WHERE id=?",
                      (args.id,)).fetchone()
    if task is None:
        cx.execute("ROLLBACK")
        out({"ok": False, "reason": "unknown task"}, 3)
    prerequisite = cx.execute(
        "SELECT id, repository_id FROM tasks WHERE id=?", (args.depends_on,)
    ).fetchone()
    if prerequisite is None:
        cx.execute("ROLLBACK")
        out({"ok": False, "reason": "unknown prerequisite task"}, 3)
    # Issue #165 / ADR-0084: this is what pays for `repository_id` on
    # `task_dependencies` -- without this guard the column would be dead
    # weight. `tasks.id` is a plane-global PRIMARY KEY (IndexPremise), so a
    # dependency edge between two tasks in different repositories can only
    # ever be a mistake, never a legitimate cross-repository relationship.
    if task["repository_id"] != prerequisite["repository_id"]:
        cx.execute("ROLLBACK")
        out({"ok": False,
             "reason": _SCOPE_REASON_TEXT["cross_repository_dependency"],
             "reason_code": "cross_repository_dependency",
             "task_repository_id": task["repository_id"],
             "depends_on_repository_id": prerequisite["repository_id"]}, 3)

    inserted = cx.execute(
        "INSERT INTO task_dependencies(task_id,depends_on_task_id,repository_id) "
        "VALUES(?,?,?) ON CONFLICT(task_id,depends_on_task_id) DO NOTHING",
        (args.id, args.depends_on, task["repository_id"]),
    ).rowcount == 1
    cx.execute("COMMIT")
    out({
        "ok": True,
        "created": inserted,
        "dependency": {"task_id": args.id,
                       "depends_on_task_id": args.depends_on},
    })


def cmd_task_extend(cx, args):
    """One durable, bounded extension for an expired task. Issue #217 / ADR-0046.

    Ordering (AC4d), deliberately in this order so an already-invalid
    request keeps its own most specific denial: AC2 (--seconds shape) ->
    AC3 (--reason shape) -- both checked before any transaction opens,
    same discipline `cmd_task_upsert` already uses for
    `require_valid_budget_seconds` -- then, inside one transaction,
    AC4c (task exists) -> AC4b (currently budget_expired) -> AC4a (not
    already extended) -> commit.
    """
    # AC2: reuses _is_valid_budget_seconds directly (finite AND > 0) --
    # the exact same corruption class ADR-0008/#215 guard against, not a
    # reimplementation of the predicate.
    if not _is_valid_budget_seconds(args.seconds):
        out({
            "ok": False,
            "reason": (
                f"--seconds must be a finite positive number of seconds; "
                f"got {args.seconds!r}. A negative, zero, or non-finite "
                f"(inf/-inf/nan) extension does not shorten the escape "
                f"hatch -- it grants an instantly-expired one, an "
                f"unbounded one, or one that never compares at all."
            ),
            "verb": "task extend",
            "id": args.id,
            "seconds": args.seconds,
        }, 2)
    # AC3: required at the argparse level (dest="reason", no default) and
    # non-empty after stripping -- same usage-error class as AC2 (shape of
    # the request is wrong, not state-dependent).
    reason_text = (args.reason or "").strip()
    if not reason_text:
        out({
            "ok": False,
            "reason": (
                "--reason must be a non-empty string explaining why this "
                "extension is needed; it is stored durably as part of the "
                "one-shot extension record (AC3)."
            ),
            "verb": "task extend",
            "id": args.id,
        }, 2)

    begin(cx)
    row = cx.execute("SELECT * FROM tasks WHERE id=?", (args.id,)).fetchone()
    if row is None:
        # AC4c -- same shape cmd_task_show already uses for the same fact.
        cx.execute("COMMIT")
        out({"ok": False, "granted": False, "reason": "unknown task",
             "task_id": args.id}, 3)

    # AC4b: only a task whose CURRENT reason_code is exactly
    # "budget_expired" may be extended -- read through the same shared,
    # aliased snapshot function #216 already froze this string-equality
    # discipline for, not a locally reimplemented expiry test that could
    # drift from it.
    verdict = _task_readiness_snapshot(cx).get(args.id)
    if not verdict or verdict["reason_code"] != "budget_expired":
        cx.execute("COMMIT")
        out({
            "ok": False,
            "granted": False,
            "reason": (
                "task extend is only valid for a task whose budget has "
                "already expired; this task's current reason_code is "
                f"{(verdict or {}).get('reason_code', 'unknown_task')!r}, "
                "not 'budget_expired'"
            ),
            "task_id": args.id,
            "reason_code": "not_budget_expired",
        }, 3)

    # AC4a: exactly one extension per task, ever -- holds regardless of
    # whether the prior extension has itself since expired (AC7). Checked
    # last so a task that both fails AC4b AND has already been extended
    # reports the more specific "not currently expired" reason, matching
    # the ordering discipline #216 froze for its own two checks.
    if row["extension_seconds"] is not None:
        cx.execute("COMMIT")
        out({
            "ok": False,
            "granted": False,
            "reason": "task has already received its one extension",
            "task_id": args.id,
            "reason_code": "already_extended",
        }, 3)

    t = now()
    cx.execute(
        "UPDATE tasks SET extension_seconds=?, extension_reason=?, "
        "extended_at=? WHERE id=?",
        (args.seconds, reason_text, t, args.id),
    )
    cx.execute("COMMIT")
    row = cx.execute("SELECT * FROM tasks WHERE id=?", (args.id,)).fetchone()
    # AC9: surface what was recorded so a caller can confirm the write
    # without a raw SQL read -- `extension_seconds`/`extension_reason`/
    # `extended_at` are deliberately NOT added to TASK_ROW_FIELDS (AC1),
    # so this success payload is their only CLI-visible surface.
    out({
        "ok": True,
        "granted": True,
        "task_id": args.id,
        "extension_seconds": row["extension_seconds"],
        "extension_reason": row["extension_reason"],
        "extended_at": row["extended_at"],
        "effective_budget_seconds": (
            (row["budget_seconds"] or 0.0) + row["extension_seconds"]
        ),
    })


# -------------------------------------------------------------------- dod --
# Issue #423-A / ADR-0063. Non-gating: nothing here changes what any
# command admits or denies -- it only makes DoD close-out data visible and
# computable ahead of #423-C's later activation.

_DOD_VALID_VERDICTS = ("PASS", "FAIL", "BLOCKED", "MANUAL")


def cmd_dod_ingest(cx, args):
    """Upsert `dod_conditions` from a `dod_validate.py --json` payload.

    Deliberately never shells out to `dod_validate.py` itself -- that
    script makes its own git/gh subprocess calls and is a possible-timeout
    dependency (confirmed: it hung past 90s in this sandbox's network
    conditions). This command only ever consumes JSON handed to it, via
    stdin (the default, matching the pipe `python3 tests/dod_validate.py
    --json | nightshift-ctl dod ingest`) or a file with `--from PATH`.

    AC-3: idempotent by condition_id -- an UPSERT, never an INSERT, so
    ingesting the same payload twice leaves `dod_conditions` content-
    identical (same row values), not duplicated.
    """
    if args.from_path:
        try:
            raw = open(args.from_path, "r", encoding="utf-8").read()
        except OSError as e:
            out({"ok": False, "reason": f"cannot read {args.from_path!r}: {e}"}, 2)
    else:
        raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as e:
        out({"ok": False, "reason": f"malformed JSON payload: {e}"}, 2)
    conditions = payload.get("conditions") if isinstance(payload, dict) else None
    if not isinstance(conditions, list):
        out({"ok": False,
             "reason": "payload has no top-level 'conditions' list "
                       "(expected dod_validate.py --json's own shape)"}, 2)

    t = now()
    run_id = _current_control_run_id(cx)
    begin(cx)
    ingested = 0
    for record in conditions:
        if not isinstance(record, dict):
            cx.execute("ROLLBACK")
            out({"ok": False,
                 "reason": f"condition record is not an object: {record!r}"}, 2)
        cid = record.get("id")
        verdict = record.get("verdict")
        if not isinstance(cid, str) or not cid or verdict not in _DOD_VALID_VERDICTS:
            cx.execute("ROLLBACK")
            out({"ok": False,
                 "reason": f"condition record has a missing/non-string id or "
                           f"invalid verdict {verdict!r}: {record!r}"}, 2)
        # AC-3 idempotency (round-1 review MERGE_BLOCKER, PR #487, option 1 of
        # architect's 2026-09-01T13:35:23Z comment; #489 was the dispatch-slot
        # defect that blocked routing this, not a cause of the bug itself):
        # ingested_at/run_id are OBSERVATIONAL, not part of a
        # condition's semantic identity. Re-ingesting byte-identical input must leave
        # dod_conditions content-identical, including these two columns -- they may
        # only advance when verdict/reason/blocking_artifact actually change. `IS`
        # (not `=`) so a NULL blocking_artifact compares equal to itself rather than
        # evaluating the whole predicate to NULL.
        cx.execute(
            "INSERT INTO dod_conditions("
            "condition_id,verdict,reason,blocking_artifact,ingested_at,run_id) "
            "VALUES(?,?,?,?,?,?) "
            "ON CONFLICT(condition_id) DO UPDATE SET "
            "verdict=excluded.verdict, reason=excluded.reason, "
            "blocking_artifact=excluded.blocking_artifact, "
            "ingested_at=CASE WHEN excluded.verdict IS verdict "
            "AND excluded.reason IS reason "
            "AND excluded.blocking_artifact IS blocking_artifact "
            "THEN ingested_at ELSE excluded.ingested_at END, "
            "run_id=CASE WHEN excluded.verdict IS verdict "
            "AND excluded.reason IS reason "
            "AND excluded.blocking_artifact IS blocking_artifact "
            "THEN run_id ELSE excluded.run_id END",
            (cid, verdict, record.get("reason") or "",
             record.get("blocking_artifact"), t, run_id),
        )
        ingested += 1
    cx.execute("COMMIT")
    out({"ok": True, "ingested": ingested})


def cmd_dod_heartbeat_line(cx, args):
    """Record one DoD heartbeat observation and report the delta line (AC-6).

    `now` is the current PASS count across the last-ingested `dod_conditions`
    snapshot (0 if nothing has ever been ingested). `prev` is the most
    recently recorded observation's own `pass_count` (not an assumed
    baseline) -- the FIRST ever observation has no prior row, so its delta
    is reported against 0 and is never itself treated as an escalation
    (there is no second occurrence yet). `escalated` is true iff this
    observation's delta is 0 AND the immediately preceding observation's
    delta was also 0 -- the second consecutive zero-delta heartbeat, not
    the first (AC-6's own wording).
    """
    now_count = cx.execute(
        "SELECT COUNT(*) AS n FROM dod_conditions WHERE verdict='PASS'"
    ).fetchone()["n"]

    t = now()
    begin(cx)
    prior = cx.execute(
        "SELECT pass_count, delta FROM dod_heartbeat_observations "
        "ORDER BY id DESC LIMIT 1"
    ).fetchone()
    prev_count = prior["pass_count"] if prior is not None else 0
    delta = now_count - prev_count
    escalated = bool(
        prior is not None and prior["delta"] == 0 and delta == 0
    )
    cx.execute(
        "INSERT INTO dod_heartbeat_observations("
        "observed_at,pass_count,delta,escalated) VALUES(?,?,?,?)",
        (t, now_count, delta, 1 if escalated else 0),
    )
    cx.execute("COMMIT")
    out({
        "ok": True,
        "prev": prev_count,
        "now": now_count,
        "delta": delta,
        "total": 24,
        "escalated": escalated,
        "line": f"DoD {prev_count}/24 -> {now_count}/24 (delta {delta})",
    })


# ---------------------------------------------------------------- issues ---

def _latest_applied_disposition(cx, issue):
    """The most recent CONFIRMED disposition for an issue, or None.

    Intent rows (`applied_at IS NULL`) are deliberately invisible here: a
    close that never reached GitHub must not change what the queue scan
    reports, or a crashed close would silently drop work out of the queue --
    the precise failure #424 exists to stop, arrived at from the other side.
    """
    return cx.execute(
        "SELECT disposition, deferred_to, recorded_at, applied_at "
        "FROM issue_close_dispositions "
        "WHERE issue=? AND applied_at IS NOT NULL "
        "ORDER BY applied_at DESC, id DESC LIMIT 1", (issue,)).fetchone()


def _issue_status(cx, issue):
    rows = cx.execute("SELECT id, state FROM tasks WHERE issue=?", (issue,)).fetchall()
    states = {r["id"]: r["state"] for r in rows}
    active = [s for s in states.values() if s != "dropped"]
    closable = bool(active) and all(s == "integrated" for s in active)
    status = {"issue": issue, "tasks": states, "closable": closable,
              "note": None if rows else "no tasks recorded for this issue"}
    # AC-4 (#424 / ADR-0055). Deferred work STAYS IN THE QUEUE SCAN. An issue
    # parked at a milestone is still owed; reporting it as closable is how
    # deferred work disappears, which is half of what the 2026-08-26 batch
    # actually did. Consistent with AC-3: "a deferred issue is not counted as
    # closed by any Nightshift-side reporting."
    latest = _latest_applied_disposition(cx, issue)
    if latest is not None:
        status["disposition"] = latest["disposition"]
        if latest["disposition"] == "deferred":
            status["closable"] = False
            status["reason"] = "deferred-stays-in-queue"
            status["deferred_to"] = latest["deferred_to"]
    return status


def cmd_issue_status(cx, args):
    st = _issue_status(cx, args.issue)
    out(st, 0 if st["closable"] else 3)


def cmd_issue_closable(cx, args):
    rows = cx.execute(
        "SELECT DISTINCT issue FROM tasks WHERE issue IS NOT NULL").fetchall()
    closable = [r["issue"] for r in rows if _issue_status(cx, r["issue"])["closable"]]
    out({"closable": sorted(closable)})


# ------------------------------------------- issue close gateway (#424) ---
#
# ADR-0055. Every close goes through here so that the DISPOSITION is recorded
# before the GitHub write, never after and never instead. The 2026-08-26
# incident this exists to prevent closed 62 issues inside one 60-second
# window, sweeping three P0s (#118, #129, #158) with it; #158 got no closing
# comment at all.
#
# Two properties carry the design, and both are orderings rather than checks:
#   * every refusal happens BEFORE any GitHub call, so a rejected close is
#     indistinguishable from one that was never attempted;
#   * the local row is written BEFORE the GitHub write and confirmed after,
#     so the only crash residue is a visible stale intent row -- never a
#     closed-but-undisposed issue, and never a phantom delivery in the report.

# AC-1. Anchored, case-sensitive, MULTILINE. The loose form finds CANDIDATE
# lines so "no disposition at all" stays distinguishable from "a disposition
# line that does not parse"; the strict form is the grammar itself.
DISPOSITION_LINE_RE = re.compile(r"^Disposition:.*$", re.M)
DISPOSITION_RE = re.compile(
    r"^Disposition: (?:delivered|superseded-by #(\d+)|deferred-to (M\d+))$",
    re.M)
DISPOSITION_FORMS = (
    "Disposition: delivered",
    "Disposition: superseded-by #<N>",
    "Disposition: deferred-to M<N>",
)
# AC-5. A commit OID, a PR/issue reference, or a test id -- something a reader
# can go and check. Prose is deliberately not evidence.
EVIDENCE_RE = re.compile(r"^(?:[0-9a-f]{40}|#\d+|test:[A-Za-z0-9_.:/\-]+)$")
# F-1 (cross-crew review of PR #450, corroborated by `security`). `--actor` is
# interpolated into the PUBLIC close-comment body, so it is operator-supplied
# text landing in a permanent GitHub artifact. Unvalidated, an actor carrying a
# newline injects a second `Disposition:` line into that artifact -- and the
# forgery is not merely cosmetic: feeding the posted body back through
# `_parse_disposition` returns `disposition_ambiguous`, i.e. THIS COMMAND CAN
# WRITE A COMMENT ITS OWN PARSER REFUSES TO READ. That is a direct breach of
# ADR-0055 s2's invariant that the posted comment and the stored row cannot
# disagree, reachable on every close through a required flag.
#
# Constrained by allowlist rather than by blocklisting \r\n, on the same
# reasoning as EVIDENCE_RE: an allowlist also keeps backticks and markdown out
# of a public artifact, and it fails closed on the next character nobody
# thought about. ASCII is spelled out rather than using \w so a unicode
# homoglyph cannot impersonate a seat name.
ACTOR_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_./@-]{0,63}$")
# Matched case-insensitively: a `p0` label must gate exactly as `P0` does.
# Fail-closed -- the cost of an extra evidence string is trivial next to the
# cost of sweeping a live P0.
SENSITIVE_LABELS = frozenset({"p0", "security"})
BULK_CLOSE_LIMIT = 3
BULK_CLOSE_WINDOW_SECONDS = 60.0
# AC-3. This repo has ZERO GitHub Milestone objects (`gh api .../milestones`
# -> []). The `## M<N>` headers in docs/prd/MILESTONES.md are the only real
# milestone registry, so that file is what gets validated against.
MILESTONE_HEADER_RE = re.compile(r"^##\s+(M\d+)\b", re.M)
MILESTONES_RELPATH = os.path.join("docs", "prd", "MILESTONES.md")
STATE_REASON_BY_DISPOSITION = {
    "delivered": "COMPLETED",
    # NOT the ADR's drafted DUPLICATE: see GH_CLOSE_REASON below.
    "superseded": "NOT_PLANNED",
    "deferred": "NOT_PLANNED",
}
# `gh issue close --reason` accepts only these two (gh 2.45.0, verified by
# `gh issue close --help` at build time), and GitHub's REST state_reason enum
# is {completed, not_planned, reopened} -- neither can express DUPLICATE.
# Writing "not planned" while recording DUPLICATE would break the one
# invariant this command is built on (the row and GitHub never disagree), so
# DUPLICATE is refused at the door instead.
GH_CLOSE_REASON = {"COMPLETED": "completed", "NOT_PLANNED": "not planned"}


def _parse_disposition(raw):
    """AC-1: exactly one disposition, or a named refusal.

    Accepts either the bare value (`delivered`) or a full comment body
    containing the `Disposition:` line, so the operator can hand over either
    and the CLI still composes the posted comment itself -- the posted text
    and the stored row are generated from ONE value and cannot disagree.

    Returns (parsed, error). Exactly one is None.
    """
    text = (raw or "").strip()
    if not text:
        return None, {"error": "disposition_missing",
                      "reason": "a close must state exactly one disposition",
                      "legal_forms": list(DISPOSITION_FORMS)}
    if not DISPOSITION_LINE_RE.search(text):
        text = "Disposition: " + text
    candidates = DISPOSITION_LINE_RE.findall(text)
    if len(candidates) > 1:
        return None, {"error": "disposition_ambiguous",
                      "reason": ("a close states EXACTLY one disposition; "
                                 f"found {len(candidates)}"),
                      "found": candidates}
    match = DISPOSITION_RE.search(text)
    if match is None:
        return None, {"error": "disposition_unparseable",
                      "reason": "the disposition line does not match the grammar",
                      "found": candidates[0],
                      "legal_forms": list(DISPOSITION_FORMS)}
    superseded_by, deferred_to = match.group(1), match.group(2)
    if superseded_by is not None:
        parsed = {"disposition": "superseded",
                  "superseded_by": int(superseded_by), "deferred_to": None}
    elif deferred_to is not None:
        parsed = {"disposition": "deferred",
                  "superseded_by": None, "deferred_to": deferred_to}
    else:
        parsed = {"disposition": "delivered",
                  "superseded_by": None, "deferred_to": None}
    parsed["line"] = match.group(0)
    return parsed, None


def _repo_root_for(args):
    """The project root, derived from the control plane's own location.

    `.omni/control.db` sits at the root, so this resolves correctly from a
    worktree and under the test harness alike, with no new flag and no CWD
    dependence.
    """
    return os.path.dirname(os.path.dirname(os.path.abspath(args.db)))


def _known_milestones(root):
    path = os.path.join(root, MILESTONES_RELPATH)
    try:
        with open(path, encoding="utf-8") as handle:
            body = handle.read()
    except OSError as exc:
        return None, path, str(exc)
    return sorted(set(MILESTONE_HEADER_RE.findall(body)),
                  key=lambda m: int(m[1:])), path, None


def _gh_issue_view(gh, number, fields):
    """Live read of one issue. Never cached -- AC-2 says "at the time of the
    close", and a cache makes that claim unfalsifiable (ADR-0055 option E).

    Returns (data, error). The error triad is the one already established by
    `cmd_pr_head`: gh_binary_missing / gh_api_failed / parse_failed.
    """
    try:
        result = subprocess.run(
            [gh, "issue", "view", str(number), "--json", fields],
            capture_output=True, text=True, check=True)
        return json.loads(result.stdout), None
    except (FileNotFoundError, OSError) as exc:
        return None, {"error": "gh_binary_missing", "gh_path": gh,
                      "details": str(exc)}
    except subprocess.CalledProcessError as exc:
        return None, {"error": "gh_api_failed", "issue": number,
                      "stderr": (exc.stderr or "").strip()}
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        return None, {"error": "parse_failed", "issue": number,
                      "details": str(exc)}


_GH_NOT_FOUND_RE = re.compile(
    r"could not resolve|not found|no issue found", re.IGNORECASE)


def _compose_close_comment(parsed, evidence, actor):
    """The CLI composes the comment; the operator never hands one in.

    This is what makes AC-1 hold by construction: there is exactly one source
    for both the posted text and `comment_body`, so they cannot drift.
    """
    lines = [parsed["line"], ""]
    if evidence:
        lines.append(f"Evidence: {evidence}")
    lines.append(f"Closed by: {actor} (via `nightshift-ctl issue close`, ADR-0055)")
    body = "\n".join(lines) + "\n"

    # Belt and braces for F-1. `--actor` is validated at the door, so this
    # should be unreachable -- it is here because the invariant must not depend
    # on every FUTURE interpolated field remembering to validate itself. The
    # property ADR-0055 s2 actually claims is structural ("exactly one
    # disposition line in the artifact"), so assert that property directly on
    # the composed text rather than trusting the inputs that built it.
    found = DISPOSITION_LINE_RE.findall(body)
    if len(found) != 1:
        return None, {"error": "comment_composition_failed",
                      "reason": ("the composed comment does not carry exactly "
                                 f"one disposition line (found {len(found)}); "
                                 "refusing to post an artifact this command's "
                                 "own parser would reject"),
                      "found": found}
    return body, None


def _refuse(payload, **extra):
    payload = dict(payload)
    payload.update(extra)
    payload.setdefault("ok", False)
    payload.setdefault("closed", False)
    out(payload, 3)


def cmd_issue_close(cx, args):
    gh = os.environ.get("NIGHTSHIFT_CTL_GH", "gh")
    t = now()

    # -- 1. grammar (AC-1) ------------------------------------------------
    parsed, err = _parse_disposition(args.disposition)
    if err:
        _refuse(err, issue=args.issue)

    # -- 1b. actor is public, permanent text (F-1) -------------------------
    # Checked here, before the GitHub read, because it is the cheapest refusal
    # and a malformed actor should never cost an API call.
    if not ACTOR_RE.fullmatch(args.actor or ""):
        _refuse({"error": "actor_malformed",
                 "reason": ("--actor is interpolated into the public close "
                            "comment, so it must be an identifier: 1-64 chars "
                            "of [A-Za-z0-9_./@-] starting alphanumeric. A "
                            "newline here forges a second `Disposition:` line "
                            "in a permanent GitHub artifact."),
                 "actor": args.actor}, issue=args.issue)

    # -- 2. milestone registry (AC-3) -------------------------------------
    if parsed["disposition"] == "deferred":
        known, path, read_err = _known_milestones(_repo_root_for(args))
        if read_err is not None:
            _refuse({"error": "milestone_registry_unreadable",
                     "reason": f"cannot read the milestone registry: {read_err}",
                     "path": path}, issue=args.issue)
        if parsed["deferred_to"] not in known:
            _refuse({"error": "milestone_unknown",
                     "reason": (f"{parsed['deferred_to']} is not a milestone in "
                                f"{MILESTONES_RELPATH}"),
                     "milestone": parsed["deferred_to"],
                     "known_milestones": known,
                     "path": path}, issue=args.issue)

    # -- 3. live GitHub read (never a cache) ------------------------------
    target, err = _gh_issue_view(gh, args.issue, "number,state,labels")
    if err:
        _refuse(err, issue=args.issue,
                reason="the close is refused, not attempted-and-assumed")
    labels = {
        (lab.get("name") or "").strip().lower()
        for lab in (target.get("labels") or [])
        if isinstance(lab, dict)
    }
    if (target.get("state") or "").upper() == "CLOSED":
        _refuse({"error": "already_closed",
                 "reason": "this issue is already closed on GitHub"},
                issue=args.issue)

    # -- 4. supersede target exists and is OPEN NOW (AC-2) ----------------
    if parsed["disposition"] == "superseded":
        target_n = parsed["superseded_by"]
        if target_n == args.issue:
            _refuse({"error": "supersede_self",
                     "reason": "an issue cannot supersede itself",
                     "superseded_by": target_n}, issue=args.issue)
        other, err = _gh_issue_view(gh, target_n, "number,state")
        if err:
            if err["error"] == "gh_api_failed" and _GH_NOT_FOUND_RE.search(
                    err.get("stderr", "")):
                _refuse({"error": "supersede_target_missing",
                         "reason": (f"superseded-by names #{target_n}, which "
                                    "does not exist"),
                         "superseded_by": target_n,
                         "stderr": err.get("stderr", "")}, issue=args.issue)
            _refuse(err, issue=args.issue, superseded_by=target_n,
                    reason="the close is refused, not attempted-and-assumed")
        if (other.get("state") or "").upper() != "OPEN":
            _refuse({"error": "supersede_target_closed",
                     "reason": (f"superseded-by names #{target_n}, which is "
                                f"{(other.get('state') or 'UNKNOWN').lower()} "
                                "-- work cannot be folded into a closed issue"),
                     "superseded_by": target_n,
                     "target_state": other.get("state")}, issue=args.issue)

    # -- 5. P0 / security evidence (AC-5) ---------------------------------
    sensitive = bool(labels & SENSITIVE_LABELS)
    evidence = (args.evidence or "").strip() or None
    if sensitive:
        if evidence is None:
            _refuse({"error": "evidence_required",
                     "reason": ("this issue is labelled "
                                f"{sorted(labels & SENSITIVE_LABELS)} -- closing it "
                                "requires --evidence naming a commit SHA, a PR "
                                "number, or a test id that shows the defect no "
                                "longer reproduces"),
                     "labels": sorted(labels)}, issue=args.issue)
        if not EVIDENCE_RE.fullmatch(evidence):
            _refuse({"error": "evidence_unparseable",
                     "reason": ("--evidence must be a 40-hex commit OID, "
                                "`#<number>`, or `test:<id>`"),
                     "evidence": evidence}, issue=args.issue)
    elif evidence is not None and not EVIDENCE_RE.fullmatch(evidence):
        _refuse({"error": "evidence_unparseable",
                 "reason": ("--evidence must be a 40-hex commit OID, "
                            "`#<number>`, or `test:<id>`"),
                 "evidence": evidence}, issue=args.issue)

    # -- state reason -----------------------------------------------------
    state_reason = args.state_reason or STATE_REASON_BY_DISPOSITION[
        parsed["disposition"]]
    if state_reason not in GH_CLOSE_REASON:
        _refuse({"error": "state_reason_unsupported",
                 "reason": (f"GitHub cannot be asked to record {state_reason}: "
                            "`gh issue close --reason` accepts only "
                            "{completed|not planned} and the REST state_reason "
                            "enum has no `duplicate`. Recording it locally while "
                            "writing something else to GitHub is exactly the "
                            "disagreement this command exists to prevent."),
                 "state_reason": state_reason,
                 "supported": sorted(GH_CLOSE_REASON)}, issue=args.issue)

    comment_body, err = _compose_close_comment(parsed, evidence, args.actor)
    if err:
        _refuse(err, issue=args.issue)

    # -- 6/7. bulk-close check and the intent row, in ONE transaction -----
    # They must be atomic: two concurrent closes that each counted 2 and then
    # each inserted would put 4 in the window. BEGIN IMMEDIATE serializes the
    # count against the insert, so the limit holds under concurrency and not
    # merely in a single-threaded test.
    begin(cx)
    try:
        window_start = t - BULK_CLOSE_WINDOW_SECONDS
        recent = cx.execute(
            "SELECT issue, recorded_at, disposition FROM issue_close_dispositions "
            "WHERE actor=? AND recorded_at > ? ORDER BY recorded_at",
            (args.actor, window_start)).fetchall()
        if len(recent) >= BULK_CLOSE_LIMIT:
            cx.execute("COMMIT")
            # The refusal NAMES the limit and the window (AC-6) so the reader
            # does not have to go and find them in the source.
            _refuse({"error": "bulk_close_refused",
                     "reason": (f"{args.actor} has already closed {len(recent)} "
                                f"issues in the last "
                                f"{int(BULK_CLOSE_WINDOW_SECONDS)}s; the limit is "
                                f"{BULK_CLOSE_LIMIT} per actor per "
                                f"{int(BULK_CLOSE_WINDOW_SECONDS)}s window. A "
                                "batch close is not a batch of judgments."),
                     "limit": BULK_CLOSE_LIMIT,
                     "window_seconds": int(BULK_CLOSE_WINDOW_SECONDS),
                     "actor": args.actor,
                     "recent": [dict(r) for r in recent]}, issue=args.issue)
        cur = cx.execute(
            "INSERT INTO issue_close_dispositions("
            "issue,disposition,superseded_by,deferred_to,evidence,sensitive,"
            "state_reason,comment_body,actor,recorded_at,applied_at) "
            "VALUES(?,?,?,?,?,?,?,?,?,?,NULL)",
            (args.issue, parsed["disposition"], parsed["superseded_by"],
             parsed["deferred_to"], evidence, int(sensitive), state_reason,
             comment_body, args.actor, t))
        row_id = cur.lastrowid
        cx.execute("COMMIT")
    except Exception:
        cx.execute("ROLLBACK")
        raise

    # -- 8. the GitHub write ----------------------------------------------
    # Comment first, then close. If the close fails the disposition is still
    # on the issue for a human to read; the reverse ordering would produce the
    # undisposed close this whole command exists to eliminate.
    def _gh(argv):
        try:
            subprocess.run([gh] + argv, capture_output=True, text=True,
                           check=True)
            return None
        except (FileNotFoundError, OSError) as exc:
            return {"error": "gh_binary_missing", "gh_path": gh,
                    "details": str(exc)}
        except subprocess.CalledProcessError as exc:
            return {"error": "gh_api_failed", "argv": argv,
                    "stderr": (exc.stderr or "").strip()}

    write_err = _gh(["issue", "comment", str(args.issue), "--body", comment_body])
    if write_err is None:
        write_err = _gh(["issue", "close", str(args.issue),
                         "--reason", GH_CLOSE_REASON[state_reason]])
    if write_err is not None:
        # applied_at stays NULL on purpose. The row is now a STALE INTENT and
        # `issue undisposed` is what reports it -- a visible failure, not a
        # silent one, and not a phantom delivery in the AC-7 report.
        out({"ok": False, "closed": False, "issue": args.issue,
             "disposition_id": row_id, "applied": False,
             "stale_intent": True,
             "reason": ("the disposition was recorded but the GitHub write "
                        "failed; the issue is NOT closed. This row is now a "
                        "stale intent -- see `issue undisposed`."),
             **write_err}, 1)

    # -- 9. confirm, exactly once (compare-and-set) ------------------------
    begin(cx)
    try:
        cur = cx.execute(
            "UPDATE issue_close_dispositions SET applied_at=? "
            "WHERE id=? AND applied_at IS NULL", (t, row_id))
        applied = cur.rowcount == 1
        cx.execute("COMMIT")
    except Exception:
        cx.execute("ROLLBACK")
        raise

    out({"ok": True, "closed": True, "issue": args.issue,
         "disposition_id": row_id,
         "disposition": parsed["disposition"],
         "superseded_by": parsed["superseded_by"],
         "deferred_to": parsed["deferred_to"],
         "sensitive": sensitive, "evidence": evidence,
         "state_reason": state_reason, "actor": args.actor,
         "applied": applied, "applied_at": t if applied else None,
         "comment_body": comment_body})


def cmd_issue_disposition_report(cx, args):
    """AC-7: closes by disposition over a range, from the local record.

    Counts only APPLIED rows: an intent that never reached GitHub is not a
    close, and counting it would inflate exactly the number this report
    exists to make trustworthy.
    """
    since = args.since if args.since is not None else 0.0
    until = args.until if args.until is not None else now()
    counts = {"delivered": 0, "superseded": 0, "deferred": 0}
    for row in cx.execute(
            "SELECT disposition, COUNT(*) AS n FROM issue_close_dispositions "
            "WHERE applied_at IS NOT NULL AND applied_at >= ? AND applied_at <= ? "
            "GROUP BY disposition", (since, until)).fetchall():
        counts[row["disposition"]] = row["n"]
    pending = cx.execute(
        "SELECT COUNT(*) AS n FROM issue_close_dispositions "
        "WHERE applied_at IS NULL AND recorded_at >= ? AND recorded_at <= ?",
        (since, until)).fetchone()["n"]
    # All three keys are ALWAYS present, so "nothing closed in range" prints
    # explicit zeros and stays distinguishable from a failed query -- the
    # issue's second empty state, which an empty body would violate.
    out({"ok": True, "since": since, "until": until, "counts": counts,
         # deferred work is reported but never counted as closed (AC-3)
         "closed_total": counts["delivered"] + counts["superseded"],
         "deferred_total": counts["deferred"],
         "stale_intents": pending})


def cmd_issue_undisposed(cx, args):
    """Failure state 3: closes that bypassed this gateway, plus crash residue.

    Two populations, deliberately reported together because an operator
    chasing "what closed without a disposition?" wants both:
      * issues GitHub reports closed with no APPLIED disposition row -- i.e.
        somebody closed in the GitHub UI, or through a raw `gh issue close`
        (which the Program's own heartbeat still does today; see ADR-0055
        Consequences);
      * stale intent rows left by a step-8 crash.

    This is the QUERY only. Scheduling it is the heartbeat's job (ADR-0055
    section 6): moving a caller later is cheap, entangling the scan with
    heartbeat internals is not.
    """
    gh = os.environ.get("NIGHTSHIFT_CTL_GH", "gh")
    since = args.since if args.since is not None else 0.0
    stale = [dict(r) for r in cx.execute(
        "SELECT id, issue, disposition, actor, recorded_at "
        "FROM issue_close_dispositions "
        "WHERE applied_at IS NULL AND recorded_at >= ? ORDER BY recorded_at",
        (since,)).fetchall()]
    try:
        result = subprocess.run(
            [gh, "issue", "list", "--state", "closed", "--limit",
             str(args.limit), "--json", "number,closedAt,title"],
            capture_output=True, text=True, check=True)
        listed = json.loads(result.stdout)
    except (FileNotFoundError, OSError) as exc:
        out({"ok": False, "error": "gh_binary_missing", "gh_path": gh,
             "details": str(exc), "stale_intents": stale}, 3)
    except subprocess.CalledProcessError as exc:
        out({"ok": False, "error": "gh_api_failed",
             "stderr": (exc.stderr or "").strip(),
             "stale_intents": stale}, 3)
    except (json.JSONDecodeError, TypeError) as exc:
        out({"ok": False, "error": "parse_failed", "details": str(exc),
             "stale_intents": stale}, 3)

    disposed = {
        r["issue"] for r in cx.execute(
            "SELECT DISTINCT issue FROM issue_close_dispositions "
            "WHERE applied_at IS NOT NULL").fetchall()
    }
    undisposed = []
    for item in listed:
        if not isinstance(item, dict) or item.get("number") in disposed:
            continue
        closed_at = _parse_iso8601(item.get("closedAt"))
        if closed_at is not None and closed_at < since:
            continue
        undisposed.append({"issue": item.get("number"),
                           "title": item.get("title"),
                           "closed_at": item.get("closedAt")})
    undisposed.sort(key=lambda i: (i["issue"] is None, i["issue"]))
    out({"ok": True, "since": since,
         "undisposed_closes": undisposed,
         "undisposed_count": len(undisposed),
         "stale_intents": stale,
         "stale_intent_count": len(stale)})


def _parse_iso8601(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        import datetime
        return datetime.datetime.strptime(
            value.replace("Z", "+0000"), "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (ValueError, OverflowError):
        return None


# ------------------------------------------------------ scheduled-run SLO ---
#
# ADR-0017: Omnigent owns the durable firing ledger.  These tables own only
# Nightshift's normalized observation, positive expected-occurrence checkpoint,
# consecutive-failure count, and delivery acknowledgement.  Keeping the writes
# behind this CLI preserves the control plane's one transactional mutation
# boundary; the detector never opens SQLite itself.

SCHEDULE_STATUSES = (
    "scheduled", "running", "succeeded", "failed", "skipped", "missed", "stuck",
    # ADR-0044 §6 (AC-7): a Program that correctly stands down because it lost
    # the authority race is not an incident — it needs its own status,
    # distinct from (and never reusing) "skipped". Deliberately absent from
    # SCHEDULE_INCIDENT_STATUSES below — do not add it there.
    "standdown",
)
SCHEDULE_FAILURE_CLASSES = (
    "none", "vendor_overloaded", "vendor_rate_limited", "auth", "timeout",
    "host_unavailable", "runner_harness", "incomplete", "unknown",
)
SCHEDULE_INCIDENT_STATUSES = frozenset({"failed", "skipped", "missed", "stuck"})
SCHEDULE_PENDING_RESULT_LIMIT = 100


def _schedule_state_row(cx, task_id, t):
    cx.execute(
        "INSERT INTO scheduled_run_detector_state("
        "task_id,consecutive_failures,updated_at) VALUES(?,0,?) "
        "ON CONFLICT(task_id) DO NOTHING",
        (task_id, t),
    )
    return cx.execute(
        "SELECT * FROM scheduled_run_detector_state WHERE task_id=?", (task_id,)
    ).fetchone()


def cmd_schedule_state(cx, args):
    # One deferred read transaction keeps the bounded rows and their total in
    # the same snapshot while concurrent detector invocations acknowledge
    # deliveries.  BEGIN IMMEDIATE would unnecessarily serialize writers.
    cx.execute("BEGIN")
    try:
        state = cx.execute(
            "SELECT * FROM scheduled_run_detector_state WHERE task_id=?", (args.task,)
        ).fetchone()
        pending = cx.execute(
            "SELECT * FROM scheduled_run_observations "
            "WHERE task_id=? AND status IN ('failed','skipped','missed','stuck') "
            "AND alerted_at IS NULL ORDER BY scheduled_at, observation_key LIMIT ?",
            (args.task, SCHEDULE_PENDING_RESULT_LIMIT),
        ).fetchall()
        pending_count = cx.execute(
            "SELECT COUNT(*) AS n FROM scheduled_run_observations "
            "WHERE task_id=? AND status IN ('failed','skipped','missed','stuck') "
            "AND alerted_at IS NULL", (args.task,),
        ).fetchone()["n"]
        cx.execute("COMMIT")
    except Exception:
        cx.execute("ROLLBACK")
        raise
    out({
        "ok": True,
        "state": dict(state) if state else None,
        "pending_alerts": [dict(row) for row in pending],
        "pending_alert_count": pending_count,
    })


def cmd_schedule_expect(cx, args):
    t = now()
    begin(cx)
    _schedule_state_row(cx, args.task, t)
    expected = None if args.clear else args.at
    cx.execute(
        "UPDATE scheduled_run_detector_state "
        "SET next_expected_at=?, updated_at=? WHERE task_id=?",
        (expected, t, args.task),
    )
    cx.execute("COMMIT")
    state = cx.execute(
        "SELECT * FROM scheduled_run_detector_state WHERE task_id=?", (args.task,)
    ).fetchone()
    out({"ok": True, "state": dict(state)})


def cmd_schedule_observe(cx, args):
    """Idempotently record one normalized scheduled-run observation.

    The key for a real run is task+run id and deliberately excludes status.
    Thus ``running -> stuck -> failed`` supersedes one row.  A changed incident
    clears ``alerted_at`` so delivery emits an update, but it does not increment
    the consecutive count twice for one run.
    """
    t = now()
    begin(cx)
    state = _schedule_state_row(cx, args.task, t)
    current_count = int(state["consecutive_failures"])
    current_key = state["current_observation_key"]
    state_count = current_count
    state_key = current_key
    current_observation = None
    if current_key is not None:
        current_observation = cx.execute(
            "SELECT scheduled_at FROM scheduled_run_observations "
            "WHERE observation_key=?", (current_key,),
        ).fetchone()
    existing = cx.execute(
        "SELECT * FROM scheduled_run_observations WHERE observation_key=?",
        (args.key,),
    ).fetchone()
    if existing is not None and existing["task_id"] != args.task:
        cx.execute("ROLLBACK")
        out({"ok": False, "reason": "observation key belongs to another task"}, 3)

    new_incident = args.status in SCHEDULE_INCIDENT_STATUSES
    changed = False
    if existing is None:
        # A late run can materialize after its occurrence was already reported
        # missed.  It is the same occurrence for escalation purposes even
        # though its durable Omnigent run id was unavailable at alert time.
        prior_missed = None
        if args.run:
            prior_missed = cx.execute(
                "SELECT observation_key,consecutive_failures "
                "FROM scheduled_run_observations "
                "WHERE task_id=? AND run_id IS NULL AND scheduled_at=? "
                "AND status='missed' ORDER BY observed_at DESC LIMIT 1",
                (args.task, args.scheduled_at),
            ).fetchone()
        is_older = (
            current_observation is not None
            and args.scheduled_at < int(current_observation["scheduled_at"])
        )
        if args.status == "succeeded":
            count = 0
        elif new_incident and prior_missed is not None:
            count = int(prior_missed["consecutive_failures"])
        elif new_incident:
            count = current_count + 1
        else:
            count = current_count
        cx.execute(
            "INSERT INTO scheduled_run_observations("
            "observation_key,task_id,run_id,scheduled_at,conversation_id,status,"
            "failure_class,consecutive_failures,observed_at,alerted_at) "
            "VALUES(?,?,?,?,?,?,?,?,?,NULL)",
            (args.key, args.task, args.run, args.scheduled_at, args.conversation,
             args.status, args.failure_class, count, t),
        )
        changed = True
        if prior_missed is not None:
            # Replace a previously missing occurrence in the streak only when
            # it is still the current occurrence.  A very late materialization
            # must not rewrite a newer task-level verdict.
            if current_key == prior_missed["observation_key"]:
                state_count = count
                state_key = args.key
        elif not is_older:
            state_count = count
            state_key = args.key
    else:
        old_incident = existing["status"] in SCHEDULE_INCIDENT_STATUSES
        changed = any((
            existing["status"] != args.status,
            existing["failure_class"] != args.failure_class,
            existing["conversation_id"] != args.conversation,
        ))
        if args.status == "succeeded":
            count = 0
        elif old_incident and new_incident:
            count = int(existing["consecutive_failures"])
        elif new_incident:
            count = current_count + 1
        else:
            count = current_count
        if changed:
            # A status/class supersession is still the same incident sequence,
            # but it needs an updated notification.  Clear only delivery state;
            # never advance the consecutive count twice for one run id.
            alerted_at = None if new_incident else existing["alerted_at"]
            cx.execute(
                "UPDATE scheduled_run_observations SET run_id=?, scheduled_at=?, "
                "conversation_id=?, status=?, failure_class=?, "
                "consecutive_failures=?, observed_at=?, alerted_at=? "
                "WHERE observation_key=?",
                (args.run, args.scheduled_at, args.conversation, args.status,
                 args.failure_class, count, t, alerted_at, args.key),
            )
            if current_key == args.key:
                state_count = count

    last_at = state["last_run_scheduled_at"]
    if args.run and (last_at is None or args.scheduled_at > int(last_at)):
        last_at = args.scheduled_at
    cx.execute(
        "UPDATE scheduled_run_detector_state SET last_run_scheduled_at=?, "
        "current_observation_key=?, consecutive_failures=?, updated_at=? "
        "WHERE task_id=?",
        (last_at, state_key, state_count, t, args.task),
    )
    cx.execute("COMMIT")
    row = cx.execute(
        "SELECT * FROM scheduled_run_observations WHERE observation_key=?",
        (args.key,),
    ).fetchone()
    alert_required = (
        row["status"] in SCHEDULE_INCIDENT_STATUSES and row["alerted_at"] is None
    )
    out({
        "ok": True,
        "changed": changed,
        "alert_required": alert_required,
        "observation": dict(row),
    })


def cmd_schedule_alerted(cx, args):
    t = now()
    begin(cx)
    row = cx.execute(
        "SELECT * FROM scheduled_run_observations WHERE observation_key=?",
        (args.key,),
    ).fetchone()
    if row is None:
        cx.execute("ROLLBACK")
        out({"ok": False, "reason": "unknown observation"}, 3)
    cx.execute(
        "UPDATE scheduled_run_observations SET alerted_at=? "
        "WHERE observation_key=? AND alerted_at IS NULL",
        (t, args.key),
    )
    cx.execute("COMMIT")
    row = cx.execute(
        "SELECT * FROM scheduled_run_observations WHERE observation_key=?",
        (args.key,),
    ).fetchone()
    out({"ok": True, "observation": dict(row)})


# ------------------------------------------------------------ heartbeats ----
#
# ADR-0002 §1-§3. Four signals, four owners; no signal may stand in for
# another. This is the record `crew_beta`'s watchdog consumes — published as
# .omni/handoffs/LIVENESS-RECORD-v1.md. It is read by CONTENT, never by mtime,
# because the failure being removed is precisely that "some file under .omni/
# changed" was ever treated as "the org's brain ran".

HEARTBEAT_SCHEMA_VERSION = 1


def host_boot_id():
    """The current boot's identity. A heartbeat carrying a different one was
    written before the last reboot: the record survived, the Program did not."""
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip()
    except OSError:
        return ""


def read_beat(cx, who):
    """Return (record, reason_code). A malformed record is NOT a crash and is
    NOT alive — it is a verdict, so the watchdog can act on it."""
    row = cx.execute("SELECT value FROM meta WHERE key=?",
                     ("heartbeat:" + who,)).fetchone()
    if row is None:
        return None, "missing"
    try:
        rec = json.loads(row["value"])
    except (ValueError, TypeError):
        return None, "malformed"
    if not isinstance(rec, dict):
        return None, "malformed"
    for field in ("schema_version", "who", "run_id", "ts", "boot_id", "seq"):
        if field not in rec:
            return None, "malformed"
    # The field being PRESENT is not the property that matters. A record from a
    # writer we do not understand must read NOT ALIVE — never "alive, probably".
    # This is the fail-closed direction, and the published contract
    # (.omni/handoffs/LIVENESS-RECORD-v1.md §1) promises exactly it.
    if rec["schema_version"] != HEARTBEAT_SCHEMA_VERSION:
        return None, "unknown_version"
    if not isinstance(rec["seq"], int) or not isinstance(rec["ts"], (int, float)):
        return None, "malformed"
    return rec, None


def cmd_beat_write(cx, args):
    """Written by the named owner AFTER a completed loop iteration. Never by a
    timer, a worker or the backup (ADR-0002 §1)."""
    t = args.ts_override if args.ts_override is not None else now()
    boot = args.boot or host_boot_id()
    begin(cx)
    prev, _ = read_beat(cx, args.who)
    reset = False
    if prev is not None:
        same_run = (prev.get("run_id") == args.run
                    and prev.get("boot_id") == boot)
        if same_run and args.seq <= prev.get("seq", -1):
            cx.execute("COMMIT")
            out({"ok": False, "who": args.who, "reason_code":
                 "seq_not_increasing",
                 "reason": (f"loop sequence {args.seq} does not advance "
                            f"{prev.get('seq')} for run {args.run} — a "
                            "heartbeat that does not advance is not evidence "
                            "of a completed iteration"),
                 "stored_seq": prev.get("seq")}, 3)
        reset = not same_run
    rec = {
        "schema_version": HEARTBEAT_SCHEMA_VERSION,
        "who": args.who,
        "run_id": args.run,
        "session": args.session,
        "ts": float(t),
        "boot_id": boot,
        "seq": args.seq,
        # When `seq` last advanced (ADR-0006 D4c). ADDITIVE at
        # schema_version 1 -- deliberately NOT a version bump: `read_beat`
        # fails closed on a version mismatch, so bumping for an additive
        # field would read the whole org NOT ALIVE at the instant of deploy,
        # until every consumer caught up. Bump only when the MEANING of an
        # existing field changes. Old readers ignore the key; new readers
        # tolerate its absence in a record an old writer left.
        "seq_ts": float(t),
        "phase": args.phase,
    }
    cx.execute("INSERT INTO meta(key,value) VALUES(?,?) "
               "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
               ("heartbeat:" + args.who, json.dumps(rec, sort_keys=True)))
    cx.execute("COMMIT")
    out({"ok": True, "who": args.who, "reset": reset, "record": rec})


def cmd_beat_progress(cx, args):
    """Extend a heartbeat's freshness MID-iteration, without claiming that an
    iteration completed (ADR-0006 D4).

    #68 is real and observed: a single Program turn can outlive
    `heartbeat_max_age_seconds`, so a working org reports itself dead. The fix
    is that the Program beats MORE OFTEN -- never that something else beats
    for it (ADR-0006 D1: a liveness signal may be written only by a process
    whose continued existence is caused by the liveness of the thing it
    attests).

    Two properties carry the safety, and both are deliberate.

    **`seq` is never advanced.** `seq` means "last COMPLETED loop iteration"
    (ADR-0002 §2), and progress is by definition not completion. This is also
    why this is a SEPARATE VERB and not a flag on `beat write`: reusing
    `write` would require weakening the strictly-increasing-`seq` guard in
    `cmd_beat_write`, and that guard is a control -- it is what makes the
    two-producer race safe (#39). A control that gets a bypass flag is not a
    control.

    **It refuses; it never repairs.** A progress beat may only extend a
    record the Program already earned by completing an iteration, so it
    requires an existing record whose run matches `run current` and whose
    boot id matches the live boot. On any mismatch, or with no record at all,
    it exits 3 and writes NOTHING.

    Note the asymmetry with `beat write`, which is the entire point: `write`
    does `boot = args.boot or host_boot_id()` and therefore RESTAMPS a record
    with the live boot id, which is how PR #71's timer erased the post-reboot
    check in a single tick. `progress` treats the live boot id as something to
    be CHECKED AGAINST, never something to stamp.

    Exit codes follow the house contract: 0 accepted, 3 verdict, 1 real error.
    """
    t = args.ts_override if args.ts_override is not None else now()
    live_boot = args.boot or host_boot_id()
    begin(cx)

    def refuse(code, reason):
        # Nothing was written. The COMMIT closes the (empty) transaction
        # rather than leaving the plane locked behind an exiting process.
        cx.execute("COMMIT")
        out({"ok": False, "who": args.who, "reason_code": code,
             "reason": reason, "wrote": False}, 3)

    prev, bad = read_beat(cx, args.who)
    if prev is None:
        refuse(bad or "missing",
               f"no usable heartbeat for '{args.who}' ({bad or 'missing'}) -- "
               "a progress beat extends a record the owner already earned by "
               "completing an iteration; it never creates one")

    want_run = expected_run_id(cx, args)
    if not want_run:
        refuse("no_expected_run",
               "no run to check against: pass --run, set $NIGHTSHIFT_RUN_ID, "
               "or record one with `nightshift-ctl run current --set <run-id>`")
    if prev.get("run_id") != want_run:
        refuse("wrong_run",
               f"heartbeat is for run '{prev.get('run_id')}', expected "
               f"'{want_run}' -- refusing to refresh a previous run's record "
               "instead of pinning it to the live run")
    if live_boot and prev.get("boot_id") != live_boot:
        refuse("wrong_boot",
               f"heartbeat was written before the last reboot (boot "
               f"'{prev.get('boot_id')}', now '{live_boot}') -- refusing "
               "rather than restamping: the record survived the reboot, the "
               "process that earned it did not")

    rec = dict(prev)
    rec["ts"] = float(t)
    if args.phase is not None:
        rec["phase"] = args.phase
    # `seq` and `seq_ts` are carried through UNTOUCHED. If the record predates
    # seq_ts (written by an older binary) it stays absent -- an unknown time
    # is reported as unknown, never backfilled to now, which would assert a
    # completed iteration that never happened.
    cx.execute("INSERT INTO meta(key,value) VALUES(?,?) "
               "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
               ("heartbeat:" + args.who, json.dumps(rec, sort_keys=True)))
    cx.execute("COMMIT")
    out({"ok": True, "who": args.who, "advanced_seq": False,
         "seq": rec["seq"], "record": rec})


def expected_run_id(cx, args):
    """Which run must the heartbeat belong to?

    Resolved from, in order: --run, $NIGHTSHIFT_RUN_ID, and the control
    plane's own `current_run_id`. The last one is why the check is ON BY
    DEFAULT: a consumer that passes no flag still gets it. `--run` was
    optional before, and the handoff's own recipe omitted it, so a heartbeat
    left by a previous DEAD run read alive indefinitely while it stayed fresh
    — a record outliving the thing it attests, which is the exact failure
    class ADR-0002 exists to remove.

    `current_run_id` is written once at run start by a DIFFERENT command than
    the heartbeat, so it is independent evidence and not the record checking
    itself.
    """
    if args.run:
        return args.run
    env = os.environ.get("NIGHTSHIFT_RUN_ID")
    if env:
        return env
    row = cx.execute("SELECT value FROM meta WHERE key='current_run_id'").fetchone()
    return row["value"] if row else None


def cmd_run_current(cx, args):
    """Record (or report) the run the org is currently executing."""
    if args.new:
        begin(cx)
        row = cx.execute(
            "SELECT value FROM meta WHERE key='current_run_id'"
        ).fetchone()
        if row and row["value"]:
            cx.execute("COMMIT")
            out({"ok": True, "run_id": row["value"], "created": False})
        inconsistent = cx.execute(
            "SELECT 1 FROM worker_slots WHERE state='active' AND phase IS NOT NULL "
            "UNION ALL SELECT 1 FROM task_claims WHERE state='active' LIMIT 1"
        ).fetchone()
        if inconsistent:
            cx.execute("COMMIT")
            out({"ok": False, "reason": "active classified work has no current run id; "
                 "stop for operator reconciliation"}, 3)
        selected = "run-" + secrets.token_hex(16)
        cx.execute("INSERT INTO meta(key,value) VALUES('current_run_id',?)",
                   (selected,))
        cx.execute("COMMIT")
        out({"ok": True, "run_id": selected, "created": True})
    if args.set:
        begin(cx)
        cx.execute("INSERT INTO meta(key,value) VALUES('current_run_id',?) "
                   "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                   (args.set,))
        cx.execute("COMMIT")
        out({"ok": True, "run_id": args.set, "created": False})
    row = cx.execute("SELECT value FROM meta WHERE key='current_run_id'").fetchone()
    if row is None:
        out({"ok": False, "reason": "no current run recorded — set one with "
             "`nightshift-ctl run current --set <run-id>`"}, 3)
    out({"ok": True, "run_id": row["value"]})


def cmd_beat_show(cx, args):
    """The watchdog's read. Exit 0 = alive, exit 3 = NOT alive (a verdict,
    never an error). Rejects, per ADR-0002 §3: missing, malformed, wrong run,
    a previous boot, a future timestamp, or an age past the threshold."""
    cap = load_capacity(args)
    t = now()
    max_age = (args.max_age if args.max_age is not None
               else cap["heartbeat_max_age_seconds"])
    skew = cap["heartbeat_future_skew_seconds"]
    rec, bad = read_beat(cx, args.who)
    if bad:
        out({"alive": False, "who": args.who, "reason_code": bad,
             "reason": f"no usable heartbeat for '{args.who}' ({bad})"}, 3)
    age = t - rec["ts"]
    expect_boot = args.boot or host_boot_id()

    def deny(code, reason):
        out({"alive": False, "who": args.who, "reason_code": code,
             "reason": reason, "age": age, "record": rec}, 3)

    want_run = expected_run_id(cx, args)
    if not want_run:
        deny("no_expected_run",
             "no run to check against: pass --run, set $NIGHTSHIFT_RUN_ID, or "
             "record one with `nightshift-ctl run current --set <run-id>`. "
             "Refusing to report alive on a heartbeat whose run cannot be "
             "verified")
    if rec["run_id"] != want_run:
        deny("wrong_run", f"heartbeat is for run '{rec['run_id']}', "
                          f"expected '{want_run}' — a previous run's record "
                          "outliving the run that wrote it")
    if expect_boot and rec["boot_id"] != expect_boot:
        deny("wrong_boot", "heartbeat was written before the last reboot "
                           f"(boot '{rec['boot_id']}', now '{expect_boot}')")
    if age < -skew:
        deny("future", f"heartbeat timestamp is {-age:.0f}s in the future")
    if age > max_age:
        deny("stale", f"heartbeat is {age:.0f}s old, threshold {max_age:.0f}s")
    out({"alive": True, "who": args.who, "age": age, "max_age": max_age,
         "record": rec})


# ----------------------------------------------------------------- runs ----

def cmd_run_start(cx, args):
    t = now()
    begin(cx)
    cur = cx.execute(
        "INSERT INTO agent_runs(agent,title,session_id,slot_id,task_id,state,started_at)"
        " VALUES(?,?,?,?,?,'running',?)",
        (args.agent, args.title, args.session, args.slot, args.task, t))
    rid = cur.lastrowid
    cx.execute("COMMIT")
    out({"ok": True, "run_id": rid})


def cmd_run_end(cx, args):
    t = now()
    begin(cx)
    cur = cx.execute(
        "UPDATE agent_runs SET state=?, ended_at=? WHERE id=? AND state='running'",
        (args.state, t, args.run))
    n = cur.rowcount
    cx.execute("COMMIT")
    out({"ok": bool(n), "run_id": args.run, "state": args.state}, 0 if n else 3)


def cmd_project_snapshot(cx, args):
    """Read the tracker seams without migration, expiry, or any database write."""
    cx.execute("BEGIN")
    try:
        current = cx.execute(
            "SELECT value FROM meta WHERE key='current_run_id'"
        ).fetchone()
        payload = {
            "ok": True,
            "generated_at": now(),
            "current_run_id": current["value"] if current else None,
            "tasks": [dict(row) for row in cx.execute(
                "SELECT * FROM tasks ORDER BY id"
            ).fetchall()],
            "agent_runs": [dict(row) for row in cx.execute(
                "SELECT * FROM agent_runs ORDER BY id"
            ).fetchall()],
            "slots": [dict(row) for row in cx.execute(
                "SELECT * FROM worker_slots ORDER BY id"
            ).fetchall()],
        }
    finally:
        cx.execute("ROLLBACK")
    out(payload)


# --------------------------------------------------------------- vendors ---

def cmd_vendor_limited(cx, args):
    t = now()
    begin(cx)
    row = cx.execute("SELECT * FROM vendors WHERE name=?", (args.vendor,)).fetchone()
    n = (row["consecutive_limits"] if row else 0) + 1
    cooldown = min(args.base * (2 ** (n - 1)), args.cap)
    until = t + cooldown
    cx.execute(
        "INSERT INTO vendors(name,cooldown_until,consecutive_limits,updated_at)"
        " VALUES(?,?,?,?) ON CONFLICT(name) DO UPDATE SET"
        " cooldown_until=excluded.cooldown_until,"
        " consecutive_limits=excluded.consecutive_limits,"
        " updated_at=excluded.updated_at",
        (args.vendor, until, n, t))
    cx.execute("COMMIT")
    out({"vendor": args.vendor, "cooldown_seconds": cooldown,
         "cooldown_until": until, "consecutive_limits": n})


def cmd_vendor_ok(cx, args):
    t = now()
    begin(cx)
    cx.execute(
        "INSERT INTO vendors(name,cooldown_until,consecutive_limits,updated_at)"
        " VALUES(?,NULL,0,?) ON CONFLICT(name) DO UPDATE SET"
        " cooldown_until=NULL, consecutive_limits=0, updated_at=excluded.updated_at",
        (args.vendor, t))
    cx.execute("COMMIT")
    out({"ok": True, "vendor": args.vendor})


def cmd_vendor_check(cx, args):
    t = now()
    if args.all:
        rows = cx.execute("SELECT * FROM vendors").fetchall()
        report = []
        for r in rows:
            cooling = r["cooldown_until"] is not None and r["cooldown_until"] > t
            report.append({"vendor": r["name"], "cooling": cooling,
                           "remaining": max(0, (r["cooldown_until"] or 0) - t)})
        all_cooling = bool(report) and all(v["cooling"] for v in report)
        wait = min((v["remaining"] for v in report if v["cooling"]), default=0)
        out({"vendors": report, "all_cooling": all_cooling,
             "min_wait_seconds": wait}, 3 if all_cooling else 0)
    if not args.vendor:
        out({"ok": False, "reason": "need --vendor or --all"}, 2)
    row = cx.execute("SELECT * FROM vendors WHERE name=?", (args.vendor,)).fetchone()
    if row and row["cooldown_until"] and row["cooldown_until"] > t:
        out({"vendor": args.vendor, "cooling": True,
             "remaining": row["cooldown_until"] - t}, 3)
    out({"vendor": args.vendor, "cooling": False})


# --------------------------------------------------------------- pr-lint ---

def lint_body(body, kind):
    problems = []
    closing = ["{}#{}".format(m.group(2) or "", m.group(3))
               for m in CLOSING_RE.finditer(body)]
    if kind == "task" and closing:
        problems.append(
            "closing keyword(s) on a task PR: " + ", ".join(sorted(set(closing)))
            + " — the first merged PR would close the whole backlog issue. "
              "Use `Refs #<n>`; the program closes the issue when every task "
              "PR has integrated and pm acceptance passed.")
    if kind == "task" and not REFS_RE.search(body):
        problems.append("no `Refs #<n>` line — the PR must reference its backlog issue")
    return problems


def cmd_pr_lint(cx, args):
    if args.body_file:
        with open(args.body_file) as f:
            body = f.read()
    else:
        body = sys.stdin.read()
    problems = lint_body(body, args.kind)
    if problems:
        out({"ok": False, "problems": problems}, 3)
    out({"ok": True})


def _consume_heartbeat_persist_receipt(cx, receipt_id):
    """One-shot, compare-and-set consumption of a `heartbeat-persist record`
    decision row (issue #390, AC-10). Returns True iff exactly one row with
    this id was `should_persist=1` and not yet consumed -- the same
    fail-closed, no-anonymous-consumption idiom `program_action_permits`
    already established (ADR-0044 §3)."""
    try:
        receipt_id = int(receipt_id)
    except (TypeError, ValueError):
        return False
    begin(cx)
    cur = cx.execute(
        "UPDATE heartbeat_persist_decisions SET consumed_at=? "
        "WHERE id=? AND should_persist=1 AND consumed_at IS NULL",
        (now(), receipt_id),
    )
    ok = cur.rowcount == 1
    cx.execute("COMMIT" if ok else "ROLLBACK")
    return ok


# `gh pr create`'s flag table (long name -> takes a value) and shorthands.
GH_PR_CREATE_FLAGS = {
    "assignee": True, "base": True, "body": True, "body-file": True,
    "draft": False, "dry-run": False, "editor": False, "fill": False,
    "fill-first": False, "fill-verbose": False, "head": True, "label": True,
    "milestone": True, "no-maintainer-edit": False, "project": True,
    "recover": True, "repo": True, "reviewer": True, "template": True,
    "title": True, "web": False,
}
GH_PR_CREATE_SHORT = {
    "a": "assignee", "B": "base", "b": "body", "F": "body-file", "d": "draft",
    "e": "editor", "f": "fill", "H": "head", "l": "label", "m": "milestone",
    "p": "project", "R": "repo", "r": "reviewer", "T": "template",
    "t": "title", "w": "web",
}
# Each builds or edits the body somewhere this lint never sees it.
UNLINTABLE_BODY_FLAGS = frozenset({"fill", "fill-first", "fill-verbose",
                                   "editor", "web", "recover", "template"})


def parse_pflag_args(argv, flags, short):
    """Read argv with spf13/pflag's rules -- the parser gh itself uses.

    Returns ([(name, value)], positionals); raises ValueError(token) for an
    unknown flag or a missing value. `--name=v` / `--name v`. A single-dash
    token is a run of shorthands: a value-taking one swallows the rest of
    the token (`-bText`, `-b=Text`) or else the next argument, so `-dbText`
    is `--draft --body Text`. `--` ends the flags.
    """
    seen, positionals, i = [], [], 0
    while i < len(argv):
        tok = argv[i]
        i += 1
        if tok == "--":
            positionals.extend(argv[i:])
            break
        if tok.startswith("--"):
            name, eq, value = tok[2:].partition("=")
            if name not in flags:
                raise ValueError(tok)
            if flags[name] and not eq:
                if i >= len(argv):
                    raise ValueError(tok)
                value, i = argv[i], i + 1
            seen.append((name, value if (flags[name] or eq) else "true"))
        elif tok.startswith("-") and tok != "-":
            rest = tok[1:]
            while rest:
                letter, rest = rest[0], rest[1:]
                if letter not in short:
                    raise ValueError(tok)
                name = short[letter]
                if rest.startswith("="):
                    seen.append((name, rest[1:]))
                    break
                if not flags[name]:
                    seen.append((name, "true"))
                    continue
                if not rest:
                    if i >= len(argv):
                        raise ValueError(tok)
                    rest, i = argv[i], i + 1
                seen.append((name, rest))
                break
        else:
            positionals.append(tok)
    return seen, positionals


def cmd_pr_create(cx, args):
    """The sanctioned way to open a task PR: lint the body, THEN call gh.

    Usage: nightshift-ctl pr-create [--kind task|free] -- <gh pr create args...>
    Everything after `--` is forwarded to `gh pr create` verbatim once the
    body passes. This closes the --body-file hole: the policy layer denies a
    RAW `gh pr create` that carries --body-file/--fill, so the file path only
    exists through this wrapper, which reads and lints the actual bytes.

    Issue #390: an optional `--heartbeat-persist-receipt <id>` marks this
    PR-open as heartbeat-attributed. When present, control.db opens (see
    `is_plane_free`) and this call MUST consume a matching, unconsumed
    `should_persist_to_git=1` row from `heartbeat_persist_decisions` before
    `gh pr create` is ever exec'd -- fail-closed, no bytes reach GitHub
    otherwise (AC-10). Absent, this function's control flow is byte-for-byte
    identical to before this issue (AC-12): `cx` is never touched.
    """
    gh_args = list(args.gh_args)
    if gh_args and gh_args[0] == "--":
        gh_args = gh_args[1:]
    # Read the arguments exactly as gh will. A token-equality scan missed
    # `-bCloses #5`, `-F<path>`, `-F=<path>` and bundles like `-dbX`, so the
    # body gh posted was never the body linted. Unknown flags are refused.
    try:
        seen, positionals = parse_pflag_args(
            gh_args, GH_PR_CREATE_FLAGS, GH_PR_CREATE_SHORT)
    except ValueError as exc:
        out({"ok": False,
             "problems": [f"unrecognised gh pr create argument {exc.args[0]!r} "
                          "— refused rather than guessing how gh reads it"]}, 3)
    if positionals:
        out({"ok": False, "problems": [
            f"unexpected positional argument(s) {positionals!r}"]}, 3)
    bodies = []
    for name, value in seen:
        if name in UNLINTABLE_BODY_FLAGS:
            out({"ok": False,
                 "problems": [f"--{name} builds or edits the body where it "
                              "cannot be linted ahead of time — write an "
                              "explicit --body or --body-file"]}, 3)
        if name == "body":
            bodies.append(value)
        elif name == "body-file":
            if value == "-":
                out({"ok": False, "problems": [
                    "--body-file - reads stdin, which cannot be both linted "
                    "and forwarded — pass a file path"]}, 3)
            try:
                with open(value) as f:
                    bodies.append(f.read())
            except (OSError, UnicodeDecodeError) as exc:
                out({"ok": False, "problems": [
                    f"cannot read --body-file {value!r}: {exc}"]}, 3)
    if not bodies:
        out({"ok": False,
             "problems": ["no --body/--body-file given — a task PR needs an "
                          "explicit body carrying `Refs #<n>`"]}, 3)
    # Every body given is linted, so gh's choice between several cannot
    # pick an unlinted one.
    problems = [p for body in bodies for p in lint_body(body, args.kind)]
    if problems:
        out({"ok": False, "problems": problems}, 3)
    if getattr(args, "heartbeat_persist_receipt", None) is not None:
        if not _consume_heartbeat_persist_receipt(cx, args.heartbeat_persist_receipt):
            out({"ok": False, "error": "heartbeat_persist_denied",
                 "reason": "no_matching_should_persist_decision"}, 3)
    gh = os.environ.get("NIGHTSHIFT_CTL_GH", "gh")
    os.execvp(gh, [gh, "pr", "create"] + gh_args)


# ------------------------------------------------------- deployed specs ----
#
# #107, the READ half of the shared-checkout hazard (#89/#98 is the WRITE
# half). `/srv/project` is the checkout this org treats as the deployed
# one, and `program/agents/*/config.yaml` underneath it is where a merged
# agent spec is expected to land. That checkout is shared, and it has been
# parked on a detached HEAD that is not on the integration branch at all --
# so a `program/**` change can pass review, pass CI and merge while the
# checkout meant to carry it never gains a byte of it. There was no error
# and no warning, because nothing anywhere compared "what is committed"
# against "what is on disk where it is meant to be deployed".
#
# What this does NOT claim, per B1: the server does not read specs from
# that directory and its CWD has no bearing on which spec it loads. See
# SPEC_SUBDIR and SCOPE_NOTE below.
#
# This block only ever OBSERVES. It does not deploy, reload or move
# anything; deciding how `program/**` should reach the runtime is
# ADR-0010's job, not this code's.

# Exit **4** = the deployed specs diverge from the ref the org believes is
# deployed. It has to be its own code: 3 already means "denied / held /
# cooling", which every caller in this org is taught to treat as *stand
# down and retry later*, and divergence is the opposite instruction -- it
# never clears by waiting, only by a deploy. 2 stays "we could not tell",
# which is a different thing again from "we told, and it is bad".
EXIT_DIVERGED = 4

# The ref the org treats as deployed. `program/**` is the org's own
# constitution (docs/owners.md) and lands on the integration branch.
INTEGRATION_REF = "origin/program/discovery-state"

# The subdirectory the specs live in -- in the deployed checkout and in the
# committed ref alike. Note what it is NOT: the running server does not read
# specs from this directory. Specs are registered from a content-addressed
# bundle at server start (`--agent`, startup-only by construction) and served
# through a two-tier cache keyed on `agent_id` whose disk tier survives
# restarts (ADR-0010 Context, B1). So this is the directory the two SIDES OF
# THE COMPARISON are read from, not the one the server consumes.
SPEC_SUBDIR = "program/agents"

# Appended to every verdict this block reaches, because every one of them is a
# statement about two checkouts and about nothing else. Saying "the running
# server's specs are at X" would be this tool committing #107's own defect --
# asserting a deployment fact nothing here observed -- and #115 is that
# divergence live today. The comparison is still worth making: a deployed
# checkout hundreds of commits behind the ref the org believes is deployed is
# a real finding and it stands. It is evidence about the deployment, not a
# reading of what the server serves.
SCOPE_NOTE = ("this compares the DEPLOYED CHECKOUT against the COMMITTED REF; "
              "neither is necessarily what the running server serves -- specs "
              "are registered from a content-addressed bundle at startup and "
              "served from a cache keyed on agent_id whose disk tier survives "
              "restarts (ADR-0010 B1)")

# How old the caller's copy of a remote-tracking ref may be before
# `aligned` stops being provable. The expected side is resolved in the
# CALLER'S clone with no fetch (this is a read-only detector and it stays
# one), so `origin/<branch>` is a cached assertion about the remote, not an
# observation of it. An assertion of unknown age is exactly the shape of
# defect #107 exists about -- an absent signal read as a good one -- so it
# is reported, and it downgrades the one verdict that would otherwise be
# believed.
#
# 3600s is chosen to sit between the two timescales that matter: shorter
# than a wave (so a ref that has gone unfetched across a deploy cannot be
# read as proof) and comfortably longer than a clone-then-check cycle in
# CI (so the ordinary caller is never told "undetermined" for no reason).
MAX_REF_AGE_S = 3600


def _self_repo():
    """The repo this script is running out of -- the caller's own clone."""
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _git_ro(repo, *argv, hooks_query=False):
    """Run a READ-ONLY git command. Returns (rc, stdout, stderr), never raises.

    Every call site below passes plumbing that cannot move HEAD, write the
    index, or update a ref: rev-parse, cat-file -e, symbolic-ref,
    merge-base --is-ancestor, rev-list, status --porcelain. That restriction
    is the entire safety argument for aiming this at the shared checkout
    while other agents are working in it -- moving that checkout under them
    is #89/#98, which has silently reverted merged work twice. The detector
    observes the shared checkout; it must never move it. Do not add a verb
    here that writes. Runs through `_git_argv`/`_git_env` like every git call.
    """
    try:
        p = subprocess.run(_git_argv(repo, argv, hooks_query=hooks_query),
                           env=_git_env(), capture_output=True, text=True)
    except OSError as exc:
        return 127, "", str(exc)
    return p.returncode, p.stdout.strip(), p.stderr.strip()


def find_server_spec_root(proc_root="/proc"):
    """Find the deployed spec checkout, via the running server's CWD.

    Returns (root, source) on success, or (None, reason) on failure.

    The CWD is a DISCOVERY MECHANISM, not a claim about what the server
    loaded: it has no bearing on which spec the server serves (ADR-0010
    B1). It is used because the directory a server was launched in is the
    checkout most likely to have been *meant* as the deployment.

    Reads /proc rather than shelling out to `ps`, which is the point of
    #107 ask 3: a driver should not have to eyeball process output to learn
    what is deployed. A tool that runs `ps` and regexes it has moved the
    parsing, not removed it. /proc/<pid>/cwd is a kernel-maintained symlink
    to the process's REAL working directory, so it stays correct even when
    the launching command line says something else -- here the server is
    started by a `tmux ... bash -lc 'cd /srv/project; exec omnigent server'`
    wrapper whose own argv never mentions the directory at all.
    """
    try:
        pids = [d for d in os.listdir(proc_root) if d.isdigit()]
    except OSError as exc:
        return None, "cannot read %s: %s" % (proc_root, exc)

    hits = []
    for pid in sorted(pids, key=int):
        try:
            with open(os.path.join(proc_root, pid, "cmdline"), "rb") as f:
                argv = [a.decode("utf-8", "replace")
                        for a in f.read().split(b"\0") if a]
        except OSError:
            continue  # the process exited, or is not ours to read
        if not argv:
            continue
        # `omnigent` appears in a lot of argv on this box -- the tmux
        # wrapper that launches the server, `omnigent host --server URL`,
        # the runner zygotes, and every codex app-server carrying
        # `-c mcp_servers.omnigent...`. What separates the server itself is
        # `server` as a BARE argument, which none of those have: they carry
        # it only inside a quoted -c string, as `--server`, or as `ns-server`.
        if not any("omnigent" in a for a in argv):
            continue
        if "server" not in argv[1:]:
            continue
        try:
            cwd = os.readlink(os.path.join(proc_root, pid, "cwd"))
        except OSError as exc:
            # A live server we cannot see into is NOT an absent one.
            return None, "found server pid %s but cannot read its cwd: %s" % (
                pid, exc)
        hits.append((pid, cwd))

    if not hits:
        return None, "no running omnigent server found under %s" % proc_root
    roots = sorted({cwd for _, cwd in hits})
    if len(roots) > 1:
        return None, ("%d omnigent servers are running from different "
                      "directories %s -- refusing to guess which one serves "
                      "the specs" % (len(hits), roots))
    return roots[0], "proc:" + ",".join(pid for pid, _ in hits)


def deployed_spec_state(root):
    """What the DEPLOYED CHECKOUT is ACTUALLY at.

    NOT "what the server is serving". This root is discovered from the
    server's own working directory, which makes it the checkout most likely
    to have been *meant* as the deployment -- but the server registers specs
    from a content-addressed bundle at startup and serves them from a cache
    that outlives restarts (ADR-0010 B1), so nothing read here is a reading
    of what is loaded.
    """
    st = {"root": root}
    spec_dir = os.path.join(root, SPEC_SUBDIR)
    if not os.path.isdir(spec_dir):
        st["error"] = "%s does not exist under %s -- this is not a spec "\
                      "checkout" % (SPEC_SUBDIR, root)
        return st
    rc, sha, err = _git_ro(root, "rev-parse", "HEAD")
    if rc != 0:
        st["error"] = "cannot read HEAD in %s: %s" % (root, err or rc)
        return st
    st["sha"] = sha
    rc, branch, _ = _git_ro(root, "symbolic-ref", "--quiet", "--short", "HEAD")
    st["branch"] = branch if rc == 0 and branch else None
    st["detached"] = st["branch"] is None
    # Uncommitted edits under the spec dir are a SECOND way for what is
    # loaded to differ from what is committed, and they do not show up in a
    # sha comparison at all. Report them; they make alignment unprovable.
    rc, dirty, _ = _git_ro(root, "status", "--porcelain", "--", SPEC_SUBDIR)
    st["dirty"] = dirty.splitlines() if (rc == 0 and dirty) else []
    return st


def _ref_freshness(repo, ref):
    """How old is the caller's copy of `ref`? NEVER fetches.

    Only a remote-tracking ref (`refs/remotes/<remote>/<branch>`) has a
    fetch behind it that could be stale. A local branch, tag or raw SHA is
    whatever the caller asked for with no remote round trip in the middle,
    so there is nothing to have gone stale and `fetched` is None --
    "not applicable" -- rather than False, which would mean "we looked and
    could not tell".

    Age comes from the ref's own mtime: the loose file under the git
    COMMON dir (remote refs live there, not in a worktree's private dir),
    falling back to `packed-refs` when the ref has been packed.

    Deliberately does NOT consult FETCH_HEAD. Concurrent agents share
    clones on this box and every one of them rewrites FETCH_HEAD, so its
    mtime dates somebody else's fetch of some other ref -- reading it here
    would manufacture exactly the false freshness this function exists to
    prevent.
    """
    fr = {"fetched": None, "age_seconds": None, "source": None}
    rc, full, _ = _git_ro(repo, "rev-parse", "--symbolic-full-name", ref)
    if rc != 0 or not full:
        # A raw SHA or an unresolvable name: no ref file, nothing to age.
        fr["source"] = "not_a_ref"
        return fr
    fr["ref_full"] = full
    if not full.startswith("refs/remotes/"):
        fr["source"] = "local_ref"
        return fr

    rc, common, _ = _git_ro(repo, "rev-parse", "--git-common-dir")
    if rc != 0 or not common:
        fr["fetched"] = False
        fr["source"] = "no_git_dir"
        return fr
    if not os.path.isabs(common):
        common = os.path.join(repo, common)

    for cand, src in ((os.path.join(common, full), "loose_ref"),
                      (os.path.join(common, "packed-refs"), "packed_refs")):
        try:
            age = int(time.time() - os.path.getmtime(cand))
        except OSError:
            continue
        fr["fetched"] = True
        fr["age_seconds"] = max(0, age)
        fr["source"] = src
        return fr

    # The ref resolves but neither its loose file nor packed-refs could be
    # stat'd. We cannot establish when it was fetched, so we say so.
    fr["fetched"] = False
    fr["source"] = "unreadable"
    return fr


def expected_spec_state(repo, ref, max_ref_age=MAX_REF_AGE_S):
    """What the org BELIEVES is deployed: the integration branch tip.

    Resolved in the CALLER'S clone with no fetch, so the result carries a
    `fetched` / `age_seconds` pair saying how much that belief is worth.
    """
    st = {"repo": repo, "ref": ref}
    rc, sha, err = _git_ro(repo, "rev-parse", "--verify", ref + "^{commit}")
    if rc != 0:
        st["error"] = "cannot resolve %r in %s: %s" % (ref, repo, err or rc)
        return st
    st["sha"] = sha
    st.update(_ref_freshness(repo, ref))
    st["max_age_seconds"] = max_ref_age
    st["stale"] = _freshness_is_unproven(st, max_ref_age)
    return st


def _freshness_is_unproven(exp, max_ref_age):
    """True when the expected side is a remote-tracking ref whose currency
    we could not establish, or established as older than the bound.

    False for local refs and raw SHAs: there is no fetch behind them, so
    there is no freshness claim to fail. That is why the suite's
    `--expected-ref main` cases stay `aligned`.
    """
    if exp.get("fetched") is None:
        return False
    if not exp["fetched"]:
        return True
    return exp.get("age_seconds", 0) > max_ref_age


def _relation(dep_sha, exp_sha, repos):
    """Classify deployed-vs-expected in whichever repo holds both commits.

    Tried in the caller's clone first and the deployed checkout second: a
    local ref can be stale, but reachability is a property of the commit
    graph, so any repo that has both objects gives the same answer.
    """
    for repo in repos:
        if not repo:
            continue
        if any(_git_ro(repo, "cat-file", "-e", s + "^{commit}")[0] != 0
               for s in (dep_sha, exp_sha)):
            continue
        if _git_ro(repo, "merge-base", "--is-ancestor", dep_sha, exp_sha)[0] == 0:
            kind = "behind"
        elif _git_ro(repo, "merge-base", "--is-ancestor", exp_sha, dep_sha)[0] == 0:
            kind = "ahead"
        else:
            kind = "not_on_ref"
        rel = {"kind": kind, "checked_in": repo}
        rc, counts, _ = _git_ro(repo, "rev-list", "--left-right", "--count",
                                dep_sha + "..." + exp_sha)
        if rc == 0 and len(counts.split()) == 2:
            ahead, behind = counts.split()
            rel["ahead"] = int(ahead)
            rel["behind"] = int(behind)
        return rel
    return {"kind": "unknown",
            "checked_in": None,
            "note": "neither repository holds both commits, so the two "
                    "cannot be ordered -- they are still unequal"}


def spec_report(spec_root=None, expected_repo=None, expected_ref=None,
                proc_root="/proc", max_ref_age=MAX_REF_AGE_S):
    """Answer: is the deployed spec checkout at the ref the org expects?

    `diverged` is a strict boolean and it is FAIL-CLOSED: False only when
    alignment is PROVEN -- both SHAs resolved, equal, no uncommitted edits
    under the spec dir, AND the ref they were compared against of
    established currency. Everything else is True. #107 exists because an
    absent signal was read as a good one five times in one day; a detector
    that answers "not diverged" when it simply could not look would be the
    sixth. `status` carries the precise reason, so nothing is lost by
    making the boolean blunt:

        aligned      -- proven equal            (exit 0)
        diverged     -- proven different        (exit EXIT_DIVERGED)
        undetermined -- could not establish it  (exit 2)

    On the freshness clause, because it is the non-obvious one: the
    expected side is a remote-tracking ref read out of the caller's own
    clone with NO fetch, and it stays that way -- a read-only detector that
    reaches the network is no longer read-only, and no longer runnable in
    the places this one has to run. So an unfetched `origin/<branch>` is
    not treated as proof. It downgrades `aligned` to `undetermined` and
    nothing else: `diverged` still wins outright, because a stale ref can
    only ever make a real divergence look smaller, never invent one, and
    the fail-closed direction is the one that keeps today's `not_on_ref`
    verdict standing.

    Timing is why this is not cosmetic. Today, deployed `27f3915` is on no
    ancestor path in either direction, so no staleness of `origin/...` can
    produce a false green -- probability is ~0. Once specs actually deploy,
    the normal state becomes "deployed == a recent tip", and a clone that
    last fetched before the newest deploy will resolve `origin/<branch>` to
    *exactly the deployed SHA* -- aligned, exit 0, green, wrong. The
    detector would be least trustworthy precisely when the org started
    relying on it (staff, B5, PR #113).
    """
    rep = {}
    if spec_root:
        rep["deployed"] = deployed_spec_state(spec_root)
        rep["deployed"]["source"] = "explicit"
    else:
        root, why = find_server_spec_root(proc_root)
        if root is None:
            rep["deployed"] = {"error": why, "source": "proc-scan"}
        else:
            rep["deployed"] = deployed_spec_state(root)
            rep["deployed"]["source"] = why

    rep["expected"] = expected_spec_state(expected_repo or _self_repo(),
                                          expected_ref or INTEGRATION_REF,
                                          max_ref_age=max_ref_age)

    dep = rep["deployed"].get("sha")
    exp = rep["expected"].get("sha")
    if not dep or not exp:
        missing = rep["deployed"].get("error") or rep["expected"].get("error")
        rep["status"] = "undetermined"
        rep["diverged"] = True
        rep["reason"] = ("cannot compare deployed specs against %r: %s "
                         "-- reporting diverged because unproven alignment "
                         "is not alignment" % (expected_ref or INTEGRATION_REF,
                                               missing))
        return rep

    if dep == exp and not rep["deployed"].get("dirty"):
        # The SHAs match -- but they match a ref we read locally and never
        # fetched. If we cannot establish when that ref last came from the
        # remote, "equal" is equal to a cached assertion, which is not the
        # claim `aligned` makes. Downgrade rather than fetch.
        if rep["expected"].get("stale"):
            age = rep["expected"].get("age_seconds")
            how = ("last fetched %ss ago, over the %ss bound"
                   % (age, max_ref_age)) if age is not None else (
                   "its fetch time could not be established (%s)"
                   % rep["expected"].get("source"))
            rep["status"] = "undetermined"
            rep["diverged"] = True
            rep["reason"] = (
                "the deployed checkout is at %s, which equals this "
                "clone's %s -- but %s, so that ref may itself be behind the "
                "remote and the match may be a stale-clone artefact. NOT "
                "reporting aligned: alignment against an unfetched ref is "
                "an assertion, not proof (#107). Fetch %s and re-run. Note: "
                "%s."
                % (dep, rep["expected"]["ref"], how, rep["expected"]["ref"],
                   SCOPE_NOTE))
            return rep
        rep["status"] = "aligned"
        rep["diverged"] = False
        rep["reason"] = ("the deployed checkout is at %s, which is "
                         "exactly %s. Note: %s."
                         % (dep, rep["expected"]["ref"], SCOPE_NOTE))
        return rep

    rep["status"] = "diverged"
    rep["diverged"] = True
    if dep == exp:
        rep["divergence"] = {"kind": "dirty", "checked_in": rep["deployed"]["root"]}
        rep["reason"] = (
            "the deployed checkout is at %s, which matches %s, but "
            "%d uncommitted change(s) under %s mean its on-disk specs are "
            "not the committed ones. Note: %s."
            % (dep, rep["expected"]["ref"],
               len(rep["deployed"]["dirty"]), SPEC_SUBDIR, SCOPE_NOTE))
        return rep
    rel = _relation(dep, exp, [rep["expected"].get("repo"),
                               rep["deployed"].get("root")])
    rep["divergence"] = rel
    detail = {
        "not_on_ref": "%s is not reachable from %s at all -- the deployed "
                      "checkout is at a commit that is not on the "
                      "integration branch" % (dep, rep["expected"]["ref"]),
        "behind": "%s is an ancestor of %s -- the deployed checkout is %s "
                  "commit(s) behind"
                  % (dep, rep["expected"]["ref"], rel.get("behind", "?")),
        "ahead": "%s is ahead of %s -- the deployed checkout is at a commit "
                 "that was never merged" % (dep, rep["expected"]["ref"]),
        "unknown": "%s and %s cannot be ordered in any repository available "
                   "here" % (dep, exp),
    }[rel["kind"]]
    rep["reason"] = (
        "MERGED IS NOT DEPLOYED: %s. Every program/** change between them "
        "is absent from the deployed checkout (#107). Note: %s."
        % (detail, SCOPE_NOTE))
    return rep


def cmd_spec_status(cx, args):
    rep = spec_report(spec_root=args.spec_root,
                      expected_repo=args.expected_repo,
                      expected_ref=args.expected_ref,
                      proc_root=args.proc_root,
                      max_ref_age=args.max_ref_age)
    out(rep, {"aligned": 0, "diverged": EXIT_DIVERGED}.get(rep["status"], 2))


def add_spec_args(q):
    """The four injection seams, shared by `spec status` and `dump`.

    All four exist so the detector is testable without a live server: the
    suite builds real git repositories and a fake /proc tree and points the
    same code at them. A check nobody can watch fail is not evidence (WA-008).
    """
    q.add_argument("--spec-root", default=None,
                   help="the spec checkout to inspect (default: discovered "
                        "from the running server's /proc/<pid>/cwd)")
    q.add_argument("--expected-repo", default=None,
                   help="repo in which to resolve --expected-ref (default: "
                        "the clone this script runs from)")
    q.add_argument("--expected-ref", default=None,
                   help="the ref the org believes is deployed (default: %s)"
                        % INTEGRATION_REF)
    q.add_argument("--proc-root", default="/proc",
                   help="procfs root to scan for the server. Test seam.")
    q.add_argument("--max-ref-age", type=int, default=MAX_REF_AGE_S,
                   metavar="SECONDS",
                   help="how old this clone's copy of a remote-tracking "
                        "--expected-ref may be before `aligned` is "
                        "downgraded to `undetermined` (default: %d). The "
                        "detector never fetches; it reports freshness and "
                        "refuses to call an unfetched match proof."
                        % MAX_REF_AGE_S)



# ------------------------------------------------------------- worktrees --
#
# Issue #120. The control plane expires claims, leases and slots, and knew
# nothing about worktrees. A task row reaches a terminal state, the crew
# moves on, and the linked worktree it was cut for stays on disk with a live
# index nobody owns. That is not a tidiness problem: a worktree left on a
# stale tree, whose branch later catches up to origin, is pre-loaded with the
# #89/#98 revert. Committing in it reverts merged work and pushes cleanly,
# because every check git makes passes -- the tree really is a descendant,
# the push really is a fast-forward. The content is simply old.
#
# Instance three (#120) survived only because its local ref happened to be
# five commits behind, so a commit there was rejected as non-fast-forward.
# That is a property of a ref, not a control, and it evaporated the moment
# someone fast-forwarded the shared ref for an unrelated reason. This is the
# detector that replaces the luck.
#
# It uses `_git_ro` (defined with the spec helpers below) for every git call:
# rev-parse, status --porcelain, worktree list. Nothing here moves a HEAD,
# writes an index, or updates a ref -- it aims at OTHER agents' live
# checkouts, so read-only is the whole safety argument. Do not add a verb
# here that writes. Removing a flagged worktree stays a human's decision:
# the tool's job is that instance four is caught by a machine, not that a
# machine deletes it.

# A task in one of these states is finished with its worktree. `building`
# and `pending` are live -- their worktrees are someone's desk, not litter.
# Read from the same `tasks.state` column `task upsert` writes; the values
# are the ones this plane has actually used (see `task list`).
TERMINAL_TASK_STATES = frozenset({"done", "merged", "dropped", "superseded"})

# Exit **5** = orphaned worktrees are on disk and need a human.
#
# Same argument that gave divergence its own code rather than folding it
# under 3: 3 tells a caller to stand down and RETRY LATER, and an orphaned
# worktree never clears by waiting -- it clears when someone inspects it and
# removes it. A caller that retried this on a loop would spin forever. It is
# not 4 either: 4 says the deployed specs disagree with the ref, which is a
# different condition with a different remedy (a deploy, not a removal).
EXIT_ORPHANED_WORKTREE = 5


def _worktrees(repo):
    """Enumerate this repository's worktrees. Returns (list, reason).

    Exactly one of the two is None. `reason` is set when git could not be
    asked at all -- no repository, no git binary -- which is a legitimate
    "nothing to audit" for a control plane living outside a checkout, NOT a
    finding. It is reported rather than swallowed so the difference between
    "audited, found nothing" and "could not audit" stays visible in the
    output; #120's whole family is conditions that were assumed rather than
    observed.

    The primary worktree is flagged from its POSITION: `git worktree list`
    documents the main worktree first. It matters because the shared
    checkout (/srv/project here) must never be offered as reapable -- it is
    the one worktree whose removal would take the repository with it.
    """
    rc, text, err = _git_ro(repo, "worktree", "list", "--porcelain")
    if rc != 0:
        return None, (err or f"git worktree list failed (rc={rc})")
    found, cur = [], None
    for line in text.splitlines():
        key, _, val = line.partition(" ")
        if key == "worktree":
            if cur is not None:
                found.append(cur)
            cur = {"path": val, "head": None, "branch": None,
                   "detached": False, "primary": False}
        elif cur is None:
            continue
        elif key == "HEAD":
            cur["head"] = val
        elif key == "branch":
            cur["branch"] = re.sub(r"^refs/heads/", "", val)
        elif key == "detached":
            cur["detached"] = True
    if cur is not None:
        found.append(cur)
    if found:
        found[0]["primary"] = True
    return found, None


def _worktree_dirt(path):
    """Count staged / unstaged / untracked entries in one worktree.

    Returns (counts, reason); exactly one is None.

    Three separate plumbing calls rather than one `status --porcelain`, and
    the reason is a bug this function shipped with for one revision:
    `_git_ro` calls `.strip()` on git's stdout, and a porcelain status line
    encodes the index in COLUMN 1 -- so a plain unstaged modification, " M
    path", arrived here as "M path" and every worktree on the box was
    reported as having a staged change it did not have. The columns are
    load-bearing whitespace passed through a whitespace-stripping helper.
    Rather than special-case the helper (and leave the trap set for the next
    caller), the counts come from three commands whose output does not
    encode anything in leading whitespace:

        diff --cached --name-only   HEAD vs index   -> staged
        diff --name-only            index vs tree   -> unstaged
        ls-files --others           untracked        -> untracked

    `--exclude-standard` honours .gitignore, so __pycache__ does not count.
    A detector that fired on build output would be switched off within a
    day, which is precisely how this class of control dies.

    All three are read-only. Both staged and unstaged are counted because
    both are dangerous: a staged deletion is one ordinary commit from
    landing, and a stale working tree is one stage-everything invocation
    from becoming the same thing. #120 was disarmed by unstaging, and the
    tree stayed destructive.
    """
    counts = {}
    for key, argv in (
        ("staged", ("diff", "--cached", "--name-only")),
        ("unstaged", ("diff", "--name-only")),
        ("untracked", ("ls-files", "--others", "--exclude-standard")),
    ):
        rc, text, err = _git_ro(path, *argv)
        if rc != 0:
            return None, (err or f"git {argv[0]} failed (rc={rc})")
        counts[key] = len(text.splitlines()) if text else 0
    # The diffs above no longer descend into submodules (see `_git_argv`),
    # so a populated one is never PROVEN clean -- and it counts as dirt.
    links, reason = _populated_gitlinks(path)
    if links is None:
        return None, reason
    counts["populated_submodules"] = len(links)
    return counts, None


def _populated_gitlinks(repo):
    """Index gitlinks whose path holds a `.git` entry. Returns (list, reason)."""
    rc, text, err = _git_ro(repo, "ls-files", "--stage", "-z")
    if rc != 0:
        return None, (err or f"git ls-files failed (rc={rc})")
    links = []
    for record in text.split("\0"):
        meta, _, name = record.partition("\t")
        if meta.split()[:1] == ["160000"] and os.path.lexists(
                os.path.join(repo, name, ".git")):
            links.append(name)
    return links, None


def _task_is_live(state):
    """Is this task row still someone's work? Unknown states read LIVE.

    The terminal set is a closed enumeration of states this plane has
    actually used, and it is the ONLY thing that makes a worktree reapable.
    So an unrecognised state -- a new one someone adds next wave, or NULL --
    must fall on the live side: the cost of reading a finished task as live
    is a worktree nobody removes, and the cost of the opposite is removing
    someone's desk. Fail toward the recoverable error.
    """
    return state not in TERMINAL_TASK_STATES


def _owning_task(rows, wt):
    """Find the task that owns a worktree. Returns (row, matched_by, matches).

    `matches` is EVERY row that matched, not just the one chosen; `row` is
    the representative to report. Both are needed because a worktree can
    correlate to more than one task row, and the reason it can is that task
    rows are a historical log while a branch or a path is a reusable name.

    Two signals, in order of authority:

    1. `tasks.worktree` -- the path the task recorded for itself. Compared
       through realpath so a symlinked or trailing-slash spelling still
       matches.
    2. `tasks.branch` -- the branch checked out there. This exists because
       signal 1 is SPARSE in practice: of 60 task rows on this plane, 52
       have `worktree` NULL, and `platform-92-hermetic` -- the owner in
       #120's own instance -- is one of them. A detector that only joined on
       the recorded path would have reported the instance it was written for
       as unowned-but-unexplained, or missed it. Branch is weaker evidence
       (two worktrees can hold one branch) so it is reported as such.

    WHY ALL MATCHES, AND WHY LIVE WINS (PR #122 finding 2, `architect`)
    -------------------------------------------------------------------
    The first revision of this function returned the FIRST matching row and
    stopped. That made SQLite row order decide the verdict whenever a name
    spanned rows in different states: with a terminal row written before a
    live one, a worktree holding live work was reported `orphaned-dirty`
    and REAPABLE. That is the false positive this whole issue exists to
    prevent, and it would have arrived carrying the authority of a machine
    check.

    It is not hypothetical on this plane. Ten branches span more than one
    task row, and two distinct task rows record the SAME worktree path
    (`/srv/project/.worktrees/alpha-fix-70-evidence`), so the path signal
    had the identical defect -- the ambiguity is not specific to the branch
    fallback and neither is the remedy. Reuse is the norm here, not an edge:
    a review round, a follow-up fix and the original build routinely share
    one branch, and the earlier rows reach `merged` while the last is still
    `building`.

    So: gather every row the signal matches, and let LIVE WIN
    UNCONDITIONALLY. If any matching row is live, the worktree is somebody's
    desk and is not reapable, whatever the other rows say. Only when EVERY
    match is terminal is it offered for reaping. The asymmetry is the point
    -- the two errors are not equally expensive.

    The representative is chosen live-first and then by id, so the reported
    `task` is a pure function of the match SET and not of the order the rows
    were written. A test that passes only in the order rows happen to be
    inserted is the same defect wearing a green tick.
    """
    here = os.path.realpath(wt["path"])
    matches = [r for r in rows
               if r["worktree"] and os.path.realpath(r["worktree"]) == here]
    matched_by = "worktree-path"
    if not matches and wt["branch"]:
        matches = [r for r in rows if r["branch"] == wt["branch"]]
        matched_by = "branch"
    if not matches:
        return None, None, []
    # Live first, then by id: order-independent, and conservative.
    chosen = sorted(matches,
                    key=lambda r: (not _task_is_live(r["state"]), r["id"]))[0]
    return chosen, matched_by, matches


def audit_worktrees(cx, repo, repository_id=SCOPE_HOME):
    """Read-only audit of every worktree against the task table.

    Returns a dict that is safe to embed in another command's JSON. Never
    raises, never writes, never removes anything.

    `repository_id` (ADR-0084) scopes the candidate task rows: a worktree
    is correlated only against THIS repository's own tasks, never another
    repository's -- otherwise a second repository's task happening to share
    a branch/worktree name would be reported (and, via `reap --delete`,
    treated) as if it belonged to this one. Defaults to SCOPE_HOME so a
    caller that has not resolved a scope (there is none, currently) still
    gets today's exact single-repository behaviour.
    """
    wts, reason = _worktrees(repo)
    if wts is None:
        # No repository (or no git). Vacuously nothing to leak -- but say so
        # rather than emitting an empty list that reads like a clean bill.
        return {"available": False, "reason": reason, "repo": repo,
                "flagged": 0, "worktrees": []}
    rows = cx.execute(
        "SELECT id, state, worktree, branch, issue, pr_url FROM tasks "
        "WHERE repository_id=?", (repository_id,)
    ).fetchall() if cx is not None else []
    report, flagged = [], 0
    for wt in wts:
        task, matched_by, matches = _owning_task(rows, wt)
        dirt, dirt_reason = _worktree_dirt(wt["path"])
        live = [r for r in matches if _task_is_live(r["state"])]
        entry = {
            "path": wt["path"],
            "head": wt["head"],
            "branch": wt["branch"],
            "primary": wt["primary"],
            "task": task["id"] if task else None,
            "task_state": task["state"] if task else None,
            "matched_by": matched_by,
            # EVERY row that matched, not just the representative. Reported
            # so a correlation that is genuinely ambiguous says so out loud
            # instead of resolving quietly to whichever row SQLite returned
            # first (PR #122 finding 2). Sorted for a stable diff.
            "tasks": sorted(({"id": r["id"], "state": r["state"],
                              "live": _task_is_live(r["state"])}
                             for r in matches), key=lambda t: t["id"]),
            "ambiguous": len(matches) > 1 and 0 < len(live) < len(matches),
            "counts": dirt,
            "reapable": False,
        }
        if wt["primary"]:
            # The shared checkout. It is dirty here as a matter of routine --
            # it is where the Program writes state -- and removing it would
            # remove the repository. Never a finding, and never reapable.
            entry["verdict"] = "primary"
            entry["note"] = ("the shared checkout: never removed, never "
                             "reaped, and never committed from (#89/#98)")
        elif dirt is None:
            entry["verdict"] = "unreadable"
            entry["note"] = dirt_reason
        elif not any(dirt.values()):
            entry["verdict"] = "clean"
        elif task is None:
            entry["verdict"] = "unowned-dirty"
            entry["reapable"] = True
        elif live:
            # A live task's messy desk. Not a finding; saying so is the point.
            #
            # Tested against the LIVE SUBSET of every matching row, not
            # against the representative's state, so the invariant is
            # enforced where it is decided: one live owner is enough to
            # protect the worktree no matter how many terminal rows share
            # the name, and no matter what order they are in.
            entry["verdict"] = "owned-dirty"
            if entry["ambiguous"]:
                dead = [r["id"] for r in matches if not _task_is_live(r["state"])]
                entry["note"] = (
                    "ambiguous correlation resolved conservatively: also "
                    f"matches terminal {', '.join(sorted(dead))}, but a live "
                    "owner is present so this worktree is not reapable")
        else:
            # Every matching row is terminal. Only now is it litter.
            entry["verdict"] = "orphaned-dirty"
            entry["reapable"] = True
        if entry["reapable"]:
            flagged += 1
        report.append(entry)
    return {"available": True, "reason": None, "repo": repo,
            "flagged": flagged, "worktrees": report}


def _audit_repo(args):
    """The checkout to audit: --repo, else the one holding the control plane.

    Anchoring on the database is deliberate. ADR-0005 D1/D2 made the plane
    DISCOVERED rather than invented, and the repository that owns a plane is
    the one whose `.omni` directory it sits in -- not the process CWD, which
    is exactly the input that let this tool answer questions about a plane
    that did not exist (#31).
    """
    if getattr(args, "repo", None):
        return args.repo
    return os.path.dirname(os.path.dirname(os.path.abspath(args.db))) or "."


def cmd_worktree_audit(cx, args):
    try:
        repository_id = resolve_scope(cx, args, task_row=None)
    except RepositoryScopeError as exc:
        _scope_out(cx, exc, commit=False)
    rep = audit_worktrees(cx, _audit_repo(args), repository_id)
    out({"ok": rep["flagged"] == 0, **rep},
        EXIT_ORPHANED_WORKTREE if rep["flagged"] else 0)


# --------------------------------------------------- staged-deletion guard --
#
# Issue #120's "guard on the shape, not the instance", and the other half of
# what #89/#98 need. The detector above finds a loaded worktree before anyone
# fires it; this refuses the shot itself.
#
# Why it is a git hook and not a wrapper verb agents must remember to call:
# the org already decided this, on the record. ADR-0009 proposed
# `nightshift-ctl state-commit` as the safety boundary; the decision log's
# ruling was that "a guard that agents must remember to invoke cannot fix a
# discipline failure -- and discipline is precisely what failed three times
# in one day", and that the wrapper "survives as ergonomics, not as the
# safety boundary. Nothing may depend on it being called." So this ships as
# the check plus `hook install`, which wires it into git's own pre-commit
# path where it fires whether or not anyone remembered.
#
# Why it is not a policy rule: ADR-0009 C3, confirmed by `architect`. The
# policy layer sees a command string with no authoritative cwd, so a staging
# command run in the shared checkout and the same command run in a dedicated
# worktree are indistinguishable to it. A pre-commit hook has no such
# problem -- it runs IN the repository whose index it is judging, and it
# reads that index rather than the text of the command that filled it. That
# also closes the bypass `architect` named: this fires on the staged RESULT,
# so a stage-everything flag, a checkout-from-an-old-tree, a script, or any
# other route to the same index is caught identically.

def _staged_deletions(repo, ref):
    """Staged paths this commit would delete that still exist at `ref`.

    `--no-renames` on purpose: with rename detection on, moving a file
    reports as R and its deletion never appears, so the identical index --
    the merged path gone -- would pass or fail depending on whether some
    unrelated added file happened to look similar. The question here is
    "would this commit remove a path that is live on the integration
    branch", and that is answered by the path set, not by similarity.
    """
    rc, text, err = _git_ro(repo, "diff", "--cached", "--name-status",
                            "--no-renames", "-z")
    if rc != 0:
        return None, (err or f"git diff --cached failed (rc={rc})")
    fields = [f for f in text.split("\0") if f]
    deletions = []
    for i in range(0, len(fields) - 1, 2):
        if fields[i].startswith("D"):
            deletions.append(fields[i + 1])
    live = [p for p in deletions
            if _git_ro(repo, "cat-file", "-e", f"{ref}:{p}")[0] == 0]
    return live, None


def cmd_guard_commit(cx, args):
    repo = args.repo or _self_repo()
    ref = args.ref or INTEGRATION_REF

    # Fail CLOSED when the reference point cannot be resolved. ADR-0009's
    # central mechanism was falsified by exactly the opposite choice: a
    # freshness guard that could not fetch compared two stale values and
    # PASSED, for precisely the seats most likely to need it (#101). A guard
    # that cannot see what it is protecting must refuse, and must say which
    # of the two it is -- "I checked and it is fine" and "I could not check"
    # are different answers and the caller is owed the difference.
    rc, ref_sha, err = _git_ro(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
    if rc != 0:
        out({"ok": False, "guard": "staged-deletions", "repo": repo, "ref": ref,
             "reason": f"cannot resolve {ref!r} in {repo} — refusing to pass a "
                       "commit this guard was unable to check. Fetch that ref, "
                       "or name a different reference point with --ref.",
             "stderr": err}, 3)

    live, reason = _staged_deletions(repo, ref)
    if live is None:
        out({"ok": False, "guard": "staged-deletions", "repo": repo,
             "ref": ref, "reason": reason}, 1)
    if live:
        out({"ok": False, "guard": "staged-deletions", "repo": repo,
             "ref": ref, "ref_sha": ref_sha, "deletions": sorted(live),
             "reason": f"{len(live)} staged deletion(s) remove paths that are "
                       f"still present at {ref} — this is the #89/#98 shape, "
                       "which has silently reverted merged work on this repo "
                       "twice. If the removal is intended, commit it on its "
                       "own with an explicit message saying so, using git's "
                       "documented hook bypass."}, 3)
    return out({"ok": True, "guard": "staged-deletions", "repo": repo,
                "ref": ref, "ref_sha": ref_sha, "deletions": []})


HOOK_TEMPLATE = """#!/bin/sh
# nightshift staged-deletion guard (issue #120). Installed by
# `nightshift-ctl hook install`; regenerate rather than editing in place.
#
# Refuses a commit that would delete a path still present on the integration
# ref. Deliberately NOT a wrapper the author has to remember to call: the
# decision log ruled that a guard depending on discipline cannot fix a
# discipline failure, because discipline is what failed three times in one
# day. This runs because git runs it.
set -u
root=$(git rev-parse --show-toplevel) || exit 1

# The absolute ctl recorded at install time, and ONLY that one. This used to
# prefer `$root/bin/nightshift-ctl`, which made every commit execute whatever
# the checkout being committed shipped under that name (audit C10). If the
# recorded ctl is gone, re-run `hook install` from the installed ctl.
ctl={ctl}
if [ ! -x "$ctl" ]; then
    echo "pre-commit: nightshift-ctl not found; refusing to pass a commit" >&2
    echo "  this guard could not check. Fix: nightshift-ctl hook install" >&2
    exit 1
fi

# Quiet on success: this runs on every commit, and a guard that prints a
# paragraph each time is a guard people delete.
output=$("$ctl" guard-commit --repo "$root" --ref {ref} 2>&1)
rc=$?
[ "$rc" -eq 0 ] || printf '%s\n' "$output" >&2
exit "$rc"
"""


def cmd_hook_install(cx, args):
    """Install the pre-commit guard into one worktree's hooks directory.

    Resolves the hooks path through git rather than assuming `.git/hooks`:
    a LINKED worktree's .git is a file, and `core.hooksPath` may redirect
    the whole repository elsewhere. Asking git is the only spelling that is
    right in both cases -- and every checkout that matters here is a linked
    worktree, which is the case a hardcoded path gets wrong.
    """
    repo = args.repo or _self_repo()
    rc, hooks, err = _git_ro(repo, "rev-parse", "--git-path", "hooks",
                             hooks_query=True)
    if rc != 0:
        out({"ok": False, "reason": f"not a git repository: {repo}",
             "stderr": err}, 2)
    if not os.path.isabs(hooks):
        hooks = os.path.join(repo, hooks)
    path = os.path.join(hooks, "pre-commit")
    body = HOOK_TEMPLATE.format(
        ctl=shlex.quote(os.path.abspath(sys.argv[0]) if os.path.sep in sys.argv[0]
                        else os.path.join(_self_repo(), "bin", "nightshift-ctl")),
        ref=shlex.quote(args.ref or INTEGRATION_REF))
    if os.path.exists(path) and not args.force:
        with open(path) as f:
            existing = f.read()
        if "nightshift staged-deletion guard" not in existing:
            out({"ok": False, "path": path,
                 "reason": "a pre-commit hook that is not this guard is "
                           "already installed — refusing to overwrite "
                           "someone else's hook. Re-run with --force if "
                           "replacing it is what you mean."}, 3)
    try:
        os.makedirs(hooks, exist_ok=True)
        with open(path, "w") as f:
            f.write(body)
        os.chmod(path, 0o755)
    except OSError as exc:
        out({"ok": False, "path": path, "reason": str(exc)}, 1)
    return out({"ok": True, "path": path, "repo": repo,
                "ref": args.ref or INTEGRATION_REF})



# ------------------------------------------------------------ reap / dump --

def cmd_pr_head(cx, args):
    """Read a PR's head SHA from the GitHub API, not local refs.

    Prevents recovery tests from building on stale origin/* refs (issue #66).
    The local ref is a cache; the API is the source.
    
    Returns: {"pr": <number>, "head": "<sha>", "ref": "<branch-name>"}
    Exit 3 if the PR does not exist or the API call fails.
    """
    gh = os.environ.get("NIGHTSHIFT_CTL_GH", "gh")
    try:
        result = subprocess.run(
            [gh, "pr", "view", str(args.number), "--json", "headRefOid,headRefName"],
            capture_output=True, text=True, check=True
        )
        data = json.loads(result.stdout)
        out({"pr": args.number, 
             "head": data["headRefOid"], 
             "ref": data["headRefName"]})
    except (FileNotFoundError, OSError) as e:
        out({"error": "gh_binary_missing", 
             "pr": args.number,
             "gh_path": gh,
             "details": str(e)}, 3)
    except subprocess.CalledProcessError as e:
        out({"error": "gh_api_failed", 
             "pr": args.number,
             "stderr": e.stderr.strip()}, 3)
    except (json.JSONDecodeError, KeyError) as e:
        out({"error": "parse_failed", 
             "pr": args.number,
             "details": str(e)}, 3)


# ------------------------------------------------ project startup binding --

def _run_project_command(command, args):
    """Lazy project-module boundary; existing ctl verbs stay self-contained."""
    try:
        from nightshift_project import ProjectError, error_payload
        result = command(args)
    except Exception as exc:
        # ProjectError is imported lazily with the command so a copied legacy
        # nightshift-ctl continues to serve every unrelated verb even if the
        # new sibling modules are absent.  Never expose local paths or remote
        # stderr through this security-sensitive boundary.
        if "ProjectError" in locals() and isinstance(exc, ProjectError):
            out(error_payload(exc), exc.exit_code)
        out({"ok": False, "reason_code": "project_operation_failed"}, 1)
    out(result)


def cmd_project_bind(cx, args):
    try:
        from nightshift_project import bind_project
    except Exception:
        out({"ok": False, "reason_code": "project_operation_failed"}, 1)
    _run_project_command(bind_project, args)


def cmd_project_show(cx, args):
    try:
        from nightshift_project import show_project
    except Exception:
        out({"ok": False, "reason_code": "project_operation_failed"}, 1)
    _run_project_command(show_project, args)


# ------------------------------------------------- repository scope (#165) --
#
# `authority.db` (bin/nightshift_authority.py) is the single attested answer
# to "which repository is this" (ADR-0084). This plane's own
# `meta.repository_id` binding is a PROJECTION of that attestation and must
# never be able to disagree with it -- `repo bind` refuses outright unless
# `nightshift_authority.registry_exists` already says so. Neither `repo
# bind` nor `project bind` OWNS identity; authority.db does, and both bind
# against it.

_REPO_SCOPE_TABLES = ("tasks", "task_dependencies", "task_claims",
                     "worker_slots", "leases")


def cmd_repo_bind(cx, args):
    """Name this plane's home repository, once, and backfill every legacy
    (SCOPE_HOME/0) row to it -- the second half of ADR-0084's backfill, the
    first half being the migration's own `DEFAULT 0`. Idempotent: binding
    to the SAME id twice is a no-op, never an error.
    """
    nsa = _import_nightshift_authority()
    begin(cx)
    try:
        attested = nsa.registry_exists(args.state_root, args.scope_repository_id)
    except nsa.AuthorityError as exc:
        cx.execute("COMMIT")
        out({"ok": False, "reason_code": exc.reason_code, **exc.details},
            exc.exit_code)
    n = args.scope_repository_id
    if not attested:
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": _SCOPE_REASON_TEXT["repository_scope_not_attested"],
             "reason_code": "repository_scope_not_attested",
             "repository_id": n, "state_root": args.state_root}, 3)
    bound = _meta_get(cx, "repository_id")
    if bound is not None:
        bound_id = int(bound)
        if bound_id == n:
            cx.execute("COMMIT")
            out({"ok": True, "repository_id": n, "already_bound": True,
                 "backfilled": None})
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": _SCOPE_REASON_TEXT["repository_scope_already_bound"],
             "reason_code": "repository_scope_already_bound",
             "bound_repository_id": bound_id,
             "presented_repository_id": n}, 3)
    # A plane that already holds rows scoped to some OTHER non-zero,
    # non-`n` value has no single home left to name -- this cannot happen
    # through this file's own write paths (every one of them refuses a
    # non-SCOPE_HOME scope before any bind exists -- `resolve_scope`'s own
    # `repository_scope_unbound` check), but a row written by any other
    # route (direct SQL, a damaged plane) must still be caught here rather
    # than silently relabelled.
    stray = {}
    for table in _REPO_SCOPE_TABLES:
        rows = cx.execute(
            f"SELECT DISTINCT repository_id FROM {table} "
            "WHERE repository_id NOT IN (0, ?)", (n,)).fetchall()
        if rows:
            stray[table] = sorted(r["repository_id"] for r in rows)
    if stray:
        cx.execute("COMMIT")
        out({"ok": False,
             "reason": _SCOPE_REASON_TEXT[
                 "repository_scope_plane_not_single_repository"],
             "reason_code": "repository_scope_plane_not_single_repository",
             "presented_repository_id": n, "stray_repository_ids": stray}, 3)
    backfilled = {}
    for table in _REPO_SCOPE_TABLES:
        cur = cx.execute(
            f"UPDATE {table} SET repository_id=? WHERE repository_id=0", (n,))
        backfilled[table] = cur.rowcount
    cx.execute(
        "INSERT INTO meta(key,value) VALUES('repository_id',?) "
        "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (str(n),))
    cx.execute("COMMIT")
    out({"ok": True, "repository_id": n, "already_bound": False,
         "backfilled": backfilled})


def cmd_repo_show(cx, args):
    """Report this plane's repository binding and per-scope row counts.
    Pure read -- no transaction, same as `task list`."""
    bound = _meta_get(cx, "repository_id")
    counts = {}
    for table in _REPO_SCOPE_TABLES:
        rows = cx.execute(
            f"SELECT repository_id, COUNT(*) AS n FROM {table} "
            "GROUP BY repository_id ORDER BY repository_id").fetchall()
        counts[table] = {str(r["repository_id"]): r["n"] for r in rows}
    out({"ok": True, "bound": bound is not None,
         "repository_id": int(bound) if bound is not None else None,
         "scope_home": SCOPE_HOME, "row_counts": counts})


# ------------------------------------------------------------ memory (#400) --
#
# Narrative memory is a SECOND SQLite file, physically separate from
# control.db, living under the ADR-0021 `state_root` outside every Git
# worktree. That physical separation -- not a runtime check -- is the
# advisory boundary the design calls for: "no transaction can span a
# memory read and a control grant" is true because there is no shared
# connection for one to span. Every memory verb below is therefore
# plane-free (see PLANE_FREE_COMMANDS) and its cmd_* wrapper ignores the
# `cx` argparse hands it -- memory verbs open memory.db themselves, the
# same shape `nightshift_project.py` already uses for control.db.
#
# `--state-root` alone is NOT a per-project key: ADR-0020 Sec.2 defines it
# as a directory that legitimately holds MULTIPLE repositories'
# descriptors, one per `repository_id`, under `state_root/startups/`. A
# single top-level `state_root/memory.db` would therefore silently become
# ONE memory store shared by every repository bound under that root --
# the exact cross-project leakage the design says must be
# "unrepresentable" rather than policy-enforced. So every memory verb also
# takes `--repository-id`, the same numeric identity `project show`
# already requires and validates, and `nightshift_memory.resolve_memory_
# root` (called by every module below, not here) keys memory.db's path
# off BOTH -- `state_root/memory/<repository_id>/` -- never off
# `state_root` alone. Path construction and its ADR-0021 fd-based
# validation belong in that module, not here -- this layer only forwards
# the two identifying strings, exactly as `cmd_project_bind` and
# `cmd_project_show` forward `--state-root` untouched.
#
# `--repo` (bootstrap/sync only) is the local checkout to read tracked
# content from -- distinct from `--state-root`, which must stay outside
# every worktree. It is optional and defaults to None; the target module
# resolves an unset value to the caller's CWD, the same args-only,
# self-contained shape `bind_project`/`show_project` use.
#
# Each subcommand shells into its real PLAN-400 Track-A sibling module (A1
# writer `nightshift_memory`, A2 importer `nightshift_memory_bootstrap`, A3
# retrieval `nightshift_memory_search`) via a lazy, per-call import, so a
# copied legacy nightshift-ctl keeps serving every unrelated verb even
# before those modules land. `_run_memory_command` mirrors
# `_run_project_command` but does not import a specific exception class
# name from the target module: three sibling modules are independent
# builds, and the wrapper instead duck-types on `reason_code` /
# `exit_code` / `details` attributes -- the same structured-error shape
# `ProjectError` already exposes -- so any of the three gets a correct,
# sanitized JSON error out of this boundary without this file needing to
# know which module raised it.

def _run_memory_command(command, args):
    """Lazy memory-module boundary; mirrors _run_project_command."""
    try:
        result = command(args)
    except Exception as exc:
        reason_code = getattr(exc, "reason_code", None)
        if reason_code is not None:
            payload = {"ok": False, "reason_code": reason_code}
            details = getattr(exc, "details", None)
            if details is not None:
                payload["details"] = details
            exit_code = getattr(exc, "exit_code", 1)
            out(payload, exit_code if isinstance(exit_code, int) else 1)
        # Never expose local paths or a raw traceback through this
        # security-sensitive boundary -- same discipline as the project
        # wrapper above, for the same reason (memory rows can carry
        # secrets; see the H1 redact-then-delete finding).
        out({"ok": False, "reason_code": "memory_operation_failed"}, 1)
    out(result)


def cmd_memory_bootstrap(cx, args):
    """A2 importer, borrowed-project onboarding (PLAN-400 A4a): tiered
    ingest of tracked content, coverage manifest, idempotent by
    (project, src_path, line_start, sha256)."""
    try:
        from nightshift_memory_bootstrap import bootstrap_memory
    except Exception:
        out({"ok": False, "reason_code": "memory_operation_failed"}, 1)
    _run_memory_command(bootstrap_memory, args)


def cmd_memory_sync(cx, args):
    """A2 importer, watermark-driven incremental re-index (PLAN-400 A4b):
    changed paths only on a fast-forward watermark, full re-scan when
    `git merge-base --is-ancestor` fails (force-push/rebase/squash)."""
    try:
        from nightshift_memory_bootstrap import sync_memory
    except Exception:
        out({"ok": False, "reason_code": "memory_operation_failed"}, 1)
    _run_memory_command(sync_memory, args)


